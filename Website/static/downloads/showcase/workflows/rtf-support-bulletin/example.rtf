\pard\sb160\sa100\ql \b \fs44 \cf1 Delayed request notifications\plain \par
\pard\ql SUPPORT BULLETIN / SB-014 / ILLUSTRATIVE SERVICE SCENARIO\par
\pard\sb160\sa100\ql \b \fs28 \cf1 Recognize the symptom\plain \par
\pard\ql A request appears in the portal, but its email acknowledgement arrives later than expected. Check the request record before asking the user to submit it again.\par
\pard\sb160\sa100\ql \b \fs28 \cf1 Check in this order\plain \par
\pard\pn\pnlvlblt\ls1\ilvl0\li720\fi-360\ql Confirm the request identifier and submission time.\par
\pard\pn\pnlvlblt\ls1\ilvl0\li720\fi-360\ql Check whether the notification is queued, delivered or rejected.\par
\pard\pn\pnlvlblt\ls1\ilvl0\li720\fi-360\ql Record the delivery result and route unresolved cases to the messaging owner.\par
\pard\sb160\sa100\ql \b \fs28 \cf1 Record enough evidence\plain \par
\pard\trowd\trgaph108\trhdr\trcbpat2\cellx2400\cellx4800
\pard\intbl\ql Field\cell\pard\intbl\ql Why it matters\cell\row
\trowd\trgaph108\cellx2400\cellx4800
\pard\intbl\ql Request ID\cell\pard\intbl\ql Finds the original service record\cell\row
\trowd\trgaph108\cellx2400\cellx4800
\pard\intbl\ql Submission time\cell\pard\intbl\ql Matches the notification event\cell\row
\trowd\trgaph108\cellx2400\cellx4800
\pard\intbl\ql Delivery result\cell\pard\intbl\ql Separates delay from rejection\cell\row
\pard\par
\pard\sb160\sa100\ql \b \fs28 \cf1 Close the loop\plain \par
\pard\ql Tell the user whether the request was received and when to expect the next update. Avoid including personal message content in the support record.\par
