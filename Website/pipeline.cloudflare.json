{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/Schemas/powerforge.web.pipelinespec.schema.json",
  "steps": [
    {
      "task": "cloudflare",
      "id": "verify-cache",
      "operation": "verify",
      "siteConfig": "./site.json",
      "warmupRequests": 1,
      "paths": [
        "/",
        "/api/",
        "/api/word/",
        "/api/word/index.json",
        "/agents.json",
        "/.well-known/api-catalog",
        "/apps/officeimo-converter/",
        "/apps/officeimo-converter/converter.css"
      ],
      "discoverAssetsFrom": "/apps/officeimo-converter/",
      "assetPathPatterns": "/apps/officeimo-converter/_framework/blazor.webassembly.*.js",
      "allowStatuses": "HIT,REVALIDATED,EXPIRED,STALE",
      "reportPath": "./_reports/cloudflare-cache.json",
      "summaryPath": "./_reports/cloudflare-cache.md"
    },
    {
      "task": "agent-ready",
      "id": "verify-agent-readiness-live",
      "dependsOn": "verify-cache",
      "operation": "scan",
      "config": "./site.json",
      "failOnFailures": true
    }
  ]
}
