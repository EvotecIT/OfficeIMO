<Project Sdk="Microsoft.NET.Sdk">
  <!-- Japanese, Arabic and symbol fallback fonts. The browser engine downloads this assembly only for documents that need them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../OfficeIMO.Web.Converter/Assets/Fonts/Noto*.ttf"
                      Link="Assets/Fonts/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
