<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <BlazorEnableCompression>false</BlazorEnableCompression>
    <!-- HarfBuzz WebAssembly ships as a native archive and must be linked into dotnet.native.wasm. -->
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.Web.Fonts\OfficeIMO.Web.Fonts.csproj" />
    <ProjectReference Include="..\..\..\OfficeIMO.Core\OfficeIMO.Core.csproj" />
    <ProjectReference Include="..\..\..\OfficeIMO.Workflows\OfficeIMO.Workflows.csproj" />
    <ProjectReference Include="..\..\..\OfficeIMO.Drawing.HarfBuzz\OfficeIMO.Drawing.HarfBuzz.csproj" />
    <ProjectReference Include="..\..\..\OfficeIMO.Html.Pdf\OfficeIMO.Html.Pdf.csproj" />
    <ProjectReference Include="..\..\..\OfficeIMO.Word.Pdf\OfficeIMO.Word.Pdf.csproj" />
    <ProjectReference Include="..\..\..\OfficeIMO.Excel.Pdf\OfficeIMO.Excel.Pdf.csproj" />
    <ProjectReference Include="..\..\..\OfficeIMO.PowerPoint.Pdf\OfficeIMO.PowerPoint.Pdf.csproj" />
    <ProjectReference Include="..\..\..\OfficeIMO.Markdown.Html\OfficeIMO.Markdown.Html.csproj" />
    <ProjectReference Include="..\..\..\OfficeIMO.MarkdownRenderer\OfficeIMO.MarkdownRenderer.csproj" />
    <ProjectReference Include="..\..\..\OfficeIMO.Word.Markdown\OfficeIMO.Word.Markdown.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OfficeIMO.Web.Converter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Fonts\*.txt"
          TargetPath="wwwroot\licenses\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\Fonts\font-pack.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\OfficeIMO.Core\THIRD-PARTY-NOTICES.md"
             Link="wwwroot\licenses\OfficeIMO.Core-THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The workspace loads the selected format family before mounting its tool. -->
  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Web.Fonts.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Word.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Excel.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.PowerPoint.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Visio.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Workflows.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Pdf.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Html.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Markdown.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Project.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Reader.Core.wasm" />
    <BlazorWebAssemblyLazyLoad Include="DocumentFormat.OpenXml.wasm" />
    <BlazorWebAssemblyLazyLoad Include="AngleSharp.wasm" />
    <BlazorWebAssemblyLazyLoad Include="AngleSharp.Css.wasm" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\static\downloads\showcase\pdf\showcase-dashboard.pdf"
             Link="wwwroot\samples\showcase-dashboard.pdf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OfficeIMO.Web.Converter.Tests" />
  </ItemGroup>

</Project>
