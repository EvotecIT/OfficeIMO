@namespace OfficeIMO.Web.Converter.Components
@using OfficeIMO.Pdf

@if (HasSettings) {
    <section class="pdf-tool-settings" aria-label="PDF tool settings">
        @if (Tool.RequiresPageSelection) {
            <label>
                <span>Pages</span>
                <input type="text" value="@PageSelection" @oninput="HandlePageSelection" placeholder="1-3,5,last" />
                <small>Use pages, ranges, last, odd, even, reverse ranges, or exclusions such as all,!1.</small>
            </label>
        }
        @if (Tool.RequiresPagesPerDocument) {
            <label>
                <span>Pages per output PDF</span>
                <input type="number" min="1" max="500" value="@PagesPerDocument" @onchange="HandlePagesPerDocument" />
            </label>
        }
        @if (Tool.RequiresRotation) {
            <label>
                <span>Rotation</span>
                <select value="@RotationDegrees" @onchange="HandleRotation">
                    <option value="90">90° clockwise</option>
                    <option value="180">180°</option>
                    <option value="270">270° clockwise</option>
                </select>
            </label>
        }
        @if (Tool.RequiresOptimizationProfile) {
            <label>
                <span>Lossless profile</span>
                <select value="@OptimizationProfile" @onchange="HandleOptimizationProfile">
                    @foreach (PdfOptimizationProfile profile in OptimizationProfiles) {
                        <option value="@profile">@ProfileLabel(profile)</option>
                    }
                </select>
                <small>Optimization never rasterizes pages or claims to preserve digital signatures across a rewrite.</small>
            </label>
        }
        @if (Tool.RequiresUserPassword) {
            <label>
                <span>Document-open password</span>
                <input type="password" autocomplete="new-password" value="@UserPassword" @oninput="HandleUserPassword" />
            </label>
        }
        @if (Tool.RequiresOwnerPassword) {
            <label>
                <span>@(Tool.Kind == PdfToolKind.Unlock ? "Owner password" : "Owner password for changes")</span>
                <input type="password" autocomplete="new-password" value="@OwnerPassword" @oninput="HandleOwnerPassword" />
                <small>Passwords stay in memory for this operation and are cleared after it finishes.</small>
            </label>
        }
        @if (Tool.RequiresRedactionText) {
            <label>
                <span>Literal text to remove</span>
                <input type="text" value="@RedactionText" @oninput="HandleRedactionText" placeholder="Sensitive marker" />
                <small>Matching is case-insensitive. The output is checked in extracted text, encoded strings, and decoded streams.</small>
            </label>
        }
        @if (Tool.RequiresDestructiveConfirmation) {
            <label class="pdf-tool-settings__confirmation">
                <input type="checkbox" checked="@DestructiveActionConfirmed" @onchange="HandleConfirmation" />
                <span>I understand the downloaded copy permanently @(Tool.Kind == PdfToolKind.Redact ? "removes matching content" : "removes the selected pages").</span>
            </label>
        }
    </section>
}

@code {
    private static readonly PdfOptimizationProfile[] OptimizationProfiles = [
        PdfOptimizationProfile.Balanced,
        PdfOptimizationProfile.MaximumCompression,
        PdfOptimizationProfile.Web,
        PdfOptimizationProfile.Archival
    ];

    [Parameter, EditorRequired] public PdfToolDefinition Tool { get; set; } = PdfToolCatalog.Default;
    [Parameter] public string PageSelection { get; set; } = "all";
    [Parameter] public int PagesPerDocument { get; set; } = 1;
    [Parameter] public int RotationDegrees { get; set; } = 90;
    [Parameter] public PdfOptimizationProfile OptimizationProfile { get; set; } = PdfOptimizationProfile.Balanced;
    [Parameter] public string UserPassword { get; set; } = string.Empty;
    [Parameter] public string OwnerPassword { get; set; } = string.Empty;
    [Parameter] public string RedactionText { get; set; } = string.Empty;
    [Parameter] public bool DestructiveActionConfirmed { get; set; }
    [Parameter] public EventCallback<string> PageSelectionChanged { get; set; }
    [Parameter] public EventCallback<int> PagesPerDocumentChanged { get; set; }
    [Parameter] public EventCallback<int> RotationDegreesChanged { get; set; }
    [Parameter] public EventCallback<PdfOptimizationProfile> OptimizationProfileChanged { get; set; }
    [Parameter] public EventCallback<string> UserPasswordChanged { get; set; }
    [Parameter] public EventCallback<string> OwnerPasswordChanged { get; set; }
    [Parameter] public EventCallback<string> RedactionTextChanged { get; set; }
    [Parameter] public EventCallback<bool> DestructiveActionConfirmedChanged { get; set; }

    private bool HasSettings =>
        Tool.RequiresPageSelection ||
        Tool.RequiresPagesPerDocument ||
        Tool.RequiresRotation ||
        Tool.RequiresOptimizationProfile ||
        Tool.RequiresUserPassword ||
        Tool.RequiresOwnerPassword ||
        Tool.RequiresRedactionText ||
        Tool.RequiresDestructiveConfirmation;

    private Task HandlePageSelection(ChangeEventArgs args) => PageSelectionChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private Task HandleUserPassword(ChangeEventArgs args) => UserPasswordChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private Task HandleOwnerPassword(ChangeEventArgs args) => OwnerPasswordChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private Task HandleRedactionText(ChangeEventArgs args) => RedactionTextChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private Task HandleConfirmation(ChangeEventArgs args) =>
        DestructiveActionConfirmedChanged.InvokeAsync(
            args.Value is bool value
                ? value
                : bool.TryParse(args.Value?.ToString(), out bool parsed) && parsed);

    private Task HandlePagesPerDocument(ChangeEventArgs args) =>
        PagesPerDocumentChanged.InvokeAsync(int.TryParse(args.Value?.ToString(), out int value) ? value : 1);

    private Task HandleRotation(ChangeEventArgs args) =>
        RotationDegreesChanged.InvokeAsync(int.TryParse(args.Value?.ToString(), out int value) ? value : 90);

    private Task HandleOptimizationProfile(ChangeEventArgs args) =>
        OptimizationProfileChanged.InvokeAsync(
            Enum.TryParse(args.Value?.ToString(), out PdfOptimizationProfile value)
                ? value
                : PdfOptimizationProfile.Balanced);

    private static string ProfileLabel(PdfOptimizationProfile profile) => profile switch {
        PdfOptimizationProfile.MaximumCompression => "Maximum lossless compression",
        PdfOptimizationProfile.Web => "Fast Web View",
        PdfOptimizationProfile.Archival => "Conservative archival rewrite",
        _ => "Balanced"
    };
}
