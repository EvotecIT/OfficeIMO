@namespace OfficeIMO.Web.Converter.Components
@inject NavigationManager Navigation

<StandaloneSiteHeader />

<main id="converter-main" class="ocx-shell" data-workspace-ready="true" data-workspace="@WorkspaceId" tabindex="-1">

    <section class="ocx-product-heading" aria-labelledby="workspace-title">
        <div>
            <h1 id="workspace-title">@(IsPdfWorkspace ? "Work with PDFs" : "Convert documents")</h1>
            <p><span class="ocx-local-dot" aria-hidden="true"></span>Runs locally in this tab</p>
        </div>
        <nav class="ocx-mode-switch" aria-label="Choose workspace">
            <button type="button" class="@(!IsPdfWorkspace ? "is-active" : null)" aria-pressed="@(!IsPdfWorkspace)" @onclick="() => SelectWorkspace(false)">Convert</button>
            <button type="button" class="@(IsPdfWorkspace ? "is-active" : null)" aria-pressed="@IsPdfWorkspace" @onclick="() => SelectWorkspace(true)">PDF tools</button>
        </nav>
    </section>

    @if (IsPdfWorkspace) {
        <PdfWorkbench />
    } else {
        <ConverterWorkspace />
    }
</main>

<StandaloneSiteFooter />

@code {
    private bool IsPdfWorkspace { get; set; }
    private string WorkspaceId => IsPdfWorkspace ? "pdf" : "convert";

    protected override void OnInitialized() {
        IsPdfWorkspace = string.Equals(GetQueryValue("workspace"), "pdf", StringComparison.OrdinalIgnoreCase);
    }

    private void SelectWorkspace(bool pdf) {
        if (IsPdfWorkspace == pdf) {
            return;
        }
        IsPdfWorkspace = pdf;
        var values = new Dictionary<string, object?> {
            ["workspace"] = pdf ? "pdf" : null,
            ["tool"] = pdf ? PdfToolCatalog.Default.Id : null,
            ["route"] = pdf ? null : ConversionRouteCatalog.Default.Id
        };
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(values), replace: true);
    }

    private string GetQueryValue(string name) {
        string query = new Uri(Navigation.Uri).Query;
        if (query.Length <= 1) return string.Empty;
        foreach (string pair in query[1..].Split('&', StringSplitOptions.RemoveEmptyEntries)) {
            string[] parts = pair.Split('=', 2);
            if (string.Equals(Uri.UnescapeDataString(parts[0]), name, StringComparison.OrdinalIgnoreCase)) {
                return parts.Length == 2 ? Uri.UnescapeDataString(parts[1].Replace("+", " ")) : string.Empty;
            }
        }
        return string.Empty;
    }
}
