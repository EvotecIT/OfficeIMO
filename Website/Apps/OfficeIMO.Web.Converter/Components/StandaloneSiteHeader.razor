@inject IJSRuntime JS

<a class="ocx-skip-link" href="#converter-main">Skip to converter</a>
<header class="ocx-site-header">
    <div class="ocx-site-container ocx-site-header__inner">
        <a class="ocx-site-logo" href="/" target="_top" aria-label="OfficeIMO home">
            <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><rect x="3" y="2" width="20" height="24" rx="5" fill="currentColor"/><path d="M9 8h8M9 12h8M9 16h5" stroke="white" stroke-width="1.8" stroke-linecap="round"/><path d="M20 5.5h2.5A2.5 2.5 0 0 1 25 8v13a2.5 2.5 0 0 1-2.5 2.5H20" stroke="#22B8CF" stroke-width="2"/></svg>
            <span>OfficeIMO</span>
        </a>

        <button class="ocx-site-hamburger" type="button" aria-label="Toggle navigation" aria-expanded="@MenuOpen" @onclick="ToggleMenu">
            <span></span><span></span><span></span>
        </button>

        <nav class="ocx-site-nav @(MenuOpen ? "is-open" : null)" aria-label="Main navigation">
            @foreach ((string label, string url) in PrimaryLinks) {
                <a class="@(label == "Convert" ? "is-active" : null)" href="@url" target="_top" @onclick="CloseMenu">@label</a>
            }
        </nav>

        <div class="ocx-site-actions">
            <button class="ocx-site-theme" type="button" aria-label="Toggle theme" @onclick="ToggleThemeAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
            </button>
            <a class="ocx-site-icon-link" href="https://github.com/EvotecIT/OfficeIMO" target="_blank" rel="noopener" aria-label="GitHub">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.79-.26.79-.58v-2.23c-3.34.73-4.03-1.42-4.03-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0112 6.8c1.02 0 2.05.14 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.3c0 .32.19.69.8.57A12 12 0 0012 0z"/></svg>
            </a>
            <a class="ocx-site-cta" href="/docs/getting-started/" target="_top">Get Started</a>
        </div>
    </div>
</header>

@code {
    private static readonly (string Label, string Url)[] PrimaryLinks = [
        ("Home", "/"),
        ("Products", "/products/word/"),
        ("Solutions", "/solutions/"),
        ("Convert", "/convert/"),
        ("Docs", "/docs/"),
        ("API", "/api/"),
        ("Downloads", "/downloads/"),
        ("Resources", "/blog/")
    ];

    private bool MenuOpen { get; set; }

    private void ToggleMenu() => MenuOpen = !MenuOpen;
    private void CloseMenu() => MenuOpen = false;
    private async Task ToggleThemeAsync() => await JS.InvokeVoidAsync("officeimoConverterShell.toggleTheme");
}
