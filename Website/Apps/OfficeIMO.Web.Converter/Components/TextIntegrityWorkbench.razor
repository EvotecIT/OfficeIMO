@namespace OfficeIMO.Web.Converter.Components
@using OfficeIMO.Provenance
@implements IAsyncDisposable
<section class="text-integrity" aria-label="Unicode text integrity review">
 <header><h2>Review invisible and context-sensitive text</h2><p>Paste text or open a UTF-8, UTF-16 or UTF-32 text file. Inspect exact code points before choosing what to remove from a copy. Processing stays in this browser.</p></header>
 <fieldset disabled="@_busy">
  <label for="integrity-text">Original text</label>
  <textarea id="integrity-text" value="@_text" @oninput="TextChangedAsync" rows="6" maxlength="262144" aria-describedby="integrity-limits"></textarea>
  <p id="integrity-limits">Up to 1 MB encoded and 262,144 UTF-16 code units. Language joiners, emoji selectors and typographic spaces may be intentional.</p>
  <div class="text-actions"><label class="text-file">Open text file<InputFile OnChange="OpenAsync" accept=".txt,.md,.html,.htm,.svg,.json,.xml,.csv,.yaml,.yml,.log" aria-label="Open text for Unicode review" /></label>
   <button class="ocx-button ocx-button--secondary" @onclick="LoadSampleAsync">Try text sample</button>
   <button class="ocx-button ocx-button--primary" @onclick="InspectAsync" disabled="@string.IsNullOrEmpty(_text)">Inspect text</button></div>
 </fieldset>
 <p role="status">@_message</p>
 @if (_review is not null) {
  <h3>@_review.Report.Findings.Count finding(s) · Completed</h3>
  <p>Offsets use UTF-16 code units in the decoded original. Inspection does not establish AI authorship.</p>
  <pre class="marked-text" aria-label="Text with Unicode markers">@MarkedText</pre>
  <fieldset disabled="@_busy"><legend>Select exact occurrences to remove</legend>
   @for (int index = 0; index < _review.Report.Findings.Count; index++) {
    int findingIndex = index; var finding = _review.Report.Findings[index];
    <label class="text-finding"><input type="checkbox" checked="@_selected.Contains(index)" @onchange="args => SelectionChangedAsync(findingIndex, args)" />
     <span><strong>@finding.UnicodeNotation · @finding.Kind</strong><small>@finding.Risk · offset @finding.TextOffset · length @finding.TextLength</small></span></label>
   }
   <button class="ocx-button ocx-button--primary" @onclick="CreateCopyAsync" disabled="@(_selected.Count == 0)">Create selected text copy</button>
  </fieldset>
 }
 @if (_cleaned is not null) { <h3>Copy preview</h3><pre class="marked-text">@_cleaned</pre><p>Only selected occurrences were removed. The original encoding, byte-order mark and line endings are preserved for an opened file.</p> }
 <div class="text-actions">
  @if (_outputUrl is not null) { <a class="ocx-button ocx-button--primary" href="@_outputUrl" download="@OutputName">Download text copy</a> }
  @if (_reportUrl is not null) { <a class="ocx-button ocx-button--secondary" href="@_reportUrl" download="text-integrity-report.json">Download text report</a> }
 </div>
</section>
