{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/schemas/powerforge.web.sitespec.schema.json",
  "SchemaVersion": 1,
  "Name": "OfficeIMO",
  "BaseUrl": "https://officeimo.com",
  "DefaultTheme": "officeimo",
  "Features": ["docs", "apiDocs", "blog", "search", "notFound"],
  "Search": { "ApiRoots": ["api"] },
  "TrailingSlash": "always",
  "ContentRoot": "content",
  "ProjectsRoot": "projects",
  "ThemesRoot": "themes",
  "DataRoot": "data",
  "TemplateExports": [
    { "Name": "documentation-shell", "SourceRoute": "/docs/", "Layout": "documentation-shell" }
  ],
  "Sources": [
    {
      "Repo": "EvotecIT/PSWriteOffice",
      "Ref": "v3.0.5",
      "Slug": "pswriteoffice",
      "Destination": "./projects/pswriteoffice",
      "Clean": true
    }
  ],
  "StaticAssets": [
    { "Source": "static" },
    { "Source": "data/pdf_corpus_report.json", "Destination": "data/corpus/pdf-quality-windows.json" },
    { "Source": "data/pdf_corpus_publication.json", "Destination": "data/corpus/pdf-quality-windows.provenance.json" },
    { "Source": "Apps/OfficeIMO.Web.Converter/wwwroot/samples/business-summary.docx", "Destination": "downloads/samples/business-summary.docx" },
    { "Source": "../OfficeIMO.Examples/Showcase/BrowserBusinessSample.cs", "Destination": "downloads/samples/BrowserBusinessSample.cs.txt" },
    {
      "Source": "../OfficeIMO.Pdf.Tests/Pdf/VisualBaselines/officeimo-pdf-professional-report.page1.poppler.png",
      "Destination": "images/proof/pdf-professional-report.png"
    },
    {
      "Source": "../OfficeIMO.Excel.Tests/Excel/VisualBaselines/officeimo-excel-image-premium-range.png",
      "Destination": "images/proof/excel-premium-range.png"
    },
    {
      "Source": "../OfficeIMO.Visio.Tests/Visio/VisualBaselines/officeimo-visio-premium-cloud-architecture-native-page1.png",
      "Destination": "images/proof/visio-cloud-architecture.png"
    },
    {
      "Source": "../OfficeIMO.Pdf.Tests/Pdf/VisualBaselines/officeimo-pdf-native-html-invoice.page1.poppler.png",
      "Destination": "images/proof/html-invoice-pdf.png"
    },
    {
      "Source": "../OfficeIMO.Pdf.Tests/Pdf/VisualBaselines/officeimo-pdf-native-word-report.page1.poppler.png",
      "Destination": "images/proof/word-report-pdf.png"
    }
  ],
  "Collections": [
    {
      "Name": "pages",
      "Input": "content/pages",
      "Output": "/",
      "DefaultLayout": "home",
      "UseToc": false,
      "SitemapLastModified": "sourceDate",
      "Include": ["*.md", "**/*.md"]
    },
    {
      "Name": "products",
      "Input": "content/products",
      "Output": "/products",
      "DefaultLayout": "product",
      "UseToc": false,
      "SitemapLastModified": "sourceDate",
      "Include": ["*.md", "**/*.md"]
    },
    {
      "Name": "showcase-examples",
      "Input": "content/showcase-examples",
      "Output": "/showcase",
      "DefaultLayout": "showcase-example",
      "UseToc": false,
      "SitemapLastModified": "sourceDate",
      "Include": ["*.md", "**/*.md"]
    },
    {
      "Name": "conversions",
      "Input": "content/conversions",
      "Output": "/convert",
      "DefaultLayout": "conversion",
      "UseToc": false,
      "SitemapLastModified": "sourceDate",
      "Include": ["*.md", "**/*.md"]
    },
    {
      "Name": "pdf-workflows",
      "Input": "content/pdf-workflows",
      "Output": "/pdf",
      "DefaultLayout": "conversion",
      "UseToc": false,
      "SitemapLastModified": "sourceDate",
      "Include": ["*.md", "**/*.md"]
    },
    {
      "Name": "solutions",
      "Input": "content/solutions",
      "Output": "/solutions",
      "DefaultLayout": "solution",
      "UseToc": false,
      "SitemapLastModified": "sourceDate",
      "Include": ["*.md", "**/*.md"]
    },
    {
      "Name": "comparisons",
      "Input": "content/comparisons",
      "Output": "/comparisons",
      "DefaultLayout": "comparison-detail",
      "UseToc": false,
      "SitemapLastModified": "sourceDate",
      "Include": ["*.md", "**/*.md"]
    },
    {
      "Name": "blog",
      "Preset": "blog",
      "Input": "content/blog",
      "Output": "/blog",
      "DefaultLayout": "blog-post",
      "ListLayout": "page",
      "UseToc": false,
      "SitemapLastModified": "publishedDate",
      "EditorialCards": {
        "ImageAspect": "16/9",
        "ImageFit": "cover",
        "ImagePosition": "center",
        "GridClass": "imo-editorial-list imo-editorial-list-blog",
        "CardClass": "imo-editorial-card imo-editorial-card-blog"
      },
      "Include": ["*.md", "**/*.md"]
    },
    {
      "Name": "docs",
      "Input": "content/docs",
      "Output": "/docs",
      "DefaultLayout": "docs",
      "UseToc": true,
      "SitemapLastModified": "sourceDate",
      "TocFile": "content/docs/toc.json",
      "Include": ["*.md", "**/*.md"]
    }
  ],
  "Taxonomies": [
    {
      "Name": "tags",
      "BasePath": "/tags",
      "ListLayout": "page",
      "TermLayout": "page"
    },
    {
      "Name": "categories",
      "BasePath": "/categories",
      "ListLayout": "page",
      "TermLayout": "page"
    }
  ],
  "Head": {
    "Links": [
      { "Rel": "icon", "Href": "/favicon.svg", "Type": "image/svg+xml" }
    ]
  },
  "Seo": {
    "CrawlPolicy": {
      "Enabled": true,
      "DefaultRobots": "index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"
    }
  },
  "Social": {
    "Enabled": true,
    "SiteName": "OfficeIMO",
    "Image": "/images/officeimo-social-premium.jpg",
    "ImageWidth": 1200,
    "ImageHeight": 630,
    "TwitterCard": "summary_large_image",
    "AutoGenerateCards": true,
    "GeneratedCardsPath": "/assets/social/generated",
    "GeneratedCardWidth": 1200,
    "GeneratedCardHeight": 630,
    "GeneratedCardStyle": "default",
    "GeneratedCardVariant": "standard",
      "GeneratedCardStylesByCollection": {
        "pages": "default",
        "docs": "docs",
        "blog": "editorial",
        "products": "default",
        "conversions": "default",
        "solutions": "default",
        "comparisons": "default"
      },
    "GeneratedCardVariantsByCollection": {
      "pages": "hero",
      "docs": "compact",
        "blog": "compact",
        "products": "hero",
        "conversions": "hero",
        "solutions": "hero",
        "comparisons": "hero"
    }
  },
  "StructuredData": {
    "Enabled": true,
    "Breadcrumbs": true,
    "Article": true,
    "FaqPage": true,
    "HowTo": true,
    "SoftwareApplication": true,
    "OrganizationLegalName": "Evotec Services sp. z o.o.",
    "OrganizationDescription": "Open source .NET libraries for creating, reading, and editing Office documents without Microsoft Office.",
    "OrganizationLogo": "https://officeimo.com/favicon.svg",
    "OrganizationSameAs": [
      "https://github.com/EvotecIT/OfficeIMO",
      "https://github.com/EvotecIT/PSWriteOffice",
      "https://evotec.xyz",
      "https://evo.yt/discord"
    ],
    "OrganizationEmail": "support@evotec.xyz",
    "OrganizationContactUrl": "https://officeimo.com/docs/getting-started/"
  },
  "AgentReadiness": {
    "Enabled": true,
    "HeadersPath": "_headers",
    "LinkHeaders": true,
    "Robots": true,
    "SecurityHeaders": {
      "Enabled": true,
      "Hsts": false,
      "XFrameOptionsValue": "SAMEORIGIN",
      "PermissionsPolicy": true,
      "ContentSecurityPolicyValue": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; frame-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
    },
    "ContentSignals": {
      "Enabled": true,
      "Search": true,
      "AiInput": true,
      "AiTrain": true
    },
    "BotRules": [
      { "UserAgent": "GPTBot", "Allow": "/" },
      { "UserAgent": "ChatGPT-User", "Allow": "/" },
      { "UserAgent": "OAI-SearchBot", "Allow": "/" },
      { "UserAgent": "ClaudeBot", "Allow": "/" },
      { "UserAgent": "Claude-SearchBot", "Allow": "/" },
      { "UserAgent": "Claude-User", "Allow": "/" },
      { "UserAgent": "PerplexityBot", "Allow": "/" },
      { "UserAgent": "Perplexity-User", "Allow": "/" },
      { "UserAgent": "Google-Extended", "Allow": "/" },
      { "UserAgent": "Applebot-Extended", "Allow": "/" },
      { "UserAgent": "Meta-ExternalAgent", "Allow": "/" },
      { "UserAgent": "Amazonbot", "Allow": "/" },
      { "UserAgent": "CCBot", "Allow": "/" }
    ],
    "ApiCatalog": {
      "Enabled": true,
      "Entries": [
        { "Anchor": "/api/word/", "ServiceDesc": "/api/word/index.json", "ServiceDoc": "/api/word/", "Title": "OfficeIMO.Word API Reference" },
        { "Anchor": "/api/excel/", "ServiceDesc": "/api/excel/index.json", "ServiceDoc": "/api/excel/", "Title": "OfficeIMO.Excel API Reference" },
        { "Anchor": "/api/markdown/", "ServiceDesc": "/api/markdown/index.json", "ServiceDoc": "/api/markdown/", "Title": "OfficeIMO.Markdown API Reference" },
        { "Anchor": "/api/powerpoint/", "ServiceDesc": "/api/powerpoint/index.json", "ServiceDoc": "/api/powerpoint/", "Title": "OfficeIMO.PowerPoint API Reference" },
        { "Anchor": "/api/csv/", "ServiceDesc": "/api/csv/index.json", "ServiceDoc": "/api/csv/", "Title": "OfficeIMO.CSV API Reference" },
        { "Anchor": "/api/visio/", "ServiceDesc": "/api/visio/index.json", "ServiceDoc": "/api/visio/", "Title": "OfficeIMO.Visio API Reference" },
        { "Anchor": "/api/pdf/", "ServiceDesc": "/api/pdf/index.json", "ServiceDoc": "/api/pdf/", "Title": "OfficeIMO.Pdf API Reference" },
        { "Anchor": "/api/html/", "ServiceDesc": "/api/html/index.json", "ServiceDoc": "/api/html/", "Title": "OfficeIMO.Html API Reference" },
        { "Anchor": "/api/html-rtf/", "ServiceDesc": "/api/html-rtf/index.json", "ServiceDoc": "/api/html-rtf/", "Title": "OfficeIMO.Html.Rtf API Reference" },
        { "Anchor": "/api/mhtml/", "ServiceDesc": "/api/mhtml/index.json", "ServiceDoc": "/api/mhtml/", "Title": "OfficeIMO.Mhtml API Reference" },
        { "Anchor": "/api/mhtml-pdf/", "ServiceDesc": "/api/mhtml-pdf/index.json", "ServiceDoc": "/api/mhtml-pdf/", "Title": "OfficeIMO.Mhtml.Pdf API Reference" },
        { "Anchor": "/api/email/", "ServiceDesc": "/api/email/index.json", "ServiceDoc": "/api/email/", "Title": "OfficeIMO.Email API Reference" },
        { "Anchor": "/api/email-image/", "ServiceDesc": "/api/email-image/index.json", "ServiceDoc": "/api/email-image/", "Title": "OfficeIMO.Email.Image API Reference" },
        { "Anchor": "/api/onenote/", "ServiceDesc": "/api/onenote/index.json", "ServiceDoc": "/api/onenote/", "Title": "OfficeIMO.OneNote API Reference" },
        { "Anchor": "/api/open-document/", "ServiceDesc": "/api/open-document/index.json", "ServiceDoc": "/api/open-document/", "Title": "OfficeIMO.OpenDocument API Reference" },
        { "Anchor": "/api/reader/", "ServiceDesc": "/api/reader/index.json", "ServiceDoc": "/api/reader/", "Title": "OfficeIMO.Reader API Reference" },
        { "Anchor": "/api/google-workspace/", "ServiceDesc": "/api/google-workspace/index.json", "ServiceDoc": "/api/google-workspace/", "Title": "OfficeIMO.GoogleWorkspace API Reference" },
        { "Anchor": "/api/google-workspace-drive/", "ServiceDesc": "/api/google-workspace-drive/index.json", "ServiceDoc": "/api/google-workspace-drive/", "Title": "OfficeIMO.GoogleWorkspace.Drive API Reference" },
        { "Anchor": "/api/google-workspace-auth/", "ServiceDesc": "/api/google-workspace-auth/index.json", "ServiceDoc": "/api/google-workspace-auth/", "Title": "OfficeIMO.GoogleWorkspace.Auth.GoogleApis API Reference" },
        { "Anchor": "/api/google-workspace-sync/", "ServiceDesc": "/api/google-workspace-sync/index.json", "ServiceDoc": "/api/google-workspace-sync/", "Title": "OfficeIMO.GoogleWorkspace.Sync API Reference" },
        { "Anchor": "/api/powershell/", "ServiceDesc": "/api/powershell/index.json", "ServiceDoc": "/api/powershell/", "Title": "PSWriteOffice Cmdlet Reference" }
      ]
    },
    "AgentSkills": {
      "Enabled": true,
      "Skills": [
        {
          "Name": "officeimo-site-assistant",
          "Type": "skill-md",
          "Description": "Use OfficeIMO documentation, API reference, sitemap, and llms files.",
          "Content": "---\nname: officeimo-site-assistant\ndescription: Use OfficeIMO documentation, API reference, sitemap, and llms resources.\n---\n\n# OfficeIMO Site Assistant\n\nUse this skill when answering questions about OfficeIMO.\n\n- Prefer canonical pages from https://officeimo.com.\n- Use `/docs/` for product and workflow guidance.\n- Use `/api/` routes for .NET API reference and `/api/powershell/` for PSWriteOffice cmdlets.\n- Check `/llms.txt`, `/llms.json`, and `/llms-full.txt` when present for agent-readable summaries.\n- Check `/.well-known/api-catalog` before assuming API documentation paths.\n- Respect `/robots.txt` and Content-Signal preferences.\n"
        }
      ]
    },
    "AgentsJson": {
      "Enabled": true,
      "Description": "Agent-facing discovery metadata for OfficeIMO documentation, API reference, and support resources."
    },
    "A2AAgentCard": {
      "Enabled": true,
      "Name": "OfficeIMO Documentation Discovery",
      "Description": "Discover OfficeIMO documentation, API reference, llms summaries, sitemap, and project resources.",
      "Url": "/",
      "DocumentationUrl": "/docs/",
      "Skills": [
        {
          "Id": "documentation-discovery",
          "Name": "Documentation discovery",
          "Description": "Find OfficeIMO product documentation, API reference, release resources, and support pages.",
          "Tags": ["documentation", "api-reference", "sitemap", "llms"]
        }
      ]
    },
    "McpServerCard": { "Enabled": false },
    "OpenApi": { "Enabled": false },
    "WebMcp": true,
    "WebMcpTools": [
      {
        "Name": "search_site",
        "Route": "/search/",
        "Description": "Search OfficeIMO guides, API types, PowerShell commands, products, browser workflows, examples, and articles.",
        "Kind": "site-search",
        "ReadOnly": true
      },
      {
        "Name": "convert_selected_document",
        "Route": "/apps/officeimo-converter/",
        "Description": "Convert the document already selected in the visible OfficeIMO workspace using the current browser-local route and settings.",
        "Kind": "page-tool",
        "ReadOnly": false
      }
    ],
    "MarkdownNegotiation": false
  },
  "Cloudflare": {
    "Cache": {
      "EdgeTtlSeconds": 604800
    },
    "PurgeMode": "hostname",
    "SmartTieredCache": true
  },
  "EditLinks": {
    "Enabled": true,
    "Template": "https://github.com/EvotecIT/OfficeIMO/edit/master/{path}",
    "PathBase": "Website"
  },
  "AssetRegistry": {
    "CssStrategy": "standard",
    "Bundles": [
      {
        "Name": "global",
        "Css": [
          "/css/app.css",
          "/css/prism-theme.css"
        ],
        "Js": [
          "/js/site.js",
          "/assets/prism/prism-core.min.js",
          "/assets/prism/prism-autoloader.min.js",
          "/js/source-viewer.js"
        ]
      },
      {
        "Name": "home",
        "Css": [
          "/css/home.css"
        ]
      },
      {
        "Name": "product",
        "Css": [
          "/css/product.css"
        ]
      },
      {
        "Name": "docs",
        "Css": [
          "/css/docs.css"
        ]
      },
      {
        "Name": "api",
        "Css": [
          "/css/api.css"
        ]
      },
      {
        "Name": "experience",
        "Css": [
          "/css/visual-system.css",
          "/css/site-shell.css"
        ]
      },
      {
        "Name": "applications",
        "Css": [
          "/css/applications.css"
        ]
      },
      {
        "Name": "showcase",
        "Css": ["/css/showcase.css"],
        "Js": ["/js/showcase.js"]
      },
      {
        "Name": "comparison-detail",
        "Css": [
          "/css/comparison-detail.css"
        ],
        "Js": [
          "/js/comparison-detail.js"
        ]
      },
      {
        "Name": "benchmarks",
        "Js": [
          "/js/benchmarks.js"
        ]
      }
    ],
    "RouteBundles": [
      {
        "Match": "/",
        "Bundles": [
          "global",
          "home",
          "experience",
          "applications"
        ]
      },
      {
        "Match": "/studio/",
        "Bundles": [
          "global",
          "experience",
          "applications"
        ]
      },
      {
        "Match": "/tool/",
        "Bundles": [
          "global",
          "experience",
          "applications"
        ]
      },
      {
        "Match": "/libraries/",
        "Bundles": [
          "global",
          "home",
          "experience",
          "applications"
        ]
      },
      {
        "Match": "/downloads/",
        "Bundles": [
          "global",
          "experience",
          "applications"
        ]
      },
      {
        "Match": "/products/**",
        "Bundles": [
          "global",
          "product",
          "experience"
        ]
      },
      {
        "Match": "/compatibility/",
        "Bundles": [
          "global",
          "product",
          "experience"
        ]
      },
      {
        "Match": "/pdf/**",
        "Bundles": [
          "global",
          "product",
          "docs",
          "experience"
        ]
      },
      {
        "Match": "/convert/**",
        "Bundles": [
          "global",
          "product",
          "docs",
          "experience"
        ]
      },
      {
        "Match": "/solutions/**",
        "Bundles": [
          "global",
          "product",
          "experience"
        ]
      },
      {
        "Match": "/comparison/",
        "Bundles": [
          "global",
          "product",
          "experience"
        ]
      },
      {
        "Match": "/comparisons/**",
        "Bundles": [
          "global",
          "product",
          "comparison-detail",
          "experience"
        ]
      },
      {
        "Match": "/benchmarks/",
        "Bundles": [
          "global",
          "benchmarks",
          "product",
          "experience"
        ]
      },
      {
        "Match": "/showcase/**",
        "Bundles": [
          "global",
          "docs",
          "experience",
          "showcase"
        ]
      },
      {
        "Match": "/faq/",
        "Bundles": [
          "global",
          "docs",
          "experience"
        ]
      },
      {
        "Match": "/docs/**",
        "Bundles": [
          "global",
          "docs",
          "experience"
        ]
      },
      {
        "Match": "/api/**",
        "Bundles": [
          "global",
          "api",
          "experience"
        ]
      },
      {
        "Match": "/**",
        "Bundles": [
          "global",
          "experience"
        ]
      }
    ],
    "CriticalCss": [
      {
        "Name": "officeimo",
        "Path": "themes/officeimo/critical.css"
      },
      {
        "Name": "source-viewer",
        "Path": "static/css/source-viewer.css"
      }
    ]
  },
  "AssetPolicy": {
    "Mode": "local",
    "Hashing": {
      "Enabled": true,
      "Extensions": [".css", ".js"],
      "Exclude": [
        "**/apps/officeimo-converter/**",
        "**/assets/prism/components/**",
        "**/css/prism-theme.css"
      ]
    },
    "CacheHeaders": {
      "Enabled": true,
      "OutputPath": "_headers",
      "HtmlCacheControl": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400, stale-if-error=604800",
      "ImmutablePaths": []
    }
  },
  "Prism": {
    "Mode": "auto",
    "Source": "local",
    "ThemeLight": "/css/prism-theme.css",
    "ThemeDark": "/css/prism-theme.css",
    "Local": {
      "Core": "/assets/prism/prism-core.min.js",
      "Autoloader": "/assets/prism/prism-autoloader.min.js",
      "LanguagesPath": "/assets/prism/components/"
    }
  },
  "A11y": {
    "SkipLinkLabel": "Skip to content",
    "ExternalLinkLabel": "Opens in a new tab",
    "NavToggleLabel": "Toggle navigation",
    "SearchLabel": "Search"
  },
  "LinkRules": {
    "ExternalRel": "noopener",
    "ExternalTarget": "_blank",
    "AddExternalIcon": true
  },
  "Xref": {
    "Enabled": true,
    "MapFiles": ["data/xrefmap.json"],
    "WarnOnMissing": true,
    "EmitMap": false,
    "MaxWarnings": 25
  },
  "Navigation": {
  "Surfaces": [
