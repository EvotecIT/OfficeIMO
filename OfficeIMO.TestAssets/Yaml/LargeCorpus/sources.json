      "commit": "ad19e91d20148d22f717365b75d24ff9cff92ad4",
      "license": "Apache-2.0",
      "licenseFile": "content/LICENSE.md",
      "include": ["content/**/*.md", "data/**/*.{yml,yaml}"],
      "why": "Hugo documentation front matter (dates, aliases, lists) and data files. Pages with TOML front matter are recorded as excluded."
    },
    {
      "id": "github-docs",
      "category": "Docs",
      "repository": "https://github.com/github/docs",
      "commit": "404a5f4de6cd5311e3ce2d5c076571291e0107d6",
      "license": "CC-BY-4.0",
      "licenseFile": "LICENSE",
