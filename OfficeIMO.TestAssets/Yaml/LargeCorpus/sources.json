      "commit": "dae11e6379ac0c218c2b0723f8e6f56888278b96",
      "license": "Apache-2.0",
      "licenseFile": "LICENSE",
      "include": [{ "glob": "**/metadata.yaml", "max": 400 }, { "glob": "**/testdata/**/*.{yml,yaml}", "max": 1200 }, ".github/**/*.{yml,yaml}"],
      "why": "Collector configuration files, component metadata and pipeline test inputs."
    },
    {
      "id": "aspire",
      "category": "AppConfig",
