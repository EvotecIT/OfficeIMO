      "licenseFile": "LICENSE.txt",
      "include": ["**/*.{yml,yaml}"],
      "why": "CloudFormation short-form intrinsic tags (!Ref, !Sub, !GetAtt, !If) in every position."
    },
    {
      "id": "serverless-application-model",
      "category": "CloudFormation",
      "repository": "https://github.com/aws/serverless-application-model",
      "commit": "88724d3bc8bc7f60d5ef1f4d53edb8c5353221fb",
      "license": "Apache-2.0",
      "licenseFile": "LICENSE",
      "include": [{ "glob": "tests/translator/input/**/*.{yml,yaml}", "max": 900 }, "examples/**/*.{yml,yaml}"],
      "why": "SAM translator inputs: every SAM resource shape, intrinsic tags and edge cases written by the SAM team."
    },
    {
      "id": "serverless-patterns",
      "category": "CloudFormation",
