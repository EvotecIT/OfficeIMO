      "why": "Kustomization files, patches and generator inputs."
    },
    {
      "id": "argo-workflows",
      "category": "Kubernetes",
      "repository": "https://github.com/argoproj/argo-workflows",
      "commit": "45e810c8f15eec84c13c3a3e9d8dc6d14b97d068",
      "license": "Apache-2.0",
      "licenseFile": "LICENSE",
      "include": ["examples/**/*.{yml,yaml}", "manifests/**/*.{yml,yaml}", "test/e2e/**/*.{yml,yaml}"],
      "why": "Workflow custom resources with embedded scripts in literal block scalars and {{ }} parameters inside strings."
    },
    {
      "id": "istio",
      "category": "Helm",
      "repository": "https://github.com/istio/istio",
      "commit": "562b793a73db8e66bc69a0fed99457c3794014da",
      "license": "Apache-2.0",
      "licenseFile": "LICENSE",
      "include": ["samples/**/*.{yml,yaml}", "manifests/**/*.{yml,yaml}"],
      "classify": [
        { "glob": "manifests/**/templates/**", "pattern": "\\{\\{", "reason": "Helm Go template: '{{ }}' actions are not YAML until rendered." }
      ],
      "why": "Service-mesh samples and Helm charts; templates that are plain YAML stay in, Go-templated ones are classified out."
    },
    {
      "id": "bitnami-charts",
      "category": "Helm",
      "repository": "https://github.com/bitnami/charts",
      "commit": "893617002038e004458bab28a14b126de43bc3e7",
      "license": "Apache-2.0",
      "licenseFile": "LICENSE.md",
      "include": ["bitnami/*/values.yaml", "bitnami/*/Chart.yaml", { "glob": "bitnami/*/templates/**/*.yaml", "max": 300 }],
      "classify": [
        { "glob": "bitnami/*/templates/**", "pattern": "\\{\\{", "reason": "Helm Go template: '{{ }}' actions are not YAML until rendered." }
      ],
      "why": "Very large, heavily commented values.yaml files with ## @param annotations."
    },
    {
      "id": "prometheus-community-charts",
