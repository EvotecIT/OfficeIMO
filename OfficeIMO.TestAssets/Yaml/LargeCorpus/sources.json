      "why": "GitHub documentation data and front matter: versioning maps and Liquid inside YAML strings."
    },
    {
      "id": "flutter",
      "category": "AppConfig",
      "repository": "https://github.com/flutter/flutter",
      "commit": "fffd8c22ae64bcc94f14b9c747c07ea129e4b40b",
      "license": "BSD-3-Clause",
      "licenseFile": "LICENSE",
      "include": [{ "glob": "**/pubspec.yaml", "max": 700 }, { "glob": "**/analysis_options.yaml", "max": 200 }, ".ci.yaml", ".github/**/*.{yml,yaml}"],
      "why": "Dart pubspec files with dependency pins and checksum comments, analysis options and Flutter's large .ci.yaml."
    },
    {
      "id": "conda-staged-recipes",
      "category": "AppConfig",
      "repository": "https://github.com/conda-forge/staged-recipes",
      "commit": "90e0fd4159cd932e34ca1db8d8e75012a5aa5009",
      "license": "BSD-3-Clause",
      "licenseFile": "LICENSE.txt",
      "include": ["recipes/**/*.{yml,yaml}", ".github/**/*.{yml,yaml}", "*.yml"],
      "classify": [
        { "glob": "recipes/**", "pattern": "\\{%|(?<!\\$)\\{\\{", "reason": "conda-build Jinja template: '{% %}' and '{{ }}' are not YAML until rendered." }
      ],
      "why": "Conda recipes: new-style recipe.yaml is YAML with ${{ }} expressions, old-style meta.yaml is Jinja and is classified out."
    },
    {
      "id": "conda",
