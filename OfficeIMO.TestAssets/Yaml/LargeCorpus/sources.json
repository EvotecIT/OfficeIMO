      "commit": "fc8dbc1a8fd1878f2e564c69ee9fb0608b213b2a",
      "license": "MIT",
      "licenseFile": "LICENSE",
      "include": ["**/*.{yml,yaml}"],
      "why": "CircleCI orb source and config: << parameters >> placeholders inside scalars."
    },
