{
  "description": "Opt-in large real-world YAML corpus. Update-YamlLargeCorpus.ps1 fetches each source at its pinned commit into a local cache; the files are never committed. Globs are relative to the repository root ('**' spans folders, '{a,b}' lists alternatives). 'max' samples a sorted match list evenly; 'exclude' paths are recorded with their reason and not fetched; 'classify' marks fetched files that are not YAML (templating) as excluded with a reason.",
  "sources": [
    {
      "id": "starter-workflows",
      "category": "GitHubActions",
      "repository": "https://github.com/actions/starter-workflows",
      "commit": "e3c451d60f119b71caebf13c98ac45da6e15b4b7",
      "license": "MIT",
      "licenseFile": "LICENSE",
      "include": ["**/*.{yml,yaml}"],
      "why": "GitHub's own workflow templates: 'on:' keys, expressions, matrices and $default-branch placeholders."
    },
    {
      "id": "vscode",
      "category": "AzurePipelines",
      "repository": "https://github.com/microsoft/vscode",
      "commit": "f48c6323eca71d3e6d7eef38c6b4dddaacb2bfbf",
      "license": "MIT",
      "licenseFile": "LICENSE.txt",
      "include": [".github/**/*.{yml,yaml}", "build/azure-pipelines/**/*.{yml,yaml}", ".config/**/*.{yml,yaml}"],
      "why": "Large Azure Pipelines template tree with ${{ }} template expressions, plus a busy repository's Actions, issue forms and dependabot settings."
    },
    {
      "id": "dotnet-runtime",
      "category": "AzurePipelines",
      "repository": "https://github.com/dotnet/runtime",
      "commit": "a6ecc0e80a43003b676ccb47088075a256b5f796",
      "license": "MIT",
      "licenseFile": "LICENSE.TXT",
      "include": ["eng/pipelines/**/*.{yml,yaml}", ".github/**/*.{yml,yaml}", "eng/common/**/*.{yml,yaml}"],
      "why": "Deeply templated Azure Pipelines with conditional insertion keys (- ${{ if ... }}:) and long folded conditions."
    },
    {
      "id": "dotnet-arcade",
      "category": "AzurePipelines",
      "repository": "https://github.com/dotnet/arcade",
      "commit": "ac48b193ff381faeb73f097d14ca55a95b284e18",
      "license": "MIT",
      "licenseFile": "LICENSE.TXT",
      "include": ["eng/**/*.{yml,yaml}", "*.{yml,yaml}", ".github/**/*.{yml,yaml}"],
      "why": "Shared .NET build templates consumed across hundreds of repositories."
    },
    {
      "id": "azure-pipelines-yaml",
      "category": "AzurePipelines",
      "repository": "https://github.com/microsoft/azure-pipelines-yaml",
      "commit": "5d433fcad43a32789a968179469c1e6271cb2fc7",
      "license": "MIT",
      "licenseFile": "LICENSE",
      "include": ["**/*.{yml,yaml}"],
      "why": "Microsoft's Azure Pipelines starter templates and design samples."
    },
    {
      "id": "gitlab",
      "category": "GitLabCI",
      "repository": "https://github.com/gitlabhq/gitlabhq",
      "commit": "d7b9a6176ab4e279465ba3ee09922cde2b74de47",
      "license": "MIT",
      "licenseFile": "LICENSE",
      "include": [
        "lib/gitlab/ci/templates/**/*.{yml,yaml}",
        ".gitlab-ci.yml",
        ".gitlab/ci/**/*.{yml,yaml}",
        { "glob": "config/feature_flags/**/*.yml", "max": 600 },
        { "glob": "config/events/**/*.yml", "max": 300 }
      ],
      "exclude": [
        { "glob": "ee/**", "reason": "Enterprise edition directory is under the GitLab EE license, not MIT." },
        { "glob": "doc/**", "reason": "Documentation is CC BY-SA 4.0." },
        { "glob": "jh/**", "reason": "JiHu edition directory has its own license." }
      ],
      "why": "GitHub mirror of gitlab-org/gitlab (gitlab.com refuses partial clones of this size). GitLab CI templates and GitLab's own pipeline (extends, !reference tags, anchors, rules), plus thousands of small machine-written definition files."
    },
    {
