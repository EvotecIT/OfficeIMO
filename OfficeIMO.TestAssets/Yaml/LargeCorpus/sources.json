    {
      "id": "kubernetes",
      "category": "Kubernetes",
      "repository": "https://github.com/kubernetes/kubernetes",
      "commit": "233d4264f96aeaad0e7df0fac058c51736b43360",
      "license": "Apache-2.0",
      "licenseFile": "LICENSE",
