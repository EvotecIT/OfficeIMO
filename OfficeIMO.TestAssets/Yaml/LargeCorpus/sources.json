      "licenseFile": "LICENSE",
      "include": [{ "glob": "*/{template,template-*}.{yml,yaml}", "max": 900 }],
      "why": "Community SAM templates written by many authors, so indentation and quoting habits vary."
    },
    {
      "id": "home-assistant-core",
      "category": "HomeAssistant",
      "repository": "https://github.com/home-assistant/core",
      "commit": "a3c1b933c080a15c662fd259987f728e052fd630",
      "license": "Apache-2.0",
      "licenseFile": "LICENSE.md",
