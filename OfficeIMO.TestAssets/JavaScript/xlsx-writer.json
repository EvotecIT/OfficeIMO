{
  "schemaVersion": 1,
  "cases": [
    { "name": "conditional-report", "options": { "limits": { "maxConditionalFormats": 10, "maxDifferentialStyles": 4 } },
      "styles": [{ "font": { "bold": true, "italic": true, "underline": true }, "border": { "left": { "style": "thin", "color": "0000FF" } } }], "sheets": [
      { "name": "Live report", "title": { "text": "Live report highlights", "height": 30 },
        "columns": [
          { "header": "Name", "key": "name", "groups": ["Metrics"], "width": 22 },
          { "header": "Amount", "key": "amount", "groups": ["Metrics"], "type": "number", "format": "0.00", "width": 18 },
          { "header": "Score", "key": "score", "groups": ["Metrics"], "type": "number", "format": "0", "width": 18 },
          { "header": "Status", "key": "status", "groups": ["State"], "width": 18 },
          { "header": "Seen", "key": "seen", "groups": ["State"], "type": "date", "format": "yyyy-mm-dd", "width": 18 }
        ], "table": { "name": "LiveReport", "style": "TableStyleMedium2" }, "freezeHeader": true,
        "footer": { "values": ["Total"], "totals": { "amount": "sum" } }, "print": { "orientation": "landscape", "repeatHeaders": true },
        "conditionalFormats": [
          { "type": "cellIs", "range": { "column": "amount" }, "operator": "lessThan", "value": 0, "stopIfTrue": true, "style": { "fill": { "color": "FFC7CE" }, "font": { "color": "9C0006" } } },
          { "type": "cellIs", "range": { "column": "amount" }, "operator": "greaterThanOrEqual", "value": 100, "style": { "fill": { "color": "C6EFCE" } } },
          { "type": "expression", "range": { "column": "name", "through": "seen" }, "formula": "$D4=\"FAIL\"", "style": { "font": { "bold": true, "color": "C00000" } } },
          { "type": "colorScale", "range": { "column": "score" }, "stops": [
            { "threshold": { "type": "min" }, "color": "F8696B" },
            { "threshold": { "type": "percentile", "value": 50 }, "color": "FFEB84" },
            { "threshold": { "type": "max" }, "color": "63BE7B" }
          ] },
          { "type": "dataBar", "range": { "column": "score" }, "color": "638EC6", "minimum": { "type": "number", "value": 0 }, "maximum": { "type": "number", "value": 100 } }
        ],
        "rows": [
          ["Łódź 🧪", -12.5, 10, "PASS", { "kind": "date", "value": "2026-10-07T00:00:00Z" }],
          ["Warsaw", 125.75, 90, "FAIL", { "kind": "date", "value": "2026-10-08T00:00:00Z" }],
          ["Paris", 50, 50, "PASS", { "kind": "date", "value": "2026-10-09T00:00:00Z" }]
        ], "expected": { "A4": "Łódź 🧪", "B4": -12.5, "B5": 125.75, "C6": 50, "D5": "FAIL", "E4": { "kind": "date", "value": "2026-10-07T00:00:00Z" } }
      },
      { "name": "Empty report", "columns": [{ "header": "Amount", "key": "amount", "type": "number", "format": "0.00" }],
        "conditionalFormats": [
          { "type": "cellIs", "range": { "column": "amount" }, "operator": "lessThan", "value": 0, "style": { "fill": { "color": "FFC7CE" }, "font": { "color": "9C0006" } } },
          { "type": "expression", "range": "A1", "formula": "1=1", "style": { "fill": { "color": "C6EFCE" } } }
        ], "rows": [], "expected": { "A1": "Amount" }
      },
      { "name": "Overrides", "columns": [{ "header": "Value", "type": "number", "style": 0, "format": "0.00", "width": 25 }],
        "conditionalFormats": [{ "type": "expression", "range": "A2", "formula": "A2>0", "style": {
          "font": { "bold": false, "italic": false, "underline": false }, "numberFormat": "\"_x0041_\"0.0",
          "border": { "bottom": { "style": "thin", "color": "123456" } }
        } },
          { "type": "dataBar", "range": "A2", "color": "638EC6", "minimum": { "type": "number", "value": 0 }, "maximum": { "type": "formula", "value": "=IF(\"_x0041_\"=\"_x0041_\",MAX($A$2:$A$2),100)" } },
          { "type": "colorScale", "range": "A2", "stops": [{ "threshold": { "type": "min" }, "color": "F8696B" }, { "threshold": { "type": "formula", "value": "=IF(\"_x0041_\"=\"_x0041_\",MAX($A$2:$A$2),100)" }, "color": "63BE7B" }] }
        ], "rows": [[12.5]], "expected": { "A2": 12.5 }
      }
    ] },
    { "name": "empty", "sheets": [] },
    { "name": "typed-values", "sheets": [
      { "name": "Data", "columns": [
        { "header": "Text", "width": 28, "wrapText": true, "alignment": "left" },
        { "header": "Number", "type": "number", "format": "0.00" },
        { "header": "Date", "type": "date", "format": "yyyy-mm-dd hh:mm" },
        { "header": "Boolean", "type": "boolean" }, { "header": "Empty" }
      ], "freezeHeader": true, "autoFilter": true, "headerFill": "#D9E1F2",
        "rows": [["Łódź 🧪 שלום <>&\"'\r\n\t_x0041_\u0001\ud800", -1.25, { "kind": "date", "value": "1900-02-28T12:00:00Z" }, true, null],
          ["=literal", 12.5, { "kind": "date", "value": "1900-03-01T00:00:00Z" }, false, null]],
        "expected": { "A2": "Łódź 🧪 שלום <>&\"'\r\n\t_x0041_", "B2": -1.25, "C2": { "kind": "date", "value": "1900-02-28T12:00:00Z" }, "D2": true,
          "A3": "=literal", "B3": 12.5, "C3": { "kind": "date", "value": "1900-03-01T00:00:00Z" }, "D3": false } }
    ] },
    { "name": "projection", "sheets": [
      { "name": "Objects", "columns": [{ "header": "Name", "key": "name" }, { "header": "Literal dot", "key": "a.b" }],
        "rows": [{ "name": "DC01", "a.b": "dot" }, { "name": "DC02" }], "expected": { "A2": "DC01", "B2": "dot", "A3": "DC02" } },
      { "name": "One", "columns": [{ "header": "V" }], "includeHeader": false, "rows": [["one"]], "expected": { "A1": "one" } }
    ] },
    { "name": "styles-custom", "styles": [
      { "font": { "name": "Calibri", "size": 12, "bold": true, "italic": true, "color": "#123456" }, "fill": { "color": "#ABCDEF" },
        "border": { "bottom": { "style": "thin", "color": "#123456" } }, "numberFormat": "0.00", "alignment": "right", "wrapText": true }
    ], "parts": [{ "uri": "/customXml/item1.xml", "contentType": "application/xml", "data": "<data xmlns=\"urn:officeimo:test\">Łódź</data>",
        "relationship": { "id": "custom", "type": "http://schemas.openxmlformats.org/officeDocument/2006/relationships/customXml" } }],
      "sheets": [{ "name": "Styles", "columns": [{ "header": "Seconds", "type": "milliseconds", "style": 0, "format": "0.000" }],
        "rows": [["1250"], [2500]], "expected": { "A2": 1.25, "A3": 2.5 } }] },
    { "name": "cell-style", "styles": [{ "font": { "bold": true }, "numberFormat": "0.00%" }],
      "sheets": [{ "name": "Cells", "columns": [{ "header": "Value" }], "rows": [[{ "kind": "cell", "value": 0.25, "style": 0 }]], "expected": { "A2": 0.25 } }] },
    { "name": "ooxml-attributes", "styles": [{ "font": { "name": "Font_x0041_" }, "numberFormat": "\"_x003A_\"0" }],
      "sheets": [
        { "name": "_x0041_", "columns": [{ "header": "V", "style": 0 }], "rows": [["literal A escape"]], "expected": { "A2": "literal A escape" } },
        { "name": "A", "columns": [{ "header": "V" }], "rows": [["plain A"]], "expected": { "A2": "plain A" } },
        { "name": "_x003A_", "columns": [{ "header": "V" }], "rows": [["literal colon escape"]], "expected": { "A2": "literal colon escape" } },
        { "name": "_x003a_", "expectedName": "_x003a_ (2)", "columns": [{ "header": "V" }], "rows": [["duplicate literal"]], "expected": { "A2": "duplicate literal" } },
        { "name": "Bad:Name", "expectedName": "Bad_Name", "columns": [{ "header": "V" }], "rows": [["sanitized"]], "expected": { "A2": "sanitized" } },
        { "name": "Bad_Name", "expectedName": "Bad_Name (2)", "columns": [{ "header": "V" }], "rows": [["sanitized duplicate"]], "expected": { "A2": "sanitized duplicate" } },
        { "name": "_x005F_x0041_", "columns": [{ "header": "V" }], "rows": [["literal underscore escape"]], "expected": { "A2": "literal underscore escape" } }
      ] },
    { "name": "colon-targets", "parts": [
      { "uri": "/root:custom.xml", "contentType": "application/xml", "data": "<data xmlns=\"urn:officeimo:test\">root target</data>",
        "relationship": { "id": "rootCustom", "source": "/", "type": "urn:officeimo:test:root-extension" } },
      { "uri": "/xl/custom:part.xml", "contentType": "application/xml", "data": "<data xmlns=\"urn:officeimo:test\">same directory target</data>",
        "relationship": { "id": "sameDirectoryCustom", "type": "http://schemas.openxmlformats.org/officeDocument/2006/relationships/customXml" } }
      ], "sheets": [{ "name": "Relationships", "columns": [{ "header": "V" }], "rows": [["internal targets"]], "expected": { "A2": "internal targets" } }] },
    { "name": "report-table", "styles": [{ "font": { "bold": true, "color": "FFFFFF" }, "fill": { "color": "203864" }, "verticalAlignment": "center" }],
      "sheets": [{ "name": "Controllers", "columns": [
        { "header": "Name", "width": 28 }, { "header": "Latency", "type": "number", "format": "0.000" },
        { "header": "Seen", "type": "date", "format": "yyyy-mm-dd" }, { "header": "Healthy", "type": "boolean" }
      ], "table": { "name": "ControllerReport", "style": "TableStyleMedium9" }, "headerStyle": 0,
        "statusHighlight": true, "freezeHeader": true, "freezeColumns": 1, "headerHeight": 30, "rowHeight": 22,
        "hyperlinks": [{ "cell": "A2", "target": "https://example.com/report?site=lodz&view=health", "tooltip": "Open Łódź _x0041_ report" }],
        "images": [{ "row": 6, "column": 1, "width": 420, "height": 240, "description": "Report chart 🧪", "producer": { "package": "ChartForgeX", "version": "1.8.2", "sha256": "5d1871e1865aa80b99aa5a5c62f831ef383596617def36d7e69924fb055b8412", "license": "MIT" },
          "pngBase64": "" }],
        "alternatingRowStyle": { "fill": { "color": "EAF1F8" } },
        "rows": [["Łódź 🧪", 12.5, { "kind": "date", "value": "2026-10-06T00:00:00Z" }, true],
                 ["Warsaw", 125.75, { "kind": "date", "value": "2026-10-06T00:00:00Z" }, false]],
        "expected": { "A2": "Łódź 🧪", "B3": 125.75, "C3": { "kind": "date", "value": "2026-10-06T00:00:00Z" }, "D3": false } }] },
    { "name": "xml-reject-valid", "options": { "invalidCharacterPolicy": "reject" },
      "sheets": [{ "name": "Data", "columns": [{ "header": "Unicode" }], "rows": [["Zażółć gęślą jaźń 🧪\r\n"]], "expected": { "A2": "Zażółć gęślą jaźń 🧪\r\n" } }] }
  ]
}
