[
  { "name": "grouped ids", "selector": "#p1, #p3", "status": "Parsed", "matches": ["p1", "p3"] },
  { "name": "first child", "selector": "section:first-child", "status": "Parsed", "matches": ["s1"] },
  { "name": "last of type", "selector": "section:last-of-type", "status": "Parsed", "matches": ["s3"] },
  { "name": "only of type none", "selector": "section:only-of-type", "status": "Parsed", "matches": [] },
  { "name": "empty element", "selector": "#span-empty:empty", "status": "Parsed", "matches": ["span-empty"] },
  { "name": "document root", "selector": ":root", "status": "Parsed", "matches": ["root"] },
  { "name": "second child", "selector": "section:nth-child(2)", "status": "Parsed", "matches": ["s2"] },
  { "name": "third from end", "selector": "section:nth-last-child(3)", "status": "Parsed", "matches": ["s3"] },
  { "name": "second element child", "selector": "p:nth-child(2)", "status": "Parsed", "matches": ["p2", "p3"] },
  { "name": "second p", "selector": "p:nth-of-type(2)", "status": "Parsed", "matches": ["p2"] },
  { "name": "last p", "selector": "p:nth-last-of-type(1)", "status": "Parsed", "matches": ["p2", "p3", "p4"] },
  { "name": "first p formula", "selector": "p:nth-of-type(-n+1)", "status": "Parsed", "matches": ["p1", "p3", "p4"] },
  { "name": "zero coefficient", "selector": "p:nth-child(0n+2)", "status": "Parsed", "matches": ["p2", "p3"] },
  { "name": "matches any", "selector": ".alpha:is(#p1, #p3)", "status": "Parsed", "matches": ["p1", "p3"] },
  { "name": "zero specificity matches", "selector": ":where(.picked, #none)", "status": "Parsed", "matches": ["p3"] },
  { "name": "negation", "selector": "p:not(.alpha)", "status": "Parsed", "matches": ["p2", "p4"] },
  { "name": "complex logical arguments", "selector": ":is(section > p, #none)", "status": "Parsed", "matches": ["p1", "p2", "p3", "p4"] },
  { "name": "nested logical arguments", "selector": "p:is(:not(.beta), #p2)", "status": "Parsed", "matches": ["p1", "p2", "p3", "p4"] },
  { "name": "inherited language range", "selector": "p:lang(en)", "status": "Parsed", "matches": ["p3"] },
  { "name": "svg type namespace", "selector": "svg|a", "status": "Parsed", "matches": ["va1", "va2"] },
  { "name": "svg first child", "selector": "svg|a:first-child", "status": "Parsed", "matches": ["va1"] },
  { "name": "xlink attribute namespace", "selector": "svg|a[xlink|href]", "status": "Parsed", "matches": ["va1"] },
  { "name": "any attribute namespace", "selector": "*|a[*|href]", "status": "Parsed", "matches": ["va1"] },
  { "name": "null element namespace", "selector": "|a", "status": "Parsed", "matches": [] },
  { "name": "undeclared prefix", "selector": "missing|a", "status": "InvalidSyntax" },
  { "name": "state fallback", "selector": "p:hover", "status": "Unsupported" },
  { "name": "relational fallback", "selector": "section:has(p)", "status": "Unsupported" },
  { "name": "filtered nth fallback", "selector": "p:nth-child(1 of .alpha)", "status": "Unsupported" },
  { "name": "pseudo element fallback", "selector": "p::before", "status": "Unsupported" },
  { "name": "trailing comma", "selector": "p,", "status": "InvalidSyntax" },
  { "name": "empty logical argument", "selector": "p:is()", "status": "InvalidSyntax" },
  { "name": "valid nth whitespace", "selector": "p:nth-child(-n+ 2)", "status": "Parsed", "matches": ["p1", "p2", "p3", "p4"] },
  { "name": "invalid separated leading sign", "selector": "p:nth-child(+ 2)", "status": "InvalidSyntax" },
  { "name": "invalid separated coefficient", "selector": "p:nth-child(3 n)", "status": "InvalidSyntax" },
  { "name": "invalid unsigned offset", "selector": "p:nth-child(2n 3)", "status": "InvalidSyntax" }
]
