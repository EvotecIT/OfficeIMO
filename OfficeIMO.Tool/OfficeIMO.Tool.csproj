<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Unified command-line interface for OfficeIMO document conversion, extraction, markup, provenance, output, intake, and capability discovery.</Description>
    <VersionPrefix>3.6.2</VersionPrefix>
    <InformationalVersion Condition="'$(PackageVersion)' != ''">$(PackageVersion)</InformationalVersion>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <PackageTags>office;documents;html;pdf;reader;markup;provenance;c2pa;cli;dotnet-tool;officeimo</PackageTags>
    <PackageProjectUrl>https://github.com/EvotecIT/OfficeIMO</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/EvotecIT/OfficeIMO</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>OfficeIMO.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>officeimo</ToolCommandName>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <IsPublishable>true</IsPublishable>
    <LangVersion>Latest</LangVersion>
    <!-- ReadyToRun needs a runtime: a RID-less restore or build doesn't request any platform's packs.
         `dotnet restore -r <rid>` passes RuntimeIdentifiers, so it also restores the ReadyToRun compiler. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != '' or '$(RuntimeIdentifiers)' != '' or '$(PowerForgePackaging)' == 'true'">true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>

  <!-- The tool ships as one small NuGet package that points the .NET 10 SDK at a ReadyToRun-compiled package for the
       machine's runtime, plus a portable package for runtimes not listed here. The release sets PowerForgePackaging;
       other restores skip every platform's runtime, app host and ReadyToRun packs. Pack it yourself with
       -p:PowerForgePackaging=true. -->
  <PropertyGroup Condition="'$(PowerForgePackaging)' == 'true'">
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <RuntimeIdentifiers>$(ToolPackageRuntimeIdentifiers)</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AotValidation)' == 'true'">
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.Core\OfficeIMO.Core.csproj" />
    <ProjectReference Include="..\OfficeIMO.Provenance.C2pa\OfficeIMO.Provenance.C2pa.csproj" />
    <ProjectReference Include="..\OfficeIMO.CSV\OfficeIMO.CSV.csproj" />
    <ProjectReference Include="..\OfficeIMO.Excel.Csv\OfficeIMO.Excel.Csv.csproj" />
    <ProjectReference Include="..\OfficeIMO.Excel.Pdf\OfficeIMO.Excel.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Html.Pdf\OfficeIMO.Html.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Mhtml\OfficeIMO.Mhtml.csproj" />
    <ProjectReference Include="..\OfficeIMO.Mhtml.Pdf\OfficeIMO.Mhtml.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Ocr\OfficeIMO.Ocr.csproj" />
    <ProjectReference Include="..\OfficeIMO.Pdf.Ocr\OfficeIMO.Pdf.Ocr.csproj" />
    <ProjectReference Include="..\OfficeIMO.Markup\OfficeIMO.Markup.csproj" />
    <ProjectReference Include="..\OfficeIMO.Markup.Excel\OfficeIMO.Markup.Excel.csproj" />
    <ProjectReference Include="..\OfficeIMO.Markup.PowerPoint\OfficeIMO.Markup.PowerPoint.csproj" />
    <ProjectReference Include="..\OfficeIMO.Markup.Word\OfficeIMO.Markup.Word.csproj" />
    <ProjectReference Include="..\OfficeIMO.Reader.All\OfficeIMO.Reader.All.csproj" />
    <ProjectReference Include="..\OfficeIMO.PowerPoint.Pdf\OfficeIMO.PowerPoint.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Word.Pdf\OfficeIMO.Word.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Workflows\OfficeIMO.Workflows.csproj" />
    <ProjectReference Include="..\OfficeIMO.Workflows.IWork\OfficeIMO.Workflows.IWork.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Assets\OfficeIMO.png" Pack="true" PackagePath="\" Link="OfficeIMO.png" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OfficeIMO.Tool.Tests" />
  </ItemGroup>
  <!-- Without the runtime list, pack would quietly produce a RID-neutral package, or a single-platform package under
       the main package ID, instead of the per-platform set. BeforePack runs before NuGet writes anything. -->
  <PropertyGroup>
    <BeforePack>RequireToolPackagingProperty;$(BeforePack)</BeforePack>
  </PropertyGroup>
  <Target Name="RequireToolPackagingProperty" Condition="'$(PowerForgePackaging)' != 'true'">
    <Error Text="OfficeIMO.Tool packs its per-platform packages only with -p:PowerForgePackaging=true, which PSPublishModule 3.0.196 or newer sets for releases." />
  </Target>
</Project>
