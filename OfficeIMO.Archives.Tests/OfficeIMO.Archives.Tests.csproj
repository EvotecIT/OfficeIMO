<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' ">$(TargetFrameworks);net472</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Fixtures/IndependentZip/*" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5"><PrivateAssets>all</PrivateAssets></PackageReference>
    <ProjectReference Include="..\OfficeIMO.Archives\OfficeIMO.Archives.csproj" />
    <ProjectReference Include="..\OfficeIMO.Reader.Zip\OfficeIMO.Reader.Zip.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System" /><Using Include="System.IO" /><Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" /><Using Include="System.Text" /><Using Include="System.Threading" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'"><Reference Include="System.IO.Compression" /></ItemGroup>
  <ItemGroup>
    <None Include="../OfficeIMO.OneNote.Tests/Fixtures/makecab-lzx-testOneNote2016.cab" Link="Fixtures/makecab-lzx-testOneNote2016.cab" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../OfficeIMO.OneNote.Tests/Fixtures/testOneNote2016.one" Link="Fixtures/testOneNote2016.one" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../OfficeIMO.OneNote.Tests/Fixtures/makecab-lzx-testOneNoteFromOffice365-2.cab" Link="Fixtures/makecab-lzx-testOneNoteFromOffice365-2.cab" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../OfficeIMO.OneNote.Tests/Fixtures/testOneNoteFromOffice365-2.one" Link="Fixtures/testOneNoteFromOffice365-2.one" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../OfficeIMO.OneNote.Tests/Fixtures/makecab-lzx*-e8.cab" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
