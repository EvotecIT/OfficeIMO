{
  "schema": "officeimo.conversion.job.v2",
  "batch": {
    "name": "Monthly text archive",
    "inputDirectory": "Inputs",
    "outputDirectory": "Outputs/Folder",
    "targetExtension": ".pdf",
    "resumeFrom": "Checkpoints/Folder/plan.json",
    "extensions": [
      ".txt"
    ]
  },
  "settings": {
    "textEncoding": "utf-8",
    "tabSize": 4
  }
}
