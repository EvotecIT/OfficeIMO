  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OfficeIMO.Workflows.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Workflows.IWork" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Project/ProjectReport.css" LogicalName="OfficeIMO.Workflows.Project.ProjectReport.css" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="..\OfficeIMO\OfficeIMO.csproj" /></ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>
</Project>
