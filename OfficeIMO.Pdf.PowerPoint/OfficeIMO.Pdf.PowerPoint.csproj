<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Reconstruct PowerPoint presentations from PDF using the first-party OfficeIMO engines.</Description>
    <PackageId>OfficeIMO.Pdf.PowerPoint</PackageId>
    <AssemblyName>OfficeIMO.Pdf.PowerPoint</AssemblyName>
    <AssemblyTitle>OfficeIMO.Pdf.PowerPoint</AssemblyTitle>
    <VersionPrefix>3.5.3</VersionPrefix>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' ">$(TargetFrameworks);net472</TargetFrameworks>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <PackageTags>pdf;openxml;office;pptx;powerpoint;officeimo-pdf</PackageTags>
    <PackageProjectUrl>https://github.com/EvotecIT/OfficeIMO</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/EvotecIT/OfficeIMO</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>OfficeIMO.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>Latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Assets\OfficeIMO.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>README.md</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.PowerPoint\OfficeIMO.PowerPoint.csproj" />
    <ProjectReference Include="..\OfficeIMO.Pdf\OfficeIMO.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Core\OfficeIMO.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Globalization" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OfficeIMO.PowerPoint.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Pdf.Tests" />
  </ItemGroup>
  <ItemGroup><Using Include="OfficeIMO.PowerPoint" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="OfficeIMO.OpenDocument.Odp.Pdf" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="OfficeIMO" /></ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="OfficeIMO.Web.Converter" /><InternalsVisibleTo Include="OfficeIMO.Web.Converter.Tests" /></ItemGroup>
</Project>
