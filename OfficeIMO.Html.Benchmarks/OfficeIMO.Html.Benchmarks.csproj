<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.Core\OfficeIMO.Core.csproj" />
    <ProjectReference Include="..\OfficeIMO.Html\OfficeIMO.Html.csproj" />
    <ProjectReference Include="..\OfficeIMO.Html.Pdf\OfficeIMO.Html.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\OfficeIMO.TestAssets\HtmlQualificationCorpus.cs" Link="Shared\HtmlQualificationCorpus.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="html-layout-performance-budgets.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OfficeIMO.TestAssets\Documents\Html\Qualification\H0\v1\**"
          Link="Documents\Html\Qualification\H0\v1\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
