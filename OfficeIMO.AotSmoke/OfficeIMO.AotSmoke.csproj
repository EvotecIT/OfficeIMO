<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OfficeIMO/OfficeIMO.csproj" />
    <ProjectReference Include="../OfficeIMO.Workflows/OfficeIMO.Workflows.csproj" />
    <Compile Include="../OfficeIMO.All.AotSmoke/ConversionBatchScenario.cs" Link="ConversionBatchScenario.cs" />
  </ItemGroup>
</Project>
