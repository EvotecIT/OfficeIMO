<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>AngleSharp-backed HTML parsing and syntax services for the owned OfficeIMO HTML document model.</Description>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$([MSBuild]::IsOsPlatform(`Windows`))'">$(TargetFrameworks);net472</TargetFrameworks>
    <VersionPrefix>3.4.2</VersionPrefix>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EvotecIT/OfficeIMO</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EvotecIT/OfficeIMO</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPublishable>True</IsPublishable>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <ProjectReference Include="../OfficeIMO.Html.Core/OfficeIMO.Html.Core.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <InternalsVisibleTo Include="OfficeIMO.Html" />
    <InternalsVisibleTo Include="OfficeIMO.Html.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Html.Benchmarks" />
    <InternalsVisibleTo Include="OfficeIMO.Markdown.Html" />
    <InternalsVisibleTo Include="OfficeIMO.Epub.Image" />
    <InternalsVisibleTo Include="OfficeIMO.Excel.Html" />
    <InternalsVisibleTo Include="OfficeIMO.Html.Pdf" />
    <InternalsVisibleTo Include="OfficeIMO.Html.Rtf" />
    <InternalsVisibleTo Include="OfficeIMO.Mhtml" />
    <InternalsVisibleTo Include="OfficeIMO.Email.Image" />
    <InternalsVisibleTo Include="OfficeIMO.Email.Html" />
    <InternalsVisibleTo Include="OfficeIMO.Mhtml.Pdf" />
    <InternalsVisibleTo Include="OfficeIMO.OneNote.Html" />
    <InternalsVisibleTo Include="OfficeIMO.PowerPoint.Html" />
    <InternalsVisibleTo Include="OfficeIMO.Reader.Html" />
    <InternalsVisibleTo Include="OfficeIMO.Workflows" />
    <InternalsVisibleTo Include="OfficeIMO.Word.Html" />
  </ItemGroup>
</Project>
