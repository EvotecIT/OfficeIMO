<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <VersionPrefix>3.4.3</VersionPrefix>
    <PackageId>OfficeIMO.Html.Runtime.Rendering</PackageId>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <PackageProjectUrl>https://github.com/EvotecIT/OfficeIMO</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EvotecIT/OfficeIMO</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Optional application-to-document workflow over the OfficeIMO HTML runtime and renderers.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OfficeIMO.Html.PublicRenderWorker" />
    <InternalsVisibleTo Include="OfficeIMO.Html.Runtime.Tests" />
    <ProjectReference Include="../OfficeIMO.Html/OfficeIMO.Html.csproj" />
    <ProjectReference Include="../OfficeIMO.Html.Runtime/OfficeIMO.Html.Runtime.csproj" />
    <ProjectReference Include="../OfficeIMO.Html.Pdf/OfficeIMO.Html.Pdf.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
