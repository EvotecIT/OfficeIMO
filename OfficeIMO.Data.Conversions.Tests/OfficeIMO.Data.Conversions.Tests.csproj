<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' ">$(TargetFrameworks);net472</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <LangVersion>Latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.Data.Conversions\OfficeIMO.Data.Conversions.csproj" />
    <ProjectReference Include="..\OfficeIMO.Data.Conversions.Excel\OfficeIMO.Data.Conversions.Excel.csproj" />
    <ProjectReference Include="..\OfficeIMO\OfficeIMO.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The yaml-test-suite and corpus loaders are shared with OfficeIMO.Yaml.Tests, so both read the same pinned bytes. -->
    <Compile Include="..\OfficeIMO.TestAssets\RepositoryTestPaths.cs" Link="Shared\RepositoryTestPaths.cs" />
    <Compile Include="..\OfficeIMO.Yaml.Tests\Conformance\YamlTestSuite.cs" Link="Shared\Yaml\YamlTestSuite.cs" />
    <Compile Include="..\OfficeIMO.Yaml.Tests\Conformance\YamlCorpus.cs" Link="Shared\Yaml\YamlCorpus.cs" />
    <Compile Include="..\OfficeIMO.Yaml.Tests\Conformance\YamlJsonReader.cs" Link="Shared\Yaml\YamlJsonReader.cs" />
    <Compile Include="..\OfficeIMO.Yaml.Tests\Conformance\YamlConformanceNode.cs" Link="Shared\Yaml\YamlConformanceNode.cs" />
    <Compile Include="..\OfficeIMO.Yaml.Tests\Conformance\YamlJsonEquivalence.cs" Link="Shared\Yaml\YamlJsonEquivalence.cs" />
    <!-- toml-test and its tagged-JSON comparer are shared with OfficeIMO.Toml.Tests. -->
    <Compile Include="..\OfficeIMO.Toml.Tests\Conformance\TomlTestAssets.cs" Link="Shared\Toml\TomlTestAssets.cs" />
    <Compile Include="..\OfficeIMO.Toml.Tests\Conformance\TomlJson.cs" Link="Shared\Toml\TomlJson.cs" />
  </ItemGroup>
</Project>
