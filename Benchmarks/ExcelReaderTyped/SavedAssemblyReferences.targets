<Project>
  <!-- BDN's ProjectReference does not propagate saved DLL compile references. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'BenchmarkDotNet.Autogenerated' and '$(OfficeIMOBenchmarkAssemblyDirectory)' != ''">
    <Reference Include="OfficeIMO.Excel">
      <HintPath>$(OfficeIMOBenchmarkAssemblyDirectory)/OfficeIMO.Excel.dll</HintPath>
    </Reference>
    <Reference Include="OfficeIMO.Core">
      <HintPath>$(OfficeIMOBenchmarkAssemblyDirectory)/OfficeIMO.Core.dll</HintPath>
    </Reference>
    <Reference Include="OfficeIMO.CSV" Condition="'$(OfficeIMOBenchmarkCsv)' == 'true'">
      <HintPath>$(OfficeIMOBenchmarkAssemblyDirectory)/OfficeIMO.CSV.dll</HintPath>
    </Reference>
    <Reference Include="OfficeIMO.Data.Arrow" Condition="'$(OfficeIMOBenchmarkArrow)' == 'true'">
      <HintPath>$(OfficeIMOBenchmarkAssemblyDirectory)/OfficeIMO.Data.Arrow.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
