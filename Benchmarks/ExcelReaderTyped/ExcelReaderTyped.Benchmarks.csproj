<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RunAnalyzers>false</RunAnalyzers>
    <OfficeIMOBenchmarkNewApis Condition="'$(OfficeIMOBenchmarkNewApis)' == ''">false</OfficeIMOBenchmarkNewApis>
    <OfficeIMOBenchmarkCsv Condition="'$(OfficeIMOBenchmarkCsv)' == ''">false</OfficeIMOBenchmarkCsv>
    <OfficeIMOBenchmarkArrow Condition="'$(OfficeIMOBenchmarkArrow)' == ''">false</OfficeIMOBenchmarkArrow>
    <DefineConstants Condition="'$(OfficeIMOBenchmarkNewApis)' == 'true'">$(DefineConstants);OFFICEIMO_BENCHMARK_NEW_APIS</DefineConstants>
    <DefineConstants Condition="'$(OfficeIMOBenchmarkCsv)' == 'true'">$(DefineConstants);OFFICEIMO_BENCHMARK_CSV</DefineConstants>
    <DefineConstants Condition="'$(OfficeIMOBenchmarkArrow)' == 'true'">$(DefineConstants);OFFICEIMO_BENCHMARK_ARROW</DefineConstants>
    <AllowUnsafeBlocks Condition="'$(OfficeIMOBenchmarkNewApis)' == 'true'">true</AllowUnsafeBlocks>
    <OfficeIMOBenchmarkAssemblyDirectory Condition="'$(OfficeIMOBenchmarkAssemblyDirectory)' != ''">$([System.IO.Path]::GetFullPath('$(OfficeIMOBenchmarkAssemblyDirectory)'))</OfficeIMOBenchmarkAssemblyDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the benchmark harness and competing engines on the audited upstream versions. -->
    <None Update="SavedAssemblyReferences.targets"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="ExcelReader.NET" Version="6.0.0" ExcludeAssets="analyzers" />
    <PackageReference Include="Sylvan.Data" Version="0.2.17" />
    <PackageReference Include="Sylvan.Data.Excel" Version="0.5.8" />
    <!-- ZIP integrity validation runs only in setup, outside measured operations. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <ProjectReference Include="../../OfficeIMO.Excel/OfficeIMO.Excel.csproj"
                      Condition="'$(OfficeIMOBenchmarkPackageVersion)' == '' and '$(OfficeIMOBenchmarkAssemblyDirectory)' == ''" />
    <PackageReference Include="OfficeIMO.Excel" Version="$(OfficeIMOBenchmarkPackageVersion)"
                      Condition="'$(OfficeIMOBenchmarkPackageVersion)' != ''" />
    <AssemblyMetadata Include="OfficeIMOBenchmarkPackageVersion" Value="$(OfficeIMOBenchmarkPackageVersion)" />
    <AssemblyMetadata Include="OfficeIMOBenchmarkAssemblyDirectory" Value="$(OfficeIMOBenchmarkAssemblyDirectory)" />
    <AssemblyMetadata Include="OfficeIMOBenchmarkNewApis" Value="$(OfficeIMOBenchmarkNewApis)" />
    <AssemblyMetadata Include="OfficeIMOBenchmarkCsv" Value="$(OfficeIMOBenchmarkCsv)" />
    <AssemblyMetadata Include="OfficeIMOBenchmarkArrow" Value="$(OfficeIMOBenchmarkArrow)" />
    <Compile Include="../BenchmarkProcessorAffinity.cs" Link="Shared/BenchmarkProcessorAffinity.cs" />
    <Compile Include="../BenchmarkProcessPriority.cs" Link="Shared/BenchmarkProcessPriority.cs" />
    <Compile Include="../MarkPflug65KFixture.cs" Link="Shared/MarkPflug65KFixture.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(OfficeIMOBenchmarkCsv)' != 'true'">
    <Compile Remove="Csv*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(OfficeIMOBenchmarkCsv)' == 'true'">
    <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
    <ProjectReference Include="../../OfficeIMO.CSV/OfficeIMO.CSV.csproj"
                      Condition="'$(OfficeIMOBenchmarkPackageVersion)' == '' and '$(OfficeIMOBenchmarkAssemblyDirectory)' == ''" />
    <PackageReference Include="OfficeIMO.CSV" Version="$(OfficeIMOBenchmarkPackageVersion)"
                      Condition="'$(OfficeIMOBenchmarkPackageVersion)' != ''" />
    <Reference Include="OfficeIMO.CSV" Condition="'$(OfficeIMOBenchmarkAssemblyDirectory)' != ''">
      <HintPath>$(OfficeIMOBenchmarkAssemblyDirectory)/OfficeIMO.CSV.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(OfficeIMOBenchmarkArrow)' == 'true'">
    <PackageReference Include="ExcelReader.Arrow" Version="6.0.0" />
    <ProjectReference Include="../../OfficeIMO.Data.Arrow/OfficeIMO.Data.Arrow.csproj"
                      Condition="'$(OfficeIMOBenchmarkPackageVersion)' == '' and '$(OfficeIMOBenchmarkAssemblyDirectory)' == ''" />
    <PackageReference Include="OfficeIMO.Data.Arrow" Version="$(OfficeIMOBenchmarkPackageVersion)"
                      Condition="'$(OfficeIMOBenchmarkPackageVersion)' != ''" />
    <Reference Include="OfficeIMO.Data.Arrow" Condition="'$(OfficeIMOBenchmarkAssemblyDirectory)' != ''">
      <HintPath>$(OfficeIMOBenchmarkAssemblyDirectory)/OfficeIMO.Data.Arrow.dll</HintPath>
    </Reference>
    <PackageReference Include="Apache.Arrow" Version="23.0.0" Condition="'$(OfficeIMOBenchmarkAssemblyDirectory)' != ''" />
  </ItemGroup>

  <ItemGroup Condition="'$(OfficeIMOBenchmarkAssemblyDirectory)' != ''">
    <Reference Include="OfficeIMO.Excel"><HintPath>$(OfficeIMOBenchmarkAssemblyDirectory)/OfficeIMO.Excel.dll</HintPath></Reference>
    <Reference Include="OfficeIMO.Core"><HintPath>$(OfficeIMOBenchmarkAssemblyDirectory)/OfficeIMO.Core.dll</HintPath></Reference>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <Target Name="ValidateOfficeIMOBenchmarkInput" BeforeTargets="ResolveReferences">
    <Error Condition="'$(OfficeIMOBenchmarkArrow)' == 'true' and ('$(OfficeIMOBenchmarkNewApis)' != 'true' or '$(OfficeIMOBenchmarkCsv)' != 'true')"
           Text="Arrow comparison cases require OfficeIMOBenchmarkNewApis=true and OfficeIMOBenchmarkCsv=true." />
    <Error Condition="'$(OfficeIMOBenchmarkPackageVersion)' != '' and '$(OfficeIMOBenchmarkAssemblyDirectory)' != ''"
           Text="Choose a package version or a saved assembly directory, rather than both." />
    <Error Condition="'$(OfficeIMOBenchmarkAssemblyDirectory)' != '' and !Exists('$(OfficeIMOBenchmarkAssemblyDirectory)/OfficeIMO.Excel.dll')"
           Text="The saved assembly directory must contain OfficeIMO.Excel.dll." />
    <Error Condition="'$(OfficeIMOBenchmarkAssemblyDirectory)' != '' and !Exists('$(OfficeIMOBenchmarkAssemblyDirectory)/OfficeIMO.Core.dll')"
           Text="The saved assembly directory must contain its matching OfficeIMO.Core.dll." />
    <Error Condition="'$(OfficeIMOBenchmarkCsv)' == 'true' and '$(OfficeIMOBenchmarkAssemblyDirectory)' != '' and !Exists('$(OfficeIMOBenchmarkAssemblyDirectory)/OfficeIMO.CSV.dll')"
           Text="The CSV saved assembly lane must contain its matching OfficeIMO.CSV.dll." />
    <Error Condition="'$(OfficeIMOBenchmarkArrow)' == 'true' and '$(OfficeIMOBenchmarkAssemblyDirectory)' != '' and !Exists('$(OfficeIMOBenchmarkAssemblyDirectory)/OfficeIMO.Data.Arrow.dll')"
           Text="The Arrow saved assembly lane must contain its matching OfficeIMO.Data.Arrow.dll." />
  </Target>

  <Target Name="RemoveIncompatibleExcelReaderGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'ExcelReader.Generator'" />
    </ItemGroup>
  </Target>
</Project>
