<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Opt-in measurement runner, outside the solution: time, peak working set and retained memory of the editable
    ExcelDocument read, edit-and-save and write workloads, on .NET Framework as well as .NET.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' ">$(TargetFrameworks);net472</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <!-- Windows PowerShell 5.1 is a 64-bit process; an SDK-style .NET Framework exe would otherwise run as x86. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../OfficeIMO.Excel/OfficeIMO.Excel.csproj" />
  </ItemGroup>
</Project>
