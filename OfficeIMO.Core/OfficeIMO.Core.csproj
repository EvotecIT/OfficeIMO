<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Shared zero-dependency document, security, drawing, color, image, and font primitives for OfficeIMO projects.</Description>
    <VersionPrefix>3.6.2</VersionPrefix>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' ">$(TargetFrameworks);net472</TargetFrameworks>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <PackageTags>documents;drawing;color;image;raster;png;jpeg;tiff;webp;font;metadata;lifecycle;officeimo;net472;netstandard2.0;net8.0;net10.0</PackageTags>
    <PackageProjectUrl>https://github.com/EvotecIT/OfficeIMO</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPublishable>True</IsPublishable>
    <Copyright>(c) 2011 - 2024 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
    <PackageIcon>OfficeIMO.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/EvotecIT/OfficeIMO</RepositoryUrl>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <LangVersion>Latest</LangVersion>
    <EnableTrimmingPolyfills>true</EnableTrimmingPolyfills>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PSWriteOffice" />
    <InternalsVisibleTo Include="PSWriteOffice.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Archives" />
    <InternalsVisibleTo Include="OfficeIMO.Archives.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Drawing.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Drawing.HarfBuzz.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Email" />
    <InternalsVisibleTo Include="OfficeIMO.Html" />
    <InternalsVisibleTo Include="OfficeIMO" />
    <InternalsVisibleTo Include="OfficeIMO.Word.Html" />
    <InternalsVisibleTo Include="OfficeIMO.Markdown.Html" />
    <InternalsVisibleTo Include="OfficeIMO.Markdown.Pdf" />
    <InternalsVisibleTo Include="OfficeIMO.OneNote" />
    <InternalsVisibleTo Include="OfficeIMO.Chm" />
    <InternalsVisibleTo Include="OfficeIMO.Xps" />
    <InternalsVisibleTo Include="OfficeIMO.Mhtml.Pdf" />
    <InternalsVisibleTo Include="OfficeIMO.DjVu" />
    <InternalsVisibleTo Include="OfficeIMO.Email.Html" />
    <InternalsVisibleTo Include="OfficeIMO.Html.Pdf" />
    <InternalsVisibleTo Include="OfficeIMO.Html.Rtf" />
    <InternalsVisibleTo Include="OfficeIMO.CSV" />
    <InternalsVisibleTo Include="OfficeIMO.Data.Arrow" />
    <InternalsVisibleTo Include="OfficeIMO.Excel" />
    <!-- The shared package writer compiles into Core on .NET 8 and later. -->
    <InternalsVisibleTo Include="OfficeIMO.Excel.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Excel.Pdf" />
    <InternalsVisibleTo Include="OfficeIMO.PowerPoint" />
    <InternalsVisibleTo Include="OfficeIMO.PowerPoint.Pdf" />
    <InternalsVisibleTo Include="OfficeIMO.Pdf" />
    <InternalsVisibleTo Include="OfficeIMO.Rtf" />
    <InternalsVisibleTo Include="OfficeIMO.Rtf.Pdf" />
    <InternalsVisibleTo Include="OfficeIMO.OpenDocument" />
    <InternalsVisibleTo Include="OfficeIMO.Word.OpenDocument" />
    <InternalsVisibleTo Include="OfficeIMO.Excel.OpenDocument" />
    <InternalsVisibleTo Include="OfficeIMO.PowerPoint.OpenDocument" />
    <InternalsVisibleTo Include="OfficeIMO.Word" />
    <InternalsVisibleTo Include="OfficeIMO.Word.Pdf" />
    <InternalsVisibleTo Include="OfficeIMO.Visio" />
    <InternalsVisibleTo Include="OfficeIMO.Epub" />
    <InternalsVisibleTo Include="OfficeIMO.Comic" />
    <InternalsVisibleTo Include="OfficeIMO.Mobi" />
    <InternalsVisibleTo Include="OfficeIMO.Security" />
    <InternalsVisibleTo Include="OfficeIMO.Security.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Provenance.C2pa" />
    <InternalsVisibleTo Include="OfficeIMO.Word.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Word.Benchmarks" />
    <InternalsVisibleTo Include="OfficeIMO.PowerPoint.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Reader.Benchmarks" />
    <InternalsVisibleTo Include="OfficeIMO.Tool" />
    <InternalsVisibleTo Include="OfficeIMO.Tool.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Studio" />
    <InternalsVisibleTo Include="OfficeIMO.Studio.Core" />
    <InternalsVisibleTo Include="OfficeIMO.Excel.Csv" />
    <InternalsVisibleTo Include="OfficeIMO.AsciiDoc.Markdown" />
    <InternalsVisibleTo Include="OfficeIMO.Latex.Markdown" />
    <InternalsVisibleTo Include="OfficeIMO.Markup" />
    <InternalsVisibleTo Include="OfficeIMO.Markup.Word" />
    <InternalsVisibleTo Include="OfficeIMO.Markup.Excel" />
    <InternalsVisibleTo Include="OfficeIMO.Workflows" />
    <InternalsVisibleTo Include="OfficeIMO.Workflows.IWork" />
    <InternalsVisibleTo Include="OfficeIMO.RealWorldCorpus.Tool" />
    <InternalsVisibleTo Include="OfficeIMO.GoogleWorkspace.Drive" />
    <InternalsVisibleTo Include="OfficeIMO.IWork" />
    <InternalsVisibleTo Include="OfficeIMO.Excel.IWork" />
    <InternalsVisibleTo Include="OfficeIMO.IWork.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Opml" />
    <InternalsVisibleTo Include="OfficeIMO.Project" />
    <InternalsVisibleTo Include="OfficeIMO.Publisher" />
    <InternalsVisibleTo Include="OfficeIMO.Publisher.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Access" />
    <InternalsVisibleTo Include="OfficeIMO.Project.Verification" />
    <InternalsVisibleTo Include="OfficeIMO.Project.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.DocBook" />
    <InternalsVisibleTo Include="OfficeIMO.Reader.Opml" />
    <InternalsVisibleTo Include="OfficeIMO.Reader.Web" />
    <InternalsVisibleTo Include="OfficeIMO.RealWorldCorpus.Tool" />
    <Compile Include="..\OfficeIMO.SharedSource\IO\OfficeFileCommitClaim.cs" Link="Internal\IO\OfficeFileCommitClaim.cs" />
    <Compile Include="..\OfficeIMO.SharedSource\IO\OfficeStableFileRead.cs" Link="Internal\IO\OfficeStableFileRead.cs" />
    <Compile Include="..\OfficeIMO.SharedSource\Compound\*.cs" Link="Internal\Compound\%(Filename)%(Extension)" />
    <Compile Include="..\OfficeIMO.SharedSource\Numerics\*.cs" Link="Internal\Numerics\%(Filename)%(Extension)" />
    <!-- The shared package writer needs spans; netstandard2.0 and net472 writers fall back to ZipArchive. -->
    <Compile Include="..\OfficeIMO.SharedSource\Packaging\*.cs" Link="Internal\Packaging\%(Filename)%(Extension)" Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'" />
    <None Include="..\Assets\OfficeIMO.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>README.md</PackagePath>
    </None>
    <None Include="Licenses\*.txt" Pack="true" PackagePath="Licenses/" />
    <None Include="THIRD-PARTY-NOTICES.md">
      <Pack>True</Pack>
      <PackagePath>THIRD-PARTY-NOTICES.md</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Raster/Avif/OfficeAv1QuantizerMatrices.bin" LogicalName="OfficeIMO.Core.Av1QuantizerMatrices" />
    <EmbeddedResource Include="Typography/Hyphenation/*.patterns" LogicalName="OfficeIMO.Core.Hyphenation.%(Filename)" />
    <None Include="Typography/Hyphenation/manifest.json" Pack="true" PackagePath="Typography/Hyphenation/" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OfficeIMO.Notebook" />
    <InternalsVisibleTo Include="OfficeIMO.Notebook.Html" />
    <InternalsVisibleTo Include="OfficeIMO.Notebook.Import" />
    <InternalsVisibleTo Include="OfficeIMO.Notebook.Markdown" />
  </ItemGroup>
</Project>
