<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Shared zero-dependency document, security, drawing, color, image, and font primitives for OfficeIMO projects.</Description>
    <AssemblyName>OfficeIMO.Core</AssemblyName>
    <AssemblyTitle>OfficeIMO.Core</AssemblyTitle>
    <VersionPrefix>3.2.7</VersionPrefix>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' ">$(TargetFrameworks);net472</TargetFrameworks>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <PackageId>OfficeIMO.Core</PackageId>
    <PackageTags>documents;drawing;color;image;raster;png;jpeg;tiff;webp;font;metadata;lifecycle;officeimo;net472;netstandard2.0;net8.0;net10.0</PackageTags>
    <PackageProjectUrl>https://github.com/EvotecIT/OfficeIMO</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPublishable>True</IsPublishable>
    <Copyright>(c) 2011 - 2024 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
    <PackageIcon>OfficeIMO.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/EvotecIT/OfficeIMO</RepositoryUrl>
    <DebugType>portable</DebugType>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <LangVersion>Latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableTrimmingPolyfills>true</EnableTrimmingPolyfills>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OfficeIMO.Html" />
    <InternalsVisibleTo Include="OfficeIMO.Html.Pdf" />
    <InternalsVisibleTo Include="OfficeIMO.Html.Rtf" />
    <InternalsVisibleTo Include="OfficeIMO.CSV" />
    <InternalsVisibleTo Include="OfficeIMO.Data.Arrow" />
    <InternalsVisibleTo Include="OfficeIMO.Excel" />
    <InternalsVisibleTo Include="OfficeIMO.Excel.Legacy" />
    <InternalsVisibleTo Include="OfficeIMO.PowerPoint" />
    <InternalsVisibleTo Include="OfficeIMO.Pdf" />
    <InternalsVisibleTo Include="OfficeIMO.Rtf" />
    <InternalsVisibleTo Include="OfficeIMO.OpenDocument" />
    <InternalsVisibleTo Include="OfficeIMO.Word" />
    <InternalsVisibleTo Include="OfficeIMO.Word.Legacy" />
    <InternalsVisibleTo Include="OfficeIMO.Visio" />
    <InternalsVisibleTo Include="OfficeIMO.Security" />
    <InternalsVisibleTo Include="OfficeIMO.Security.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Provenance.C2pa" />
    <InternalsVisibleTo Include="OfficeIMO.Word.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Tool" />
    <InternalsVisibleTo Include="OfficeIMO.RealWorldCorpus.Tool" />
    <InternalsVisibleTo Include="OfficeIMO.GoogleWorkspace.Drive" />
    <InternalsVisibleTo Include="OfficeIMO.Opml" />
    <InternalsVisibleTo Include="OfficeIMO.DocBook" />
    <InternalsVisibleTo Include="OfficeIMO.Reader.Opml" />
    <Compile Include="..\OfficeIMO.SharedSource\Compound\*.cs" Link="Internal\Compound\%(Filename)%(Extension)" />
    <None Include="..\Assets\OfficeIMO.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>README.md</PackagePath>
    </None>
    <None Include="THIRD-PARTY-NOTICES.md">
      <Pack>True</Pack>
      <PackagePath>THIRD-PARTY-NOTICES.md</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
