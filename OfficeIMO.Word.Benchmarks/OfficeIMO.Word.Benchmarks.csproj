  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.Word\OfficeIMO.Word.csproj" />
    <ProjectReference Include="..\OfficeIMO.Word.Html\OfficeIMO.Word.Html.csproj" />
  </ItemGroup>
