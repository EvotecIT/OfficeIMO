{
  "name": "@evotecit/officeimo",
  "version": "0.1.0",
  "description": "Dependency-free, streaming tabular XLSX and CSV exports for portable reports.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./JavaScript/index.d.ts", "import": "./Assets/officeimo.mjs" },
    "./xlsx": { "types": "./JavaScript/xlsx.d.ts", "import": "./Assets/officeimo-xlsx.mjs" },
    "./csv": { "types": "./JavaScript/csv.d.ts", "import": "./Assets/officeimo-csv.mjs" },
    "./classic.js": "./Assets/officeimo.js",
    "./xlsx.js": "./Assets/officeimo-xlsx.js",
    "./csv.js": "./Assets/officeimo-csv.js"
  },
  "files": ["Assets/*.js", "Assets/*.mjs", "JavaScript/*.d.ts", "LICENSE"],
  "scripts": {
    "build": "node Build/assets.mjs",
    "check": "node Build/assets.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "prepack": "node Build/assets.mjs --check"
  },
  "repository": { "type": "git", "url": "https://github.com/EvotecIT/OfficeIMO.git", "directory": "OfficeIMO.Browser" },
  "engines": { "node": ">=18" },
  "keywords": ["xlsx", "csv", "excel", "browser", "offline", "streaming"]
}
