<Project>
  <!-- CodeQL builds net10 for multi-targeted projects while single-targeted
       projects keep their own framework identity. A global TargetFramework on
       the solution forks duplicate single-target instances into the same output. -->
  <PropertyGroup Condition="'$(OfficeIMOCodeQLBuild)' == 'true' And '$(TargetFrameworks)' != ''">
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Exercise the legacy library graph from a modern test host without substituting
       modern dependencies for the implementations under test. Normal package targets stay unchanged. -->
  <PropertyGroup Condition="'$(OfficeIMOCompatibilityTarget)' == 'netstandard2.0' And '$(IsTestProject)' != 'true' And '$(OutputType)' != 'Exe' And $([System.String]::Copy('$(MSBuildProjectName)').StartsWith('OfficeIMO')) And $([System.String]::Copy(';$(TargetFrameworks);').Contains(';netstandard2.0;'))">
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Keep modern OfficeIMO library builds under trimming and NativeAOT analysis.
       Tool source checkouts nested by CI retain their own compatibility policy. -->
  <PropertyGroup Condition="('$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0') And '$(IsTestProject)' != 'true' And '$(IsPackable)' != 'false' And '$(OutputType)' == 'Library' And $([System.String]::Copy('$(MSBuildProjectName)').StartsWith('OfficeIMO'))">
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <!-- Keep release libraries and the PDF comparison graph reproducible across
       checkout and external intermediate paths. Tests retain physical
       CallerFilePath values for Verify snapshots; Debug builds retain local
       paths for source breakpoints. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(IsTestProject)' != 'true' And ('$(IsPackable)' != 'false' Or '$(MSBuildProjectName)' == 'OfficeIMO.Pdf.Benchmarks.Comparisons')">
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <PathMap>$([MSBuild]::ValueOrDefault('$(MSBuildThisFileDirectory)', '').Replace(',', ',,').Replace('=', '=='))=/_/</PathMap>
    <!-- One shared prefix keeps publisher command lines bounded across the project graph. -->
    <_OfficeIMOCompilerArtifactsPath Condition="'$(UseArtifactsOutput)' == 'true' And '$(UseArtifactsIntermediateOutput)' == 'true' And '$(ArtifactsPath)' != ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(ArtifactsPath)', 'obj'))</_OfficeIMOCompilerArtifactsPath>
    <PathMap Condition="'$(_OfficeIMOCompilerArtifactsPath)' != ''">$([MSBuild]::ValueOrDefault('$(_OfficeIMOCompilerArtifactsPath)', '').Replace(',', ',,').Replace('=', '=='))=/_/obj/,$(PathMap)</PathMap>
  </PropertyGroup>

  <!-- Production projects inherit TreatWarningsAsErrors=true from Directory.Build.props.
       Tests and benchmarks still show warnings, but warnings do not block local or CI validation. -->
  <PropertyGroup Condition="
      '$(IsTestProject)' == 'true'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Word.Tests'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.CSV.Tests'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.VerifyTests'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.MarkdownRenderer.Wpf.Tests'
      Or $([System.String]::Copy('$(MSBuildProjectName)').Contains('.Benchmarks'))">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Examples are executable documentation; their warnings do not block validation. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OfficeIMO.Examples'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Older target frameworks need the compiler marker for records and init-only properties.
       Compile an internal marker into each assembly instead of exposing one package's shim as public API. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Build/Compatibility/IsExternalInit.cs"
             Link="System.Runtime.CompilerServices/IsExternalInit.cs" />
  </ItemGroup>

  <!-- Validate every newly produced public package across compatible frameworks.
       PackageId is not defaulted yet at this point, so match on the project instead. -->
  <PropertyGroup Condition="
      '$(OutputType)' == 'Library'
      And '$(IsPackable)' != 'false'
      And '$(IsTestProject)' != 'true'
      And !$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Benchmarks'))">
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Compare redesigned document, conversion and PDF surfaces with the published 3.3 baseline.
       Keep reviewed API changes in exact suppression records so additional public API regressions
       fail package validation. -->
  <PropertyGroup Condition="
      '$(MSBuildProjectName)' == 'OfficeIMO.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.ChartForgeX'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Reader.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Word.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Excel.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.PowerPoint.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Rtf.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Html.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Html.Pdf.Browser'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Markdown.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Mhtml.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.OneNote.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.AsciiDoc.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Latex.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.OpenDocument.Odt.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.OpenDocument.Ods.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.OpenDocument.Odp.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Visio.Pdf'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.AsciiDoc'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Latex'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Rtf'">
    <PackageValidationBaselineVersion>3.3.0</PackageValidationBaselineVersion>
    <CompatibilitySuppressionFilePath>$(MSBuildProjectDirectory)/CompatibilitySuppressions.xml</CompatibilitySuppressionFilePath>
  </PropertyGroup>

  <!-- Keep intentional Tier 1 public API changes visible in source control. -->
  <Import Project="$(MSBuildThisFileDirectory)Build/ApiMap/PublicApi.targets" />
</Project>
