<Project>
  <!-- CodeQL builds net10 for multi-targeted projects while single-targeted
       projects keep their own framework identity. A global TargetFramework on
       the solution forks duplicate single-target instances into the same output. -->
  <PropertyGroup Condition="'$(OfficeIMOCodeQLBuild)' == 'true' And '$(TargetFrameworks)' != ''">
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Exercise the legacy library graph from a modern test host without substituting
       modern dependencies for the implementations under test. Normal package targets stay unchanged. -->
  <PropertyGroup Condition="'$(OfficeIMOCompatibilityTarget)' == 'netstandard2.0' And '$(IsTestProject)' != 'true' And '$(OutputType)' != 'Exe' And $([System.String]::Copy('$(MSBuildProjectName)').StartsWith('OfficeIMO')) And $([System.String]::Copy(';$(TargetFrameworks);').Contains(';netstandard2.0;'))">
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Keep modern OfficeIMO library builds under trimming and NativeAOT analysis.
       Tool source checkouts nested by CI retain their own compatibility policy. -->
  <PropertyGroup Condition="('$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0') And '$(IsTestProject)' != 'true' And '$(IsPackable)' != 'false' And '$(OutputType)' == 'Library' And $([System.String]::Copy('$(MSBuildProjectName)').StartsWith('OfficeIMO'))">
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <!-- Keep shipped release binaries reproducible without embedding a maintainer's
       checkout path in portable PDB documents or CodeView content IDs. Limit the
       source mapping to packable production projects: non-packable test projects
       retain physical CallerFilePath values for Verify snapshots, and Debug builds
       retain local paths for source breakpoints. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(IsPackable)' != 'false' And '$(IsTestProject)' != 'true'">
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>

  <!-- Production projects inherit TreatWarningsAsErrors=true from Directory.Build.props.
       Tests and benchmarks still show warnings, but warnings do not block local or CI validation. -->
  <PropertyGroup Condition="
      '$(IsTestProject)' == 'true'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.Word.Tests'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.CSV.Tests'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.VerifyTests'
      Or '$(MSBuildProjectName)' == 'OfficeIMO.MarkdownRenderer.Wpf.Tests'
      Or $([System.String]::Copy('$(MSBuildProjectName)').Contains('.Benchmarks'))">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Examples are executable documentation. Keep nullable enabled so annotated samples do not emit CS8632 noise. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OfficeIMO.Examples'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Older target frameworks need the compiler marker for records and init-only properties.
       Compile an internal marker into each assembly instead of exposing one package's shim as public API. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Build/Compatibility/IsExternalInit.cs"
             Link="System.Runtime.CompilerServices/IsExternalInit.cs" />
  </ItemGroup>

  <!-- Validate every newly produced public package across compatible frameworks. -->
  <PropertyGroup Condition="
      '$(PackageId)' != ''
      And '$(IsPackable)' != 'false'
      And '$(IsTestProject)' != 'true'
      And !$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Benchmarks'))">
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Compare redesigned document, conversion and PDF surfaces with the published 3.3 baseline.
       Keep reviewed API changes in exact suppression records so additional public API regressions
       fail package validation. -->
  <PropertyGroup Condition="
      '$(PackageId)' == 'OfficeIMO.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.ChartForgeX'
      Or '$(PackageId)' == 'OfficeIMO.Reader.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.Word.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.Excel.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.PowerPoint.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.Rtf.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.Html.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.Html.Pdf.Browser'
      Or '$(PackageId)' == 'OfficeIMO.Markdown.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.Mhtml.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.OneNote.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.AsciiDoc.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.Latex.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.OpenDocument.Odt.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.OpenDocument.Ods.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.OpenDocument.Odp.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.Visio.Pdf'
      Or '$(PackageId)' == 'OfficeIMO.AsciiDoc'
      Or '$(PackageId)' == 'OfficeIMO.Latex'
      Or '$(PackageId)' == 'OfficeIMO.Rtf'">
    <PackageValidationBaselineVersion>3.3.0</PackageValidationBaselineVersion>
    <CompatibilitySuppressionFilePath>$(MSBuildProjectDirectory)/CompatibilitySuppressions.xml</CompatibilitySuppressionFilePath>
  </PropertyGroup>

</Project>
