  "probeSource": "using System.Diagnostics;\nusing System.Text.Json;\nusing OfficeIMO.PowerPoint;\n\nvar measurements = new List<object>();\nvoid Run(string mode, int count) {\n    long before = GC.GetAllocatedBytesForCurrentThread();\n    var watch = Stopwatch.StartNew();\n    for (int index = 0; index < count; index++) {\n        using var presentation = PowerPointDocument.Create();\n        if (presentation.Slides.Count != 0) throw new InvalidOperationException(\"Unexpected initial slide.\");\n    }\n    watch.Stop();\n    measurements.Add(new { mode, count, milliseconds = watch.Elapsed.TotalMilliseconds / count, allocatedBytes = (GC.GetAllocatedBytesForCurrentThread() - before) / count });\n}\nRun(\"cold\", 1);\nfor (int i = 0; i < 12; i++) { using var presentation = PowerPointDocument.Create(); }\nfor (int i = 0; i < 3; i++) Run(\"warm\", 100);\nusing (var presentation = PowerPointDocument.Create()) {\n    presentation.AddSlide().AddTitle(\"Creation proof\");\n    using var output = new MemoryStream();\n    presentation.Save(output);\n    using var reopened = PowerPointDocument.Load(output);\n    if (reopened.Slides.Count != 1 || reopened.Slides[0].TextBoxes.First().Text != \"Creation proof\" || reopened.ValidateDocument().Any()) throw new InvalidOperationException(\"Saved presentation contract failed.\");\n}\nConsole.WriteLine(JsonSerializer.Serialize(new { framework = System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription, measurements, validation = \"Passed\" }));\n",
