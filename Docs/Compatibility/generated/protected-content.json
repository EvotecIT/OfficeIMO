{
  "id":"OfficeIMO.ProtectedContent",
  "schemaVersion":1,
  "capabilities":[
    {
      "id":"ooxml-password",
      "formatId":"DOCX/XLSX/PPTX",
      "packageId":"OfficeIMO.Word / OfficeIMO.Excel / OfficeIMO.PowerPoint",
      "kind":"PasswordEncryption",
      "inspect":"Supported",
      "open":"Supported",
      "create":"Supported",
      "validate":"NotApplicable",
      "mutate":"Supported",
      "remove":"Supported",
      "api":"format load/save password APIs",
      "limitation":"Password encryption is format-owned; no OfficeIMO.Security dependency is required."
    },
    {
      "id":"doc-password",
      "formatId":"DOC",
      "packageId":"OfficeIMO.Word",
      "kind":"PasswordEncryption",
      "inspect":"Detected",
      "open":"NotSupported",
      "create":"NotSupported",
      "validate":"NotApplicable",
      "mutate":"Blocked",
      "remove":"NotSupported",
      "api":"WordDocument.Load",
      "limitation":"Legacy DOC encryption is detected only; encrypted content is not exposed."
    },
    {
      "id":"xls-password",
      "formatId":"XLS",
      "packageId":"OfficeIMO.Excel",
      "kind":"PasswordEncryption",
      "inspect":"Supported",
      "open":"Supported",
      "create":"NotSupported",
      "validate":"NotApplicable",
      "mutate":"NotSupported",
      "remove":"NotSupported",
      "api":"ExcelDocument.Load",
      "limitation":"Encrypted legacy XLS read is supported; encrypted legacy authoring is not."
    },
    {
      "id":"ppt-password",
      "formatId":"PPT",
      "packageId":"OfficeIMO.PowerPoint",
      "kind":"PasswordEncryption",
      "inspect":"Supported",
      "open":"Supported",
      "create":"Supported",
      "validate":"NotApplicable",
      "mutate":"Supported",
      "remove":"Supported",
      "api":"PowerPointPresentation.Load / Save",
      "limitation":"Legacy PPT RC4 password protection is format-owned."
    },
    {
      "id":"pdf-password",
      "formatId":"PDF",
      "packageId":"OfficeIMO.Pdf",
      "kind":"PasswordEncryption",
      "inspect":"Supported",
      "open":"Supported",
      "create":"Supported",
      "validate":"NotApplicable",
      "mutate":"Supported",
      "remove":"Supported",
      "api":"PdfDocument.Security",
      "limitation":"Typed PDF security options and operation results report encryption policy."
    },
    {
      "id":"odf-password",
      "formatId":"ODT/ODS/ODP",
      "packageId":"OfficeIMO.OpenDocument",
      "kind":"PasswordEncryption",
      "inspect":"Supported",
      "open":"Supported",
      "create":"Supported",
      "validate":"NotApplicable",
      "mutate":"Supported",
      "remove":"Supported",
      "api":"OdfLoadOptions.Password / OdfSaveOptions.Encryption",
      "limitation":"AES-256-CBC with 10,000-10,000,000 PBKDF2-HMAC-SHA1 iterations, SHA-256 start key, and SHA-256/1K checksum; legacy Blowfish is rejected."
    },
    {
      "id":"epub-font-obfuscation",
      "formatId":"EPUB",
      "packageId":"OfficeIMO.Epub",
      "kind":"FontObfuscation",
      "inspect":"Supported",
      "open":"Supported",
      "create":"NotSupported",
      "validate":"NotApplicable",
      "mutate":"NotApplicable",
      "remove":"NotApplicable",
      "api":"EpubDocument.Load",
      "limitation":"IDPF and Adobe font obfuscation are removed in the read projection only when the package identity yields the required key; EPUB output is not mutated."
    },
    {
      "id":"smime-signature",
      "formatId":"EML / RFC 5322 MIME",
      "packageId":"OfficeIMO.Email + optional provider",
      "kind":"DigitalSignature",
      "inspect":"Supported",
      "open":"Supported",
      "create":"Supported",
      "validate":"Supported",
      "mutate":"Preserved",
      "remove":"NotApplicable",
      "api":"EmailSmime.Sign / Verify",
      "limitation":"Email owns MIME serialization; an explicit IOfficeSecurityProvider owns CMS and certificate policy."
    },
    {
      "id":"smime-signature-msg-tnef",
      "formatId":"MSG/TNEF S/MIME",
      "packageId":"OfficeIMO.Email + optional provider",
      "kind":"DigitalSignature",
      "inspect":"Supported",
      "open":"Supported",
      "create":"NotSupported",
      "validate":"Supported",
      "mutate":"Preserved",
      "remove":"NotApplicable",
      "api":"EmailSmime.Verify",
      "limitation":"Protected MSG/TNEF content can be inspected and verified after parsing; outbound signing creates RFC 5322/MIME bytes, not MSG or TNEF containers."
    },
    {
      "id":"smime-envelope",
      "formatId":"EML / RFC 5322 MIME",
      "packageId":"OfficeIMO.Email + optional provider",
      "kind":"RecipientEncryption",
      "inspect":"Supported",
      "open":"Supported",
      "create":"Supported",
      "validate":"NotApplicable",
      "mutate":"Preserved",
      "remove":"NotApplicable",
      "api":"EmailSmime.Encrypt / Decrypt / SignAndEncrypt",
      "limitation":"Certificate-recipient CMS encryption is provider-backed; protected source pass-through remains available without the provider."
    },
    {
      "id":"smime-envelope-msg-tnef",
      "formatId":"MSG/TNEF S/MIME",
      "packageId":"OfficeIMO.Email + optional provider",
      "kind":"RecipientEncryption",
      "inspect":"Supported",
      "open":"Supported",
      "create":"NotSupported",
      "validate":"NotApplicable",
      "mutate":"Preserved",
      "remove":"NotApplicable",
      "api":"EmailSmime.Decrypt",
      "limitation":"Protected MSG/TNEF content can be inspected and decrypted after parsing; outbound encryption creates RFC 5322/MIME bytes, not MSG or TNEF containers."
    },
    {
      "id":"opc-package-signature",
      "formatId":"DOCX/XLSX/PPTX/Visio",
      "packageId":"format package + optional provider",
      "kind":"DigitalSignature",
      "inspect":"Supported",
      "open":"NotApplicable",
      "create":"Supported",
      "validate":"Supported",
      "mutate":"Blocked",
      "remove":"Supported",
      "api":"InspectPackageSignatures / SignPackageSignature / ValidatePackageSignatures",
      "limitation":"Changed signed packages require explicit invalidation handling."
    },
    {
      "id":"vba-signature",
      "formatId":"DOCM/XLSM/XLSB/PPTM families",
      "packageId":"format package + optional provider",
      "kind":"DigitalSignature",
      "inspect":"Supported",
      "open":"NotApplicable",
      "create":"Supported",
      "validate":"Supported",
      "mutate":"Blocked",
      "remove":"Supported",
      "api":"InspectVbaSignatures / SignVbaProject",
      "limitation":"Managed legacy, agile, and V3 VBA signature profiles are corpus-bound."
    },
    {
      "id":"odf-package-signature",
      "formatId":"ODT/ODS/ODP",
      "packageId":"OfficeIMO.OpenDocument + optional provider",
      "kind":"DigitalSignature",
      "inspect":"Supported",
      "open":"NotApplicable",
      "create":"Supported",
      "validate":"Supported",
      "mutate":"Blocked",
      "remove":"Supported",
      "api":"OdfDocument.SignPackage / ValidatePackageSignatures",
      "limitation":"The bounded OfficeIMO XML manifest profile does not claim every producer-specific ODF signature profile."
    },
    {
      "id":"epub-package-signature",
      "formatId":"EPUB",
      "packageId":"OfficeIMO.Epub + optional provider",
      "kind":"DigitalSignature",
      "inspect":"Supported",
      "open":"NotApplicable",
      "create":"Supported",
      "validate":"Supported",
      "mutate":"Blocked",
      "remove":"Supported",
      "api":"EpubDocument.SignPackage / ValidatePackageSignatures",
      "limitation":"The bounded OfficeIMO XML manifest profile does not claim arbitrary EPUB DRM or signature profiles."
    },
    {
      "id":"onenote-encrypted-revision",
      "formatId":"ONE",
      "packageId":"OfficeIMO.OneNote",
      "kind":"PasswordEncryption",
      "inspect":"Detected",
      "open":"NotSupported",
      "create":"NotSupported",
      "validate":"NotApplicable",
      "mutate":"Blocked",
      "remove":"NotSupported",
      "api":"OneNoteSectionReader.Read",
      "limitation":"An encrypted current revision or dependency fails closed; an older plaintext revision is never substituted."
    },
    {
      "id":"pst-password",
      "formatId":"PST",
      "packageId":"OfficeIMO.Email",
      "kind":"AccessDeterrence",
      "inspect":"Supported",
      "open":"Supported",
      "create":"NotSupported",
      "validate":"NotApplicable",
      "mutate":"Blocked",
      "remove":"NotSupported",
      "api":"EmailStoreSession.IsPstPasswordProtected",
      "limitation":"PST password protection is a checksum-based access deterrent, not cryptographic encryption."
    },
    {
      "id":"rtf-editing-restrictions",
      "formatId":"RTF",
      "packageId":"OfficeIMO.Rtf",
      "kind":"EditingRestriction",
      "inspect":"Supported",
      "open":"NotApplicable",
      "create":"Supported",
      "validate":"NotApplicable",
      "mutate":"Supported",
      "remove":"Supported",
      "api":"RtfDocumentSettings.HasEditingProtection",
      "limitation":"RTF protection flags restrict editing but do not encrypt content."
    }
  ]
}
