<Window xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
        xmlns:shell="using:OfficeIMO.Studio.Features.Shell"
        xmlns:workspace="using:OfficeIMO.Studio.Features.Workspace"
        xmlns:workflow="using:OfficeIMO.Studio.Features.Workflows"
        xmlns:home="using:OfficeIMO.Studio.Features.Home"
        xmlns:settings="using:OfficeIMO.Studio.Features.Settings"
        x:Class="OfficeIMO.Studio.Features.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        x:Name="StudioWindow"
        Title="OfficeIMO Studio"
        Icon="avares://OfficeIMO.Studio/Assets/OfficeIMO.Studio.ico"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="620"
        Background="{DynamicResource StudioWindowBrush}"
        Foreground="{DynamicResource StudioTextBrush}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="42"
        DragDrop.AllowDrop="True">
  <Grid RowDefinitions="42,*" ColumnDefinitions="116,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource StudioPanelBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="170,*,260,Auto" Margin="12,0,138,0">

        <Border Grid.Column="0" Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar" />

        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="22,5,10,0">
          <ListBox x:Name="DocumentTabs" x:DataType="shell:StudioDocumentTabHost"
                   Grid.Column="0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                   IsVisible="{Binding HasTabs}" SelectionMode="Single"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Background" Value="Transparent" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="shell:StudioDocumentTabViewModel">
                <Border MinWidth="150" MaxWidth="250" Height="37" Padding="11,4,5,4"
                        Background="{DynamicResource StudioWindowBrush}"
                        BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1,1,1,0"
                        CornerRadius="7,7,0,0">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding CloseCommand}"
                            Content="×" Padding="4,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Loc Common.Close}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button x:Name="OpenDocumentTabButton" Grid.Column="1" Classes="ghost" x:DataType="shell:StudioDocumentTabHost"
                  Command="{Binding OpenNewTabCommand}" Content="+" FontSize="18" Padding="8,1"
                  AutomationProperties.Name="{loc:Loc MainWindow.OpenAnotherDocument}"
                  AutomationProperties.HelpText="{loc:Loc MainWindow.OpenAnotherDocument}"
                  ToolTip.Tip="{loc:Loc MainWindow.OpenAnotherDocument}" />
        </Grid>

        <Border Grid.Column="2" IsVisible="{Binding ShowPdfDocumentControls}" Width="250" Height="28"
                HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6"
                Background="{DynamicResource StudioPanelMutedBrush}" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1"
                >
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0">
            <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Foreground="{DynamicResource StudioMutedTextBrush}" />
            <TextBox Grid.Column="1" Text="{Binding SearchQuery}" PlaceholderText="{loc:Loc MainWindow.SearchThisDocument}" BorderThickness="0" Background="Transparent" FontSize="11" />
            <Button Grid.Column="2" Classes="ghost" Command="{Binding SearchCommand}" AutomationProperties.Name="{loc:Loc MainWindow.Find}" Content="{loc:Loc MainWindow.Find}" FontSize="10" Padding="5,2" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <Button Classes="tool" IsVisible="{Binding ShowPdfDocumentControls}" Command="{Binding SaveAsCommand}" AutomationProperties.Name="{loc:Loc MainWindow.SaveAs}" Content="{loc:Loc MainWindow.SaveAs}" />
          <Button Classes="tool" Click="OnToggleThemeClick" Width="36" Padding="7"
                  AutomationProperties.Name="{loc:Loc MainWindow.Theme}"
                  AutomationProperties.HelpText="{loc:Loc MainWindow.SwitchLightAndDarkAppearance}"
                  ToolTip.Tip="{loc:Loc MainWindow.SwitchLightAndDarkAppearance}">
            <PathIcon Data="{StaticResource IconTheme}" Width="17" Height="17" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource StudioNavBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,1,0" Padding="6,10">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
        <ToggleButton Grid.Row="0" Classes="nav"
                     IsChecked="{Binding IsHomeMode, Mode=OneWay}" Command="{Binding ShowHomeCommand}"
                     AutomationProperties.Name="{loc:Loc MainWindow.Home}">
          <StackPanel Spacing="3" HorizontalAlignment="Center"><PathIcon Data="{StaticResource IconHome}" Width="18" Height="18" /><TextBlock Text="{loc:Loc MainWindow.Home}" FontSize="9" Width="96" MaxLines="2" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
        </ToggleButton>
        <ToggleButton Grid.Row="1" Classes="nav" IsEnabled="{Binding HasDocument}"
                     IsChecked="{Binding IsPdfWorkspaceMode, Mode=OneWay}" Command="{Binding ShowPdfWorkspaceCommand}"
                     AutomationProperties.Name="{loc:Loc MainWindow.Document}">
          <StackPanel Spacing="3" HorizontalAlignment="Center"><PathIcon Data="{StaticResource IconDocument}" Width="18" Height="18" /><TextBlock Text="{loc:Loc MainWindow.Document}" FontSize="9" Width="96" MaxLines="2" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
        </ToggleButton>
        <ToggleButton Grid.Row="2" Classes="nav"
                     IsChecked="{Binding IsToolsMode, Mode=OneWay}" Command="{Binding ShowToolsCommand}"
                     AutomationProperties.Name="{loc:Loc MainWindow.Tools}">
          <StackPanel Spacing="3" HorizontalAlignment="Center"><PathIcon Data="{StaticResource IconTools}" Width="18" Height="18" /><TextBlock Text="{loc:Loc MainWindow.Tools}" FontSize="9" Width="96" MaxLines="2" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
        </ToggleButton>
        <ToggleButton Grid.Row="3" Classes="nav"
                     IsChecked="{Binding IsOcrMode, Mode=OneWay}" Command="{Binding ShowOcrCommand}"
                     AutomationProperties.Name="{loc:Loc MainWindow.OCR}">
          <StackPanel Spacing="3" HorizontalAlignment="Center"><PathIcon Data="{StaticResource IconOcr}" Width="18" Height="18" /><TextBlock Text="{loc:Loc MainWindow.OCR}" FontSize="9" Width="96" MaxLines="2" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
        </ToggleButton>
        <ToggleButton Grid.Row="4" Classes="nav"
                     IsChecked="{Binding IsJobsMode, Mode=OneWay}" Command="{Binding ShowJobsCommand}"
                     AutomationProperties.Name="{loc:Loc MainWindow.Convert}">
          <StackPanel Spacing="3" HorizontalAlignment="Center"><PathIcon Data="{StaticResource IconJobs}" Width="18" Height="18" /><TextBlock Text="{loc:Loc MainWindow.Convert}" FontSize="9" Width="96" MaxLines="2" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
        </ToggleButton>
        <ToggleButton Grid.Row="6" Classes="nav"
                      IsChecked="{Binding IsSettingsMode, Mode=OneWay}" Command="{Binding ShowSettingsCommand}"
                      AutomationProperties.Name="{loc:Loc Settings.Settings}" ToolTip.Tip="{loc:Loc Settings.Settings}">
          <StackPanel Spacing="3" HorizontalAlignment="Center"><PathIcon Data="{StaticResource IconSettings}" Width="18" Height="18" /><TextBlock Text="{loc:Loc Settings.Settings}" FontSize="9" Width="96" MaxLines="2" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
        </ToggleButton>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0">
        <Border IsVisible="{Binding HasError}" Background="{DynamicResource StudioErrorSoftBrush}"
                BorderBrush="{DynamicResource StudioErrorBrush}" BorderThickness="0,0,0,1" Padding="12,8">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StudioErrorBrush}" TextWrapping="Wrap" /><Button Grid.Column="1" Classes="ghost" Command="{Binding DismissErrorCommand}" AutomationProperties.Name="{loc:Loc MainWindow.Dismiss}" Content="{loc:Loc MainWindow.Dismiss}" /></Grid>
        </Border>
        <Border IsVisible="{Binding HasSecurityWarning}" Background="{DynamicResource StudioWarningSoftBrush}"
                BorderBrush="{DynamicResource StudioWarningBrush}" BorderThickness="0,0,0,1" Padding="12,8">
          <TextBlock Text="{Binding SecurityWarning}" Foreground="{DynamicResource StudioWarningBrush}" TextWrapping="Wrap" />
        </Border>
        <Border IsVisible="{Binding HasOperationStatus}" Background="{DynamicResource StudioAccentSoftBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <TextBlock Text="{Binding OperationStatus}" Foreground="{DynamicResource StudioAccentBrush}" />
            <Button Grid.Column="1" Classes="tool" AutomationProperties.Name="{loc:Loc MainWindow.RestoreRecoveredEdits}" Content="{loc:Loc MainWindow.RestoreRecoveredEdits}" IsVisible="{Binding HasRecovery}" Command="{Binding RestoreRecoveryCommand}" />
            <Button Grid.Column="2" Classes="tool" AutomationProperties.Name="{loc:Loc MainWindow.Discard}" Content="{loc:Loc MainWindow.Discard}" IsVisible="{Binding HasRecovery}" Command="{Binding DiscardRecoveryCommand}" Margin="6,0" />
            <ProgressBar Grid.Column="3" IsVisible="{Binding IsWorkspaceBusy}" Width="100" Minimum="0" Maximum="1" Value="{Binding OperationProgressFraction}" />
            <Button Grid.Column="4" Classes="tool" AutomationProperties.Name="{loc:Loc MainWindow.Cancel}" Content="{loc:Loc MainWindow.Cancel}" IsVisible="{Binding CanCancelOperation}" Command="{Binding CancelOperationCommand}" Margin="8,0,0,0" />
          </Grid>
        </Border>
      </StackPanel>

      <home:HomeView Grid.Row="1" IsVisible="{Binding IsHomeMode}" />
      <home:ToolsView Grid.Row="1" IsVisible="{Binding IsToolsMode}" />
      <workflow:SearchablePdfOcrView Grid.Row="1" IsVisible="{Binding IsOcrMode}" />
      <workspace:DocumentWorkspaceView x:Name="DocumentWorkspace" Grid.Row="1" IsVisible="{Binding IsPdfWorkspaceMode}" />
      <Grid Grid.Row="1" IsVisible="{Binding IsConversionMode}" RowDefinitions="Auto,*">
        <Border Padding="20,16,20,10" Background="{DynamicResource StudioPanelBrush}"><StackPanel Spacing="4"><TextBlock Text="{loc:Loc MainWindow.Convert}" Classes="pageTitle" /><TextBlock Text="{loc:Loc MainWindow.PrepareRunAndInspectConversionJobs}" Classes="muted" /></StackPanel></Border>
        <workflow:ConversionWorkbenchView x:Name="ConversionView" Grid.Row="1" />
      </Grid>
      <workflow:OutputIntakeWorkbenchView Grid.Row="1" IsVisible="{Binding IsOutputMode}" />
      <workflow:DocumentHealthView x:Name="DocumentHealthView" Grid.Row="1" IsVisible="{Binding IsDocumentHealthMode}" />
      <Grid Grid.Row="1" IsVisible="{Binding IsSettingsMode}">
        <settings:SettingsView DataContext="{Binding Settings}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
