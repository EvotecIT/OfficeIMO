<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:OfficeIMO.Studio.Features.Shell"
        xmlns:workspace="using:OfficeIMO.Studio.Features.Workspace"
        xmlns:workflow="using:OfficeIMO.Studio.Features.Workflows"
        xmlns:home="using:OfficeIMO.Studio.Features.Home"
        x:Class="OfficeIMO.Studio.Features.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        x:Name="StudioWindow"
        Title="OfficeIMO Studio"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="620"
        Background="{DynamicResource StudioWindowBrush}"
        Foreground="{DynamicResource StudioTextBrush}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="42"
        DragDrop.AllowDrop="True">
  <Grid RowDefinitions="42,*" ColumnDefinitions="58,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource StudioPanelBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="170,Auto,*,Auto" Margin="12,0,138,0">

        <Border Grid.Column="0" Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar" />

        <Border Grid.Column="1" IsVisible="{Binding HasDocument}" Margin="22,6,0,0" Padding="12,5"
                MinWidth="210" MaxWidth="330" Background="{DynamicResource StudioWindowBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="7,7,0,0">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="{Binding DocumentName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Command="{Binding CloseDocumentCommand}" Content="×" Padding="4,0"
                    />
          </Grid>
        </Border>

        <Border Grid.Column="2" IsVisible="{Binding ShowPdfDocumentControls}" Width="260" Height="28"
                HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6"
                Background="{DynamicResource StudioPanelMutedBrush}" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1"
                >
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0">
            <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Foreground="{DynamicResource StudioMutedTextBrush}" />
            <TextBox Grid.Column="1" Text="{Binding SearchQuery}" PlaceholderText="Search this document" BorderThickness="0" Background="Transparent" FontSize="11" />
            <Button Grid.Column="2" Classes="ghost" Command="{Binding SearchCommand}" Content="Find" FontSize="10" Padding="5,2" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <Button Classes="tool" IsVisible="{Binding ShowPdfDocumentControls}" Command="{Binding SaveAsCommand}" Content="Save as" />
          <Button Classes="tool" Click="OnToggleThemeClick" Content="Theme" ToolTip.Tip="Switch light and dark appearance" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource StudioNavBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,1,0" Padding="6,10">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <ToggleButton Grid.Row="0" Classes="nav"
                     IsChecked="{Binding IsHomeMode, Mode=OneWay}" Command="{Binding ShowHomeCommand}">
          <StackPanel Spacing="3" HorizontalAlignment="Center"><PathIcon Data="{StaticResource IconHome}" Width="18" Height="18" /><TextBlock Text="Home" FontSize="9" /></StackPanel>
        </ToggleButton>
        <ToggleButton Grid.Row="1" Classes="nav"
                     IsChecked="{Binding IsToolsMode, Mode=OneWay}" Command="{Binding ShowToolsCommand}">
          <StackPanel Spacing="3" HorizontalAlignment="Center"><PathIcon Data="{StaticResource IconTools}" Width="18" Height="18" /><TextBlock Text="Tools" FontSize="9" /></StackPanel>
        </ToggleButton>
        <ToggleButton Grid.Row="2" Classes="nav"
                     IsChecked="{Binding IsJobsMode, Mode=OneWay}" Command="{Binding ShowJobsCommand}">
          <StackPanel Spacing="3" HorizontalAlignment="Center"><PathIcon Data="{StaticResource IconJobs}" Width="18" Height="18" /><TextBlock Text="Jobs" FontSize="9" /></StackPanel>
        </ToggleButton>
        <Button Grid.Row="4" Classes="ghost" Click="OnToggleThemeClick" Foreground="{DynamicResource StudioNavTextBrush}" ToolTip.Tip="Switch light and dark appearance">
          <StackPanel Spacing="3" HorizontalAlignment="Center"><PathIcon Data="{StaticResource IconSettings}" Width="18" Height="18" /><TextBlock Text="Theme" FontSize="9" /></StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0">
        <Border IsVisible="{Binding HasError}" Background="{DynamicResource StudioErrorSoftBrush}"
                BorderBrush="{DynamicResource StudioErrorBrush}" BorderThickness="0,0,0,1" Padding="12,8">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StudioErrorBrush}" TextWrapping="Wrap" /><Button Grid.Column="1" Classes="ghost" Command="{Binding DismissErrorCommand}" Content="Dismiss" /></Grid>
        </Border>
        <Border IsVisible="{Binding HasSecurityWarning}" Background="{DynamicResource StudioWarningSoftBrush}"
                BorderBrush="{DynamicResource StudioWarningBrush}" BorderThickness="0,0,0,1" Padding="12,8">
          <TextBlock Text="{Binding SecurityWarning}" Foreground="{DynamicResource StudioWarningBrush}" TextWrapping="Wrap" />
        </Border>
        <Border IsVisible="{Binding HasOperationStatus}" Background="{DynamicResource StudioAccentSoftBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <TextBlock Text="{Binding OperationStatus}" Foreground="{DynamicResource StudioAccentBrush}" />
            <Button Grid.Column="1" Classes="tool" Content="Restore recovered edits" IsVisible="{Binding HasRecovery}" Command="{Binding RestoreRecoveryCommand}" />
            <Button Grid.Column="2" Classes="tool" Content="Discard" IsVisible="{Binding HasRecovery}" Command="{Binding DiscardRecoveryCommand}" Margin="6,0" />
            <ProgressBar Grid.Column="3" IsVisible="{Binding IsWorkspaceBusy}" Width="100" Minimum="0" Maximum="1" Value="{Binding OperationProgressFraction}" />
            <Button Grid.Column="4" Classes="tool" Content="Cancel" IsVisible="{Binding CanCancelOperation}" Command="{Binding CancelOperationCommand}" Margin="8,0,0,0" />
          </Grid>
        </Border>
      </StackPanel>

      <home:HomeView Grid.Row="1" IsVisible="{Binding IsHomeMode}" />
      <home:ToolsView Grid.Row="1" IsVisible="{Binding IsToolsMode}" />
      <workspace:DocumentWorkspaceView x:Name="DocumentWorkspace" Grid.Row="1" IsVisible="{Binding IsPdfWorkspaceMode}" />
      <Grid Grid.Row="1" IsVisible="{Binding IsConversionMode}" RowDefinitions="Auto,*">
        <Border Padding="20,16,20,10" Background="{DynamicResource StudioPanelBrush}"><StackPanel Spacing="4"><TextBlock Text="Jobs" Classes="pageTitle" /><TextBlock Text="Prepare, run, and inspect conversion jobs." Classes="muted" /></StackPanel></Border>
        <workflow:ConversionWorkbenchView x:Name="ConversionView" Grid.Row="1" />
      </Grid>
      <workflow:DocumentHealthView x:Name="DocumentHealthView" Grid.Row="1" IsVisible="{Binding IsDocumentHealthMode}" />
    </Grid>
  </Grid>
</Window>
