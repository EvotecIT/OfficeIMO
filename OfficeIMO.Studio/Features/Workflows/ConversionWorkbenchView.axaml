<UserControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
             xmlns:shell="using:OfficeIMO.Studio.Features.Shell"
             xmlns:workflow="using:OfficeIMO.Studio.Features.Workflows"
             x:Class="OfficeIMO.Studio.Features.Workflows.ConversionWorkbenchView"
             x:DataType="shell:MainWindowViewModel">
  <Grid x:Name="WorkspaceGrid" ColumnDefinitions="270,*,300" RowDefinitions="*,Auto"
        Background="{DynamicResource StudioWindowBrush}">
    <Border Grid.Column="0" Background="{DynamicResource StudioPanelBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" Spacing="12">
          <TextBlock Classes="eyebrow" Text="{loc:Loc ConversionWorkbench.CONVERSIONSETUP}" />
          <TextBlock Classes="sectionTitle" Text="{loc:Loc ConversionWorkbench.ChooseTheResult}" />

          <TextBlock Text="{loc:Loc ConversionWorkbench.Route}" FontWeight="SemiBold" Margin="0,6,0,0" />
          <ComboBox ItemsSource="{Binding ConversionWorkbench.Routes}"
                    SelectedItem="{Binding ConversionWorkbench.SelectedRoute, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="workflow:ConversionRouteChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="muted" Text="{Binding ConversionWorkbench.SelectedRoute.Description}"
                     FontSize="12" TextWrapping="Wrap" />

          <TextBlock Text="{loc:Loc ConversionWorkbench.OutputProfile}" FontWeight="SemiBold" Margin="0,7,0,0" />
          <ComboBox ItemsSource="{Binding ConversionWorkbench.Profiles}"
                    SelectedItem="{Binding ConversionWorkbench.SelectedProfile, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="workflow:WorkflowProfileChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="muted" Text="{Binding ConversionWorkbench.SelectedProfile.Description}"
                     FontSize="12" TextWrapping="Wrap" />

          <TextBlock Text="{loc:Loc ConversionWorkbench.IfAFileExists}" FontWeight="SemiBold" Margin="0,7,0,0" />
          <ComboBox ItemsSource="{Binding ConversionWorkbench.ConflictPolicies}"
                    SelectedItem="{Binding ConversionWorkbench.SelectedConflict, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="workflow:WorkflowConflictChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="muted" Text="{Binding ConversionWorkbench.SelectedConflict.Description}"
                     FontSize="12" TextWrapping="Wrap" />

          <TextBlock Text="{loc:Loc ConversionWorkbench.OutputFolder}" FontWeight="SemiBold" Margin="0,7,0,0" />
          <TextBox Text="{Binding ConversionWorkbench.OutputFolder, Mode=TwoWay}"
                   PlaceholderText="{loc:Loc ConversionWorkbench.UseEachSourceFolder}" />
          <Button Classes="tool" AutomationProperties.Name="{loc:Loc ConversionWorkbench.ChooseFolder}" Content="{loc:Loc ConversionWorkbench.ChooseFolder}"
                  Command="{Binding ConversionWorkbench.ChooseOutputFolderCommand}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="68,*" Margin="18,0">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Classes="sectionTitle" Text="{loc:Loc ConversionWorkbench.ConversionQueue}" />
          <TextBlock Classes="muted" Text="{Binding ConversionWorkbench.QueueSummary}" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
          <Button Classes="primary" AutomationProperties.Name="{loc:Loc ConversionWorkbench.AddFiles}" Content="{loc:Loc ConversionWorkbench.AddFiles}" Command="{Binding ConversionWorkbench.AddFilesCommand}" />
          <Button Classes="tool" AutomationProperties.Name="{loc:Loc ConversionWorkbench.Remove}" Content="{loc:Loc ConversionWorkbench.Remove}" Command="{Binding ConversionWorkbench.RemoveSelectedCommand}" />
          <Button Classes="tool" AutomationProperties.Name="{loc:Loc ConversionWorkbench.Clear}" Content="{loc:Loc ConversionWorkbench.Clear}" Command="{Binding ConversionWorkbench.ClearQueueCommand}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
        <Grid>
          <Border IsVisible="{Binding !ConversionWorkbench.HasJobs}" Padding="36">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360">
              <Border Width="58" Height="58" CornerRadius="16" Background="{DynamicResource StudioAccentSoftBrush}">
                <TextBlock Text="⇄" FontSize="26" Foreground="{DynamicResource StudioAccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{loc:Loc ConversionWorkbench.BuildYourConversionQueue}" FontSize="18" FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Classes="muted" Text="{loc:Loc ConversionWorkbench.AddOneOrMoreMatchingFilesTheSelectedRouteProfile}"
                         TextAlignment="Center" TextWrapping="Wrap" />
              <Button Classes="primary" AutomationProperties.Name="{loc:Loc ConversionWorkbench.AddFiles}" Content="{loc:Loc ConversionWorkbench.AddFiles}" Command="{Binding ConversionWorkbench.AddFilesCommand}" />
            </StackPanel>
          </Border>

          <Grid IsVisible="{Binding ConversionWorkbench.HasJobs}" RowDefinitions="42,*">
            <Grid Background="{DynamicResource StudioPanelMutedBrush}" ColumnDefinitions="2.2*,1.2*,1.25*,1.1*">
              <TextBlock Text="{loc:Loc ConversionWorkbench.FILE}" Classes="eyebrow" Margin="12,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{loc:Loc ConversionWorkbench.Route}" Classes="eyebrow" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{loc:Loc ConversionWorkbench.STATUS}" Classes="eyebrow" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{loc:Loc ConversionWorkbench.PROGRESS}" Classes="eyebrow" VerticalAlignment="Center" />
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding ConversionWorkbench.Jobs}"
                     SelectedItem="{Binding ConversionWorkbench.SelectedJob, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent">
              <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                </ControlTheme>
              </ListBox.ItemContainerTheme>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="workflow:ConversionJobViewModel">
                  <Grid ColumnDefinitions="2.2*,1.2*,1.25*,1.1*" Margin="12,11">
                    <StackPanel>
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      <TextBlock Classes="muted" Text="{Binding InputPath}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding RouteLabel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                    <ProgressBar Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}"
                                 Height="7" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="DetailsPanel" Grid.Column="2" Background="{DynamicResource StudioPanelBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <StackPanel IsVisible="{Binding ConversionWorkbench.HasJobs}" Margin="18" Spacing="11">
          <TextBlock Classes="eyebrow" Text="{loc:Loc ConversionWorkbench.SELECTEDJOB}" />
          <TextBlock Classes="sectionTitle" Text="{loc:Loc ConversionWorkbench.DetailsAndFidelity}" />
          <Border Height="1" Background="{DynamicResource StudioBorderBrush}" />
          <TextBlock Text="{Binding ConversionWorkbench.SelectedJob.Route.Description}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConversionWorkbench.SelectedJob.Fidelity}"
                     Foreground="{DynamicResource StudioAccentBrush}" FontWeight="SemiBold" />
          <TextBlock Text="{loc:Loc ConversionWorkbench.Engine}" Classes="muted" FontSize="12" Margin="0,5,0,0" />
          <TextBlock Text="{Binding ConversionWorkbench.SelectedJob.Engine}" FontFamily="Consolas,Menlo,monospace" />
          <TextBlock Text="{loc:Loc ConversionWorkbench.KnownLimitations}" Classes="muted" FontSize="12" Margin="0,5,0,0" />
          <TextBlock Text="{Binding ConversionWorkbench.SelectedJob.KnownLimitations}" TextWrapping="Wrap" />
          <TextBlock Text="{loc:Loc ConversionWorkbench.Result}" Classes="muted" FontSize="12" Margin="0,5,0,0" />
          <TextBlock Text="{Binding ConversionWorkbench.SelectedJob.Summary}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding ConversionWorkbench.SelectedJob.OutputPath}"
                     FontSize="12" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ConversionWorkbench.SelectedJob.Diagnostics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource StudioAccentSoftBrush}" CornerRadius="7" Padding="9" Margin="0,2">
                  <StackPanel>
                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
          <StackPanel IsVisible="{Binding !ConversionWorkbench.HasJobs}"
                      Margin="22" Spacing="9" VerticalAlignment="Center">
            <Border Width="42" Height="42" CornerRadius="12" HorizontalAlignment="Left"
                    Background="{DynamicResource StudioPanelMutedBrush}">
              <TextBlock Text="{loc:Loc ConversionWorkbench.I}" FontWeight="Bold" Foreground="{DynamicResource StudioMutedTextBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Classes="sectionTitle" Text="{loc:Loc ConversionWorkbench.NoJobSelected}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{loc:Loc ConversionWorkbench.AddFilesToSeeRouteFidelityEngineDetailsDiagnosticsAnd}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource StudioPanelBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Margin="18,10" Spacing="7">
        <TextBlock Text="{Binding ConversionWorkbench.Status}" TextWrapping="Wrap" />
        <WrapPanel HorizontalAlignment="Right">
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding ConversionWorkbench.ProgressFraction}"
                       Width="140" MinWidth="0" Height="7" VerticalAlignment="Center" Margin="0,0,14,0" />
          <Button Classes="primary" AutomationProperties.Name="{loc:Loc ConversionWorkbench.RunPending}" Content="{loc:Loc ConversionWorkbench.RunPending}"
                  Command="{Binding ConversionWorkbench.RunQueueCommand}" Margin="0,0,7,0" />
          <Button Classes="tool" AutomationProperties.Name="{loc:Loc ConversionWorkbench.RetryFailed}" Content="{loc:Loc ConversionWorkbench.RetryFailed}"
                  Command="{Binding ConversionWorkbench.RetryFailedCommand}" Margin="0,0,7,0" />
          <Button Classes="tool" AutomationProperties.Name="{loc:Loc ConversionWorkbench.Cancel}" Content="{loc:Loc ConversionWorkbench.Cancel}" Command="{Binding ConversionWorkbench.CancelCommand}"
                  IsEnabled="{Binding ConversionWorkbench.CanCancel}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
