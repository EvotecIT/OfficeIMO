<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="using:OfficeIMO.Studio.Features.Shell" xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization" xmlns:workflows="using:OfficeIMO.Studio.Features.Workflows"
 x:Class="OfficeIMO.Studio.Features.Workflows.ProvenanceWorkbenchView" x:DataType="shell:MainWindowViewModel">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Classes="pageContent" Spacing="{StaticResource StudioSpaceL}" MaxWidth="1000" HorizontalAlignment="Stretch">
   <TextBlock Classes="pageTitle" Text="{loc:Loc Provenance.Title}" />
   <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Provenance.Description}" />
   <Border Classes="card"><StackPanel Spacing="{StaticResource StudioSpaceS}">
    <TextBlock Text="{loc:Loc Provenance.Source}" FontWeight="SemiBold" />
    <TextBlock IsVisible="{Binding ProvenanceWorkbench.UsesWorkingCopies}" Text="{Binding ProvenanceWorkbench.InputName}" TextWrapping="Wrap" />
    <TextBlock IsVisible="{Binding ProvenanceWorkbench.UsesWorkingCopies}" Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Provenance.WorkingCopyHint}" />
    <TextBox IsVisible="{Binding !ProvenanceWorkbench.UsesWorkingCopies}" Text="{Binding ProvenanceWorkbench.InputPath}" IsEnabled="{Binding !ProvenanceWorkbench.IsBusy}" PlaceholderText="{loc:Loc Provenance.LocalPath}" />
    <WrapPanel><Button IsVisible="{Binding ProvenanceWorkbench.UsesWorkingCopies}" Content="{loc:Loc Provenance.ImportFile}" Command="{Binding ProvenanceWorkbench.ChooseInputCommand}" IsEnabled="{Binding !ProvenanceWorkbench.IsBusy}" Margin="0,0,8,0" />
     <Button IsVisible="{Binding !ProvenanceWorkbench.UsesWorkingCopies}" Content="{loc:Loc Provenance.ChooseFile}" Command="{Binding ProvenanceWorkbench.ChooseInputCommand}" IsEnabled="{Binding !ProvenanceWorkbench.IsBusy}" Margin="0,0,8,0" />
     <Button Classes="accent" Content="{loc:Loc Provenance.Assess}" Command="{Binding ProvenanceWorkbench.AssessCommand}" IsEnabled="{Binding ProvenanceWorkbench.CanAssess}" /></WrapPanel>
   </StackPanel></Border>
   <Expander Header="{loc:Loc Provenance.ProviderTitle}" IsVisible="{Binding ProvenanceWorkbench.CanConfigureProvider}">
    <StackPanel Spacing="{StaticResource StudioSpaceS}" Margin="8" IsEnabled="{Binding !ProvenanceWorkbench.IsBusy}">
     <TextBlock Text="{loc:Loc Provenance.ProviderHint}" TextWrapping="Wrap" Classes="muted" />
     <TextBlock Text="{loc:Loc Provenance.ToolPath}" />
     <TextBox Text="{Binding ProvenanceWorkbench.C2paToolPath}" AutomationProperties.Name="{loc:Loc Provenance.ToolPath}" />
     <TextBlock Text="{loc:Loc Provenance.TrustAnchors}" />
     <TextBox Text="{Binding ProvenanceWorkbench.TrustAnchorsPath}" AutomationProperties.Name="{loc:Loc Provenance.TrustAnchors}" />
     <TextBlock Text="{loc:Loc Provenance.AllowedList}" />
     <TextBox Text="{Binding ProvenanceWorkbench.AllowedListPath}" AutomationProperties.Name="{loc:Loc Provenance.AllowedList}" />
     <Button Content="{loc:Loc Provenance.CheckProvider}" Command="{Binding ProvenanceWorkbench.CheckProviderCommand}" HorizontalAlignment="Left" />
     <TextBlock Text="{Binding ProvenanceWorkbench.ProviderStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
   </Expander>
   <TextBlock Text="{Binding ProvenanceWorkbench.Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   <TextBlock Text="{Binding ProvenanceWorkbench.Checks}" TextWrapping="Wrap" />
   <TextBlock Classes="muted" Text="{Binding ProvenanceWorkbench.Coverage}" TextWrapping="Wrap" />
   <StackPanel Spacing="{StaticResource StudioSpaceM}" IsVisible="{Binding ProvenanceWorkbench.HasCredentials}" AutomationProperties.Name="{loc:Loc Provenance.Credentials}">
    <TextBlock Text="{loc:Loc Provenance.Credentials}" FontWeight="SemiBold" />
    <TextBlock Text="{loc:Loc Provenance.CredentialHint}" Classes="muted" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding ProvenanceWorkbench.Credentials}">
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="workflows:ProvenanceCredentialViewModel">
      <Border Classes="card" Margin="0,0,0,10"><StackPanel Spacing="{StaticResource StudioSpaceS}">
       <TextBlock Text="{Binding Generator}" FontSize="{StaticResource StudioTitleFontSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
       <TextBlock Text="{Binding Asset}" TextWrapping="Wrap" />
       <TextBlock IsVisible="{Binding DeclaresGenerativeAi}" Text="{loc:Loc Provenance.SourceGenerativeAi}" FontWeight="SemiBold" TextWrapping="Wrap" />
       <TextBlock Text="{Binding CertificateSubjectDescription}" TextWrapping="Wrap" />
       <TextBlock Text="{Binding CertificateIssuerDescription}" Classes="muted" TextWrapping="Wrap" />
       <TextBlock Text="{loc:Loc Provenance.Timeline}" FontWeight="SemiBold" Margin="0,6,0,0" />
       <TextBlock Text="{loc:Loc Provenance.TimelineHint}" Classes="muted" TextWrapping="Wrap" />
       <ItemsControl ItemsSource="{Binding Actions}"><ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="workflows:ProvenanceCredentialActionViewModel">
         <Grid ColumnDefinitions="32,*" Margin="0,7">
          <TextBlock Text="{Binding Position}" FontWeight="SemiBold" />
          <StackPanel Grid.Column="1" Spacing="{StaticResource StudioSpaceXS}">
           <TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextWrapping="Wrap" />
           <TextBlock Text="{Binding Software}" TextWrapping="Wrap" />
           <TextBlock Text="{Binding Time}" Classes="muted" TextWrapping="Wrap" />
           <TextBlock Text="{Binding SourceType}" Classes="muted" TextWrapping="Wrap" />
           <TextBlock IsVisible="{Binding HasWatermark}" Text="{loc:Loc Provenance.WatermarkHint}" TextWrapping="Wrap" />
          </StackPanel>
         </Grid>
        </DataTemplate>
       </ItemsControl.ItemTemplate></ItemsControl>
       <ItemsControl ItemsSource="{Binding IngredientDescriptions}"><ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" /></DataTemplate>
       </ItemsControl.ItemTemplate></ItemsControl>
       <Expander Header="{loc:Loc Provenance.RecordDetails}"><StackPanel Spacing="{StaticResource StudioSpaceSM}" Margin="8">
        <TextBlock Text="{Binding ManifestCountDescription}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Label}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Location}" Classes="muted" TextWrapping="Wrap" />
       </StackPanel></Expander>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
   <Border Classes="card"><StackPanel Spacing="{StaticResource StudioSpaceS}">
    <TextBlock Text="{loc:Loc Provenance.Findings}" FontWeight="SemiBold" />
    <ItemsControl ItemsSource="{Binding ProvenanceWorkbench.Findings}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel Spacing="{StaticResource StudioSpaceXXS}" IsVisible="{Binding ProvenanceWorkbench.InputHash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
     <TextBlock Text="{loc:Loc Provenance.InputHash}" Classes="muted" FontSize="{StaticResource StudioSecondaryFontSize}" />
     <SelectableTextBlock Text="{Binding ProvenanceWorkbench.InputHash}" FontFamily="{StaticResource StudioMonoFont}" FontSize="{StaticResource StudioSecondaryFontSize}" TextWrapping="Wrap" />
    </StackPanel>
   </StackPanel></Border>
   <Border Classes="card"><StackPanel Spacing="{StaticResource StudioSpaceS}" IsEnabled="{Binding !ProvenanceWorkbench.IsBusy}">
    <TextBlock Text="{loc:Loc Provenance.CopyTitle}" FontWeight="SemiBold" />
    <TextBlock Text="{loc:Loc Provenance.CopyDescription}" TextWrapping="Wrap" Classes="muted" />
    <CheckBox Content="{loc:Loc Provenance.Manifests}" IsChecked="{Binding ProvenanceWorkbench.RemoveManifests}" />
    <CheckBox Content="{loc:Loc Provenance.References}" IsChecked="{Binding ProvenanceWorkbench.RemoveReferences}" />
    <CheckBox Content="{loc:Loc Provenance.Declarations}" IsChecked="{Binding ProvenanceWorkbench.RemoveDeclarations}" />
    <TextBox IsVisible="{Binding !ProvenanceWorkbench.UsesWorkingCopies}" Text="{Binding ProvenanceWorkbench.OutputFolder}" PlaceholderText="{loc:Loc Provenance.OutputFolder}" />
    <WrapPanel><Button IsVisible="{Binding !ProvenanceWorkbench.UsesWorkingCopies}" Content="{loc:Loc Provenance.ChooseFolder}" Command="{Binding ProvenanceWorkbench.ChooseFolderCommand}" Margin="0,0,8,8" />
     <Button Content="{loc:Loc Provenance.CreateCopy}" Command="{Binding ProvenanceWorkbench.CreateCopyCommand}" IsEnabled="{Binding ProvenanceWorkbench.CanCreateCopy}" Margin="0,0,8,8" />
     <Button Content="{loc:Loc Provenance.Export}" Command="{Binding ProvenanceWorkbench.ExportReportCommand}" IsEnabled="{Binding ProvenanceWorkbench.CanExportReport}" Margin="0,0,8,8" /></WrapPanel>
   </StackPanel></Border>
   <Button Content="{loc:Loc Provenance.Cancel}" Command="{Binding ProvenanceWorkbench.CancelCommand}" IsVisible="{Binding ProvenanceWorkbench.IsBusy}" HorizontalAlignment="Left" />
   <!-- Results appear once a copy or report exists; labels stay beside their values. -->
   <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource StudioSpaceM}" RowSpacing="{StaticResource StudioSpaceXS}">
    <TextBlock Text="{loc:Loc Provenance.CopyLabel}" Classes="muted" IsVisible="{Binding ProvenanceWorkbench.OutputHash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <SelectableTextBlock Grid.Column="1" IsVisible="{Binding ProvenanceWorkbench.OutputHash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap"
                         Text="{Binding ProvenanceWorkbench.CopyDisplay}" />
    <TextBlock Grid.Row="1" Text="{loc:Loc Provenance.OutputHash}" Classes="muted" IsVisible="{Binding ProvenanceWorkbench.OutputHash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProvenanceWorkbench.OutputHash}" FontFamily="{StaticResource StudioMonoFont}" TextWrapping="Wrap"
                         IsVisible="{Binding ProvenanceWorkbench.OutputHash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Grid.Row="2" Text="{loc:Loc Provenance.ReportLabel}" Classes="muted" IsVisible="{Binding ProvenanceWorkbench.ReportPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProvenanceWorkbench.ReportDisplay}" TextWrapping="Wrap"
                         IsVisible="{Binding ProvenanceWorkbench.ReportPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
   </Grid>
   <ItemsControl ItemsSource="{Binding ProvenanceWorkbench.Changes}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <ItemsControl ItemsSource="{Binding ProvenanceWorkbench.Diagnostics}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Classes="muted" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
 </ScrollViewer>
</UserControl>
