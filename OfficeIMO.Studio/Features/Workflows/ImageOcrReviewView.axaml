<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
             xmlns:workflow="using:OfficeIMO.Studio.Features.Workflows"
             x:Class="OfficeIMO.Studio.Features.Workflows.ImageOcrReviewView" x:DataType="workflow:ImageOcrReviewViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource StudioSpaceM}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource StudioSpaceM}">
      <StackPanel Spacing="{StaticResource StudioSpaceXS}">
        <TextBlock Text="{Binding SourceName}" Classes="sectionTitle" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Loc ImageOcr.ReviewHint}" TextWrapping="Wrap" />
      </StackPanel>
      <ComboBox Grid.Column="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}" Width="140"
                AutomationProperties.Name="{loc:Loc ImageOcr.FrameChoice}">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="workflow:OcrReviewPageChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding Details}" Classes="muted" TextWrapping="Wrap" />
    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource StudioSpaceL}">
      <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource StudioSpaceS}">
        <TextBlock Text="{loc:Loc ImageOcr.ReviewText}" FontWeight="SemiBold" />
        <TextBox Grid.Row="1" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000000"
                 VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{loc:Loc ImageOcr.ReviewText}" />
      </Grid>
      <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="{StaticResource StudioSpaceS}">
        <CheckBox Content="{loc:Loc ImageOcr.ActualPixels}" IsChecked="{Binding IsZoomed}" />
      <Border Grid.Row="1" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1" Background="White">
        <Grid><Image Source="{Binding Preview}" Stretch="Uniform" IsVisible="{Binding !IsZoomed}" />
          <ScrollViewer IsVisible="{Binding IsZoomed}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image Source="{Binding Preview}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
          </ScrollViewer>
          <TextBlock Text="{Binding PreviewError}" TextWrapping="Wrap" Margin="12" Foreground="{DynamicResource StudioErrorBrush}" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Bottom" />
        </Grid>
      </Border>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="3" Spacing="{StaticResource StudioSpaceS}">
      <TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" MaxHeight="60" />
      <WrapPanel>
        <Button Classes="primary" Content="{loc:Loc ImageOcr.SaveText}" Command="{Binding CommitCommand}" Margin="0,0,12,0" />
        <Button Classes="tool" Content="{loc:Loc SearchablePdfOcr.Cancel}" Command="{Binding CancelCommand}" />
      </WrapPanel>
    </StackPanel>
  </Grid>
</UserControl>
