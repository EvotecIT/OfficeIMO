<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
             xmlns:workflow="using:OfficeIMO.Studio.Features.Workflows" xmlns:coreworkflow="clr-namespace:OfficeIMO.Workflows;assembly=OfficeIMO.Workflows"
             x:Class="OfficeIMO.Studio.Features.Workflows.StudioJobsView"
             x:DataType="workflow:StudioJobsViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Classes="pageContent" MaxWidth="1180">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource StudioSpaceM}" Margin="0,0,0,12">
      <StackPanel Classes="pageHeading">
        <TextBlock Classes="pageTitle" Text="{loc:Loc Jobs.Title}" />
        <TextBlock Classes="muted" Text="{Binding History.Summary}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{loc:Loc Jobs.SessionNote}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding History.RecoveryError}" IsVisible="{Binding History.RecoveryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Foreground="{DynamicResource StudioErrorBrush}" />
        <TextBlock Text="{Binding History.RunHistoryError}" IsVisible="{Binding History.RunHistoryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Foreground="{DynamicResource StudioErrorBrush}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="tool" Content="{loc:Loc Jobs.ClearFinished}" IsVisible="{Binding History.HasEntries}"
              Command="{Binding ClearFinishedCommand}" VerticalAlignment="Top" />
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding ActionError}" IsVisible="{Binding ActionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Foreground="{DynamicResource StudioErrorBrush}" Margin="0,0,0,8" />
    <Grid Grid.Row="2">
      <StackPanel IsVisible="{Binding !History.HasEntries}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource StudioSpaceM}" MaxWidth="420">
        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource StudioAccentSoftBrush}" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource IconJobs}" Width="28" Height="28" Foreground="{DynamicResource StudioAccentBrush}" />
        </Border>
        <TextBlock Text="{loc:Loc Jobs.EmptyTitle}" FontSize="{StaticResource StudioTitleFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Loc Jobs.Empty}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
        <!-- An empty list points to the work that fills it. -->
        <StackPanel x:Name="EmptyActions" Orientation="Horizontal" Spacing="{StaticResource StudioSpaceS}" HorizontalAlignment="Center" Margin="0,4,0,0">
          <Button Classes="primary" Content="{loc:Loc Commands.Convert.Title}" Command="{ReflectionBinding $parent[Window].DataContext.ShowConversionWorkbenchCommand}" />
          <Button Classes="tool" Content="{loc:Loc Commands.Ocr.Title}" Command="{ReflectionBinding $parent[Window].DataContext.ShowOcrCommand}" />
        </StackPanel>
      </StackPanel>
      <ListBox ItemsSource="{Binding History.Entries}" SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
               IsVisible="{Binding History.HasEntries}" Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
          </ControlTheme>
        </ListBox.ItemContainerTheme>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="workflow:StudioJobRecord">
            <Border Classes="card" Padding="16" Margin="0,0,0,12">
              <StackPanel Spacing="{StaticResource StudioSpaceS}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource StudioSpaceM}">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding StartedLabel}" Classes="muted" />
                </Grid>
                <TextBlock Text="{Binding InputLabel}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Classes="muted" ToolTip.Tip="{Binding InputLabel}" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding FinishedLabel}" IsVisible="{Binding FinishedLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RecordingError}" IsVisible="{Binding RecordingError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Foreground="{DynamicResource StudioErrorBrush}" />
                <TextBlock Text="{Binding OutputAvailabilityNote}" IsVisible="{Binding OutputAvailabilityNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Foreground="{DynamicResource StudioWarningBrush}" />
                <StackPanel IsVisible="{Binding HasRecovery}" Spacing="{StaticResource StudioSpaceS}">
                  <TextBlock Text="{loc:Loc Jobs.RecoveryNote}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Recovery.Name}" TextWrapping="Wrap" />
                  <ComboBox ItemsSource="{Binding Recoveries}" SelectedItem="{Binding Recovery, Mode=TwoWay}"
                            IsVisible="{Binding HasMultipleRecoveries}" AutomationProperties.Name="{loc:Loc Jobs.RecoveryCopies}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="coreworkflow:OfficeWorkflowOutputRecovery"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding Destination}" TextTrimming="CharacterEllipsis" />
                  <WrapPanel>
                    <Button Classes="tool" Content="{loc:Loc Jobs.OpenRecovery}" Margin="0,0,8,8"
                            Command="{ReflectionBinding $parent[UserControl].DataContext.OpenRecoveryCommand}" CommandParameter="{Binding}" />
                    <Button Classes="tool" Content="{loc:Loc Jobs.DiscardRecovery}" IsVisible="{Binding !RecoveryDiscardRequested}" Margin="0,0,0,8"
                            Command="{ReflectionBinding $parent[UserControl].DataContext.RequestDiscardRecoveryCommand}" CommandParameter="{Binding}" />
                  </WrapPanel>
                  <StackPanel IsVisible="{Binding RecoveryDiscardRequested}" Spacing="{StaticResource StudioSpaceS}">
                    <TextBlock Text="{loc:Loc Jobs.DiscardRecoveryNote}" TextWrapping="Wrap" />
                    <WrapPanel>
                      <Button Classes="tool" Content="{loc:Loc Jobs.ConfirmDiscardRecovery}" Margin="0,0,8,8"
                              Command="{ReflectionBinding $parent[UserControl].DataContext.ConfirmDiscardRecoveryCommand}" CommandParameter="{Binding}" />
                      <Button Classes="tool" Content="{loc:Loc Jobs.KeepRecovery}" Margin="0,0,0,8"
                              Command="{ReflectionBinding $parent[UserControl].DataContext.CancelDiscardRecoveryCommand}" CommandParameter="{Binding}" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource StudioSpaceSM}" IsVisible="{Binding HasOutput}" ToolTip.Tip="{Binding OutputPath}">
                  <PathIcon Data="{StaticResource IconDocument}" Width="12" Height="12" Foreground="{DynamicResource StudioMutedTextBrush}" />
                  <TextBlock Text="{Binding OutputName}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource StudioSpaceS}">
                  <StackPanel Spacing="{StaticResource StudioSpaceSM}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="outcome" Classes.success="{Binding IsSucceeded}" Classes.notes="{Binding HasNotes}" Classes.failed="{Binding IsFailed}" Classes.cancelled="{Binding IsCancelled}" Classes.attention="{Binding NeedsChecking}" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" MinWidth="0"
                                 Classes.success="{Binding IsSucceeded}" Classes.notes="{Binding HasNotes}" Classes.failed="{Binding IsFailed}" Classes.cancelled="{Binding IsCancelled}" Classes.attention="{Binding NeedsChecking}" />
                  </StackPanel>
                  <WrapPanel>
                    <Button Classes="tool" IsVisible="{Binding CanCancel}" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Margin="0,0,8,8" />
                    <Button Classes="tool" IsVisible="{Binding CanReviewJob}" Content="{loc:Loc Jobs.RunReport.Review}" Margin="0,0,8,8"
                            Command="{ReflectionBinding $parent[UserControl].DataContext.ReviewJobCommand}" CommandParameter="{Binding}" />
                    <Panel IsVisible="{ReflectionBinding $parent[UserControl].DataContext.SupportsFolderNavigation}">
                      <Button Classes="tool" IsVisible="{Binding HasOutput}" Content="{loc:Loc Jobs.ShowInFolder}" Margin="0,0,8,8"
                              Command="{ReflectionBinding $parent[UserControl].DataContext.RevealOutputCommand}" CommandParameter="{Binding}" />
                    </Panel>
                    <Button Classes="primary" IsVisible="{Binding CanOpenOutput}" Content="{loc:Loc Jobs.OpenOutput}" Margin="0,0,0,8"
                            Command="{ReflectionBinding $parent[UserControl].DataContext.OpenOutputCommand}" CommandParameter="{Binding}" />
                  </WrapPanel>
                </StackPanel>
                <Expander x:Name="RunReportDetails" Header="{loc:Loc Jobs.RunReport.Details}" IsVisible="{Binding HasRunReport}" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="{StaticResource StudioSpaceS}">
                    <TextBlock Text="{Binding ReportNote}" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReportSample}" IsVisible="{Binding ReportSample, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="muted" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding ReportItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="workflow:StudioConversionRunItem">
                            <Border BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                              <StackPanel Spacing="{StaticResource StudioSpaceXS}">
                                <TextBlock Text="{Binding InputName}" ToolTip.Tip="{Binding InputPath}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Status}" Classes="outcome" Classes.failed="{Binding IsFailed}" />
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                <Button Classes="tool" IsVisible="{Binding HasOutput}" Content="{loc:Loc Jobs.OpenOutput}" HorizontalAlignment="Left"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.OpenReportOutputCommand}" CommandParameter="{Binding}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
