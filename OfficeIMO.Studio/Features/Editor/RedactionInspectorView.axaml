<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
             xmlns:shell="using:OfficeIMO.Studio.Features.Shell"
             xmlns:editor="using:OfficeIMO.Studio.Features.Editor"
             x:Class="OfficeIMO.Studio.Features.Editor.RedactionInspectorView"
             x:DataType="shell:MainWindowViewModel">
  <StackPanel Spacing="8">
    <TextBlock Text="{loc:Loc DocumentWorkspace.PermanentRedaction}" FontSize="15" FontWeight="SemiBold" />
    <TextBlock Classes="muted" Text="{loc:Loc DocumentWorkspace.DrawARedactionAreaReviewMatchedContentAndApplyOnly}" TextWrapping="Wrap" />
    <Button Classes="tool" Content="{loc:Loc DocumentWorkspace.UseRedactionTool}" Command="{Binding Commands[Redact]}" IsEnabled="{Binding CanRedact}" />
    <StackPanel IsVisible="{Binding !CanRedact}" Spacing="5">
      <TextBlock Classes="muted" Text="{loc:Loc Redaction.BlockedPreparation}" TextWrapping="Wrap" />
      <Button Classes="tool" Content="{loc:Loc Redaction.OpenSanitization}" Command="{Binding ShowSanitizeCommand}" />
    </StackPanel>
    <Expander Header="{loc:Loc Redaction.FindMarks}" IsExpanded="{Binding RedactionSearchExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch">
      <StackPanel Spacing="5">
        <TextBox Text="{Binding RedactionSearchText}" PlaceholderText="{loc:Loc Redaction.SearchText}" AutomationProperties.Name="{loc:Loc Redaction.SearchText}" />
        <CheckBox Content="{loc:Loc Redaction.Regex}" IsChecked="{Binding RedactionSearchRegex}" />
        <CheckBox Content="{loc:Loc Redaction.MatchCase}" IsChecked="{Binding RedactionSearchMatchCase}" />
        <CheckBox Content="{loc:Loc Redaction.SelectedPagesOnly}" IsChecked="{Binding RedactionSearchSelectedPagesOnly}" />
        <TextBlock Classes="muted" Text="{loc:Loc Redaction.SearchScope}" TextWrapping="Wrap" />
        <Button Classes="tool" Content="{loc:Loc Redaction.FindMarks}" Command="{Binding SearchRedactionsCommand}" IsEnabled="{Binding CanRedact}" />
      </StackPanel>
    </Expander>
    <ListBox ItemsSource="{Binding RedactionMarks}" SelectedItem="{Binding SelectedRedactionMark}" MaxHeight="170" AutomationProperties.Name="{loc:Loc Redaction.Marks}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="editor:PdfRedactionMarkViewModel">
          <StackPanel Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <CheckBox IsChecked="{Binding IsIncluded}" Content="{loc:Loc Redaction.Include}" />
              <TextBlock Text="{Binding PageNumber}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="245" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel IsVisible="{Binding HasPendingRedaction}" Spacing="5">
      <TextBox Text="{Binding SelectedRedactionMark.Reason}" PlaceholderText="{loc:Loc Redaction.Reason}" AutomationProperties.Name="{loc:Loc Redaction.Reason}" />
      <Button Classes="tool" Content="{loc:Loc Redaction.RemoveMark}" Command="{Binding RemoveRedactionMarkCommand}" />
      <CheckBox Content="{loc:Loc Redaction.Sanitize}" IsChecked="{Binding SanitizeAfterRedaction}" />
      <TextBlock IsVisible="{Binding SanitizeAfterRedaction}" Classes="muted" Text="{loc:Loc Redaction.SanitizeScope}" TextWrapping="Wrap" />
      <Border Background="{DynamicResource StudioErrorSoftBrush}" BorderBrush="{DynamicResource StudioErrorBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
        <StackPanel Spacing="7">
          <TextBlock Text="{Binding PendingRedactionSummary}" TextWrapping="Wrap" />
          <Button Classes="tool" Content="{loc:Loc Redaction.ReviewImpact}" Command="{Binding ReviewRedactionsCommand}" IsEnabled="{Binding CanReviewRedactions}" />
          <Button Classes="primary" AutomationProperties.Name="{loc:Loc DocumentWorkspace.ApplyAndVerify}" Content="{loc:Loc DocumentWorkspace.ApplyAndVerify}" Command="{Binding ApplyPendingRedactionCommand}" IsEnabled="{Binding CanApplyReviewedRedactions}" />
          <Expander Header="{loc:Loc Redaction.AdditionalCheck}" HorizontalAlignment="Stretch">
            <TextBox Text="{Binding RedactionRemovedMarker}" PlaceholderText="{loc:Loc DocumentWorkspace.TextThatMustBeAbsent}" />
          </Expander>
          <Button Classes="tool" Content="{loc:Loc DocumentWorkspace.Cancel}" Command="{Binding CancelPendingRedactionCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel IsVisible="{Binding HasRedactionEvidence}" Spacing="5">
      <TextBlock Classes="muted" Text="{loc:Loc Redaction.EvidencePrivacy}" TextWrapping="Wrap" />
      <Button Classes="primary" Content="{loc:Loc Redaction.SaveCopy}" Command="{Binding SaveVerifiedRedactionCopyCommand}" />
      <Button Classes="tool" Content="{loc:Loc Redaction.ExportReport}" Command="{Binding ExportRedactionEvidenceCommand}" IsEnabled="{Binding CanExportRedactionEvidence}" />
    </StackPanel>
  </StackPanel>
</UserControl>
