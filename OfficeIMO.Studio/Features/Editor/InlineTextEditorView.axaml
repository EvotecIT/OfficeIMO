<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="using:OfficeIMO.Studio.Features.Editor"
             xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
             x:Class="OfficeIMO.Studio.Features.Editor.InlineTextEditorView"
             x:DataType="editor:PdfTextDraftViewModel">
  <Border Background="{DynamicResource StudioPanelBrush}" BorderBrush="{DynamicResource StudioAccentBrush}" BorderThickness="2" CornerRadius="5" Padding="6">
    <StackPanel Spacing="5">
      <TextBox x:Name="ReplacementText" Text="{Binding Text}" AcceptsReturn="True" MinHeight="44" MaxHeight="90" TextWrapping="Wrap"
               AutomationProperties.Name="{loc:Loc TextEdit.InlineText}" />
      <StackPanel Orientation="Horizontal" Spacing="5">
        <Button Content="{loc:Loc TextEdit.Preview}" Command="{Binding PreviewCommand}" IsEnabled="{Binding IsReady}" />
        <Button Content="{loc:Loc DocumentWorkspace.Cancel}" Command="{Binding CancelCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
