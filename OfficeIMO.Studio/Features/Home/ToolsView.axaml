<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
             xmlns:infra="using:OfficeIMO.Studio.Infrastructure"
             xmlns:shell="using:OfficeIMO.Studio.Features.Shell"
             x:Class="OfficeIMO.Studio.Features.Home.ToolsView"
             x:DataType="shell:MainWindowViewModel">
  <ScrollViewer Background="{DynamicResource StudioWindowBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,24" Spacing="18" MaxWidth="1080" HorizontalAlignment="Stretch">
      <TextBlock Text="{loc:Loc Tools.Tools}" Classes="pageTitle" />
      <TextBlock Text="{loc:Loc Tools.Introduction}" Classes="muted" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBox Text="{Binding Commands.ToolQuery, Mode=TwoWay}" PlaceholderText="{loc:Loc Commands.SearchTools}"
                 AutomationProperties.Name="{loc:Loc Commands.SearchTools}" MinHeight="36" />
        <Button Grid.Column="1" Classes="primary" Command="{Binding Commands[Open]}" Content="{loc:Loc Commands.Open.Title}" />
      </Grid>
      <TextBlock Text="{loc:Loc Commands.NoResults}" IsVisible="{Binding !Commands.HasTools}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Commands.FilteredTools}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><infra:AdaptiveCardPanel MinimumCardWidth="270" ColumnSpacing="12" RowSpacing="12" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:StudioCommandItem">
            <Button Classes="cardAction" Command="{Binding}" Padding="20" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                    AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Category}" Classes="eyebrow" />
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UnavailableReason}" IsVisible="{Binding HasUnavailableReason}"
                           Foreground="{DynamicResource StudioWarningBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
