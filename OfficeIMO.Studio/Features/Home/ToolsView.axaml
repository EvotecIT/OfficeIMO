<UserControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
             xmlns:shell="using:OfficeIMO.Studio.Features.Shell"
             x:Class="OfficeIMO.Studio.Features.Home.ToolsView"
             x:DataType="shell:MainWindowViewModel">
  <ScrollViewer Background="{DynamicResource StudioPanelBrush}" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24" Spacing="22" MaxWidth="1080" HorizontalAlignment="Stretch">
      <StackPanel Spacing="5"><TextBlock Text="{loc:Loc Tools.Tools}" Classes="pageTitle" /><TextBlock Classes="muted" Text="{loc:Loc Tools.ChooseAFocusedTaskAdvancedWorkOpensInAGuided}" /></StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Text="{loc:Loc Tools.Organize}" Classes="sectionTitle" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
          <Button Grid.Column="0" Classes="cardAction" Command="{Binding ShowAssemblyCommand}" AutomationProperties.Name="{loc:Loc Tools.AssemblePDF}" AutomationProperties.HelpText="{loc:Loc Tools.CombinePDFsImagesOfficeFilesFoldersAndZIPs}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconMerge}" Width="22" Height="22" Foreground="{DynamicResource StudioSuccessBrush}" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.AssemblePDF}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.CombinePDFsImagesOfficeFilesFoldersAndZIPs}" /></StackPanel></Grid></Button>
          <Button Grid.Column="1" Classes="cardAction" Command="{Binding ShowPageToolsCommand}" AutomationProperties.Name="{loc:Loc Tools.SplitPDF}" AutomationProperties.HelpText="{loc:Loc Tools.ExtractRangesIntoVerifiedFiles}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconSplit}" Width="22" Height="22" Foreground="{DynamicResource StudioAccentBrush}" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.SplitPDF}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.ExtractRangesIntoVerifiedFiles}" /></StackPanel></Grid></Button>
          <Button Grid.Column="2" Classes="cardAction" Command="{Binding ShowPageToolsCommand}" AutomationProperties.Name="{loc:Loc Tools.OrganizePages}" AutomationProperties.HelpText="{loc:Loc Tools.RotateCropDuplicateAndMove}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconTools}" Width="22" Height="22" Foreground="#7047EB" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.OrganizePages}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.RotateCropDuplicateAndMove}" /></StackPanel></Grid></Button>
        </Grid>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Text="{loc:Loc Tools.ConvertAndRecognize}" Classes="sectionTitle" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
          <Button Grid.Column="0" Classes="cardAction" Command="{Binding ShowConversionWorkbenchCommand}" AutomationProperties.Name="{loc:Loc Tools.ConvertFiles}" AutomationProperties.HelpText="{loc:Loc Tools.OfficeWebMarkupPDFAndImages}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconConvert}" Width="22" Height="22" Foreground="#7047EB" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.ConvertFiles}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.OfficeWebMarkupPDFAndImages}" /></StackPanel></Grid></Button>
          <Button Grid.Column="1" Classes="cardAction" Command="{Binding ShowOcrCommand}" AutomationProperties.Name="{loc:Loc Tools.MakePDFSearchable}" AutomationProperties.HelpText="{loc:Loc Tools.RecognizeScannedPagesAndAddASearchableTextLayer}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconOcr}" Width="22" Height="22" Foreground="{DynamicResource StudioAccentBrush}" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.MakePDFSearchable}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.RecognizeScannedPagesAndAddASearchableTextLayer}" /></StackPanel></Grid></Button>
          <Button Grid.Column="2" Classes="cardAction" Command="{Binding ShowPageExportCommand}" AutomationProperties.Name="{loc:Loc Tools.ExportPages}" AutomationProperties.HelpText="{loc:Loc Tools.CreateValidatedPNGJPEGWebPTIFFOrSVGFiles}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconExport}" Width="22" Height="22" Foreground="#7047EB" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.ExportPages}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.CreateValidatedPNGJPEGWebPTIFFOrSVGFiles}" /></StackPanel></Grid></Button>
        </Grid>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Text="{loc:Loc Tools.OptimizeAndOutput}" Classes="sectionTitle" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
          <Button Grid.Column="0" Classes="cardAction" Command="{Binding ShowOptimizeCommand}" AutomationProperties.Name="{loc:Loc Tools.CompressPDF}" AutomationProperties.HelpText="{loc:Loc Tools.OptimizeDeterministicallyAndValidate}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconCompress}" Width="22" Height="22" Foreground="{DynamicResource StudioErrorBrush}" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.CompressPDF}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.OptimizeDeterministicallyAndValidate}" /></StackPanel></Grid></Button>
          <Button Grid.Column="1" Classes="cardAction" Command="{Binding ShowDocumentHealthCommand}" AutomationProperties.Name="{loc:Loc Tools.RepairPDF}" AutomationProperties.HelpText="{loc:Loc Tools.RecoverExplicitlyReopenAndReport}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconSettings}" Width="22" Height="22" Foreground="{DynamicResource StudioWarningBrush}" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.RepairPDF}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.RecoverExplicitlyReopenAndReport}" /></StackPanel></Grid></Button>
          <Button Grid.Column="2" Classes="cardAction" Command="{Binding ShowPrintPreviewCommand}" AutomationProperties.Name="{loc:Loc Tools.PrintPreview}" AutomationProperties.HelpText="{loc:Loc Tools.PlanPaperScalingAndMultiPageSheets}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconPrint}" Width="22" Height="22" Foreground="#2587A0" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.PrintPreview}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.PlanPaperScalingAndMultiPageSheets}" /></StackPanel></Grid></Button>
        </Grid>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Text="{loc:Loc Tools.ReviewAndProtect}" Classes="sectionTitle" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
          <Button Grid.Column="0" Classes="cardAction" Command="{Binding ShowCompareCommand}" AutomationProperties.Name="{loc:Loc Tools.ComparePDFs}" AutomationProperties.HelpText="{loc:Loc Tools.StructureAndManagedVisualComparison}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconCompare}" Width="22" Height="22" Foreground="#2587A0" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.ComparePDFs}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.StructureAndManagedVisualComparison}" /></StackPanel></Grid></Button>
          <Button Grid.Column="1" Classes="cardAction" Command="{Binding ShowProtectCommand}" AutomationProperties.Name="{loc:Loc Tools.ProtectAndRedact}" AutomationProperties.HelpText="{loc:Loc Tools.ReviewIrreversibleChangesBeforeSave}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconProtect}" Width="22" Height="22" Foreground="{DynamicResource StudioWarningBrush}" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.ProtectAndRedact}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.ReviewIrreversibleChangesBeforeSave}" /></StackPanel></Grid></Button>
          <Button Grid.Column="2" Classes="cardAction" Command="{Binding ShowInspectCommand}" AutomationProperties.Name="{loc:Loc Tools.InspectPDF}" AutomationProperties.HelpText="{loc:Loc Tools.SecuritySignaturesTagsAndDiagnostics}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconSearch}" Width="22" Height="22" Foreground="{DynamicResource StudioSuccessBrush}" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.InspectPDF}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.SecuritySignaturesTagsAndDiagnostics}" /></StackPanel></Grid></Button>
        </Grid>
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
          <Button Grid.Column="0" Classes="cardAction" Command="{Binding ShowRepairPlanCommand}" AutomationProperties.Name="{loc:Loc Tools.PlanRepair}" AutomationProperties.HelpText="{loc:Loc Tools.AssessRecoveriesAndBlockersWithoutWriting}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconSettings}" Width="22" Height="22" Foreground="{DynamicResource StudioWarningBrush}" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.PlanRepair}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.AssessRecoveriesAndBlockersWithoutWriting}" /></StackPanel></Grid></Button>
          <Button Grid.Column="1" Classes="cardAction" Command="{Binding ShowSanitizeCommand}" AutomationProperties.Name="{loc:Loc Tools.SanitizePDF}" AutomationProperties.HelpText="{loc:Loc Tools.RemoveForbiddenActionsAndPayloadsThenVerify}"><Grid ColumnDefinitions="40,*" ColumnSpacing="10"><PathIcon Data="{StaticResource IconProtect}" Width="22" Height="22" Foreground="{DynamicResource StudioErrorBrush}" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc Tools.SanitizePDF}" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="{loc:Loc Tools.RemoveForbiddenActionsAndPayloadsThenVerify}" /></StackPanel></Grid></Button>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
