<UserControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
             xmlns:infra="using:OfficeIMO.Studio.Infrastructure"
             xmlns:shell="using:OfficeIMO.Studio.Features.Shell"
             xmlns:home="using:OfficeIMO.Studio.Features.Home"
             x:Class="OfficeIMO.Studio.Features.Home.HomeView"
             x:DataType="shell:MainWindowViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Background="{DynamicResource StudioPanelBrush}">
    <Grid Margin="28,24,28,30" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="22"
          MaxWidth="1160" HorizontalAlignment="Stretch">
      <StackPanel Grid.Row="0" Spacing="16">
        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.Home}" Classes="pageTitle" />
        <shell:StudioSessionView DataContext="{Binding Session}" />
      </StackPanel>

      <Border Grid.Row="1" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1"
              CornerRadius="8" Padding="24" Background="{DynamicResource StudioPanelMutedBrush}">
        <StackPanel HorizontalAlignment="Center" Spacing="10">
          <PathIcon Data="{StaticResource IconOpen}" Width="34" Height="34"
                    Foreground="{DynamicResource StudioMutedTextBrush}" />
          <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.DragAndDropFilesHere}" FontSize="14" HorizontalAlignment="Center" />
          <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding Commands[Open]}" IsEnabled="{Binding CanStartDocumentTransition}"
                  AutomationProperties.Name="{loc:Loc Home.OpenFile}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconOpen}" Width="16" Height="16" />
              <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.OpenFile}" />
            </StackPanel>
          </Button>
          <TextBlock Text="{loc:Loc Home.SupportedInputGuidance}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="2" Spacing="10">
        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.QuickTasks}" FontSize="15" FontWeight="SemiBold" />
        <infra:AdaptiveCardPanel MinimumCardWidth="140" ColumnSpacing="12" RowSpacing="12">
          <Button Classes="cardAction" Command="{Binding Commands[Assemble]}" AutomationProperties.Name="{loc:Loc Home.Merge}">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconMerge}" Width="22" Height="22" Foreground="{DynamicResource StudioSuccessBrush}" />
              <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.Merge}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Classes="cardAction" Command="{Binding Commands[Pages]}" AutomationProperties.Name="{loc:Loc Home.Split}">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconSplit}" Width="22" Height="22" Foreground="{DynamicResource StudioAccentBrush}" />
              <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.Split}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Classes="cardAction" Command="{Binding Commands[Convert]}" AutomationProperties.Name="{loc:Loc Home.Convert}">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconConvert}" Width="22" Height="22" Foreground="{DynamicResource StudioAccentBrush}" />
              <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.Convert}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Classes="cardAction" Command="{Binding Commands[Ocr]}" AutomationProperties.Name="{loc:Loc Home.OCR}">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconOcr}" Width="22" Height="22" Foreground="{DynamicResource StudioAccentBrush}" />
              <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.OCR}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Classes="cardAction" Command="{Binding Commands[Optimize]}" AutomationProperties.Name="{loc:Loc Home.Compress}">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconCompress}" Width="22" Height="22" Foreground="{DynamicResource StudioErrorBrush}" />
              <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.Compress}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Classes="cardAction" Command="{Binding Commands[Protect]}" AutomationProperties.Name="{loc:Loc Home.Protect}">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconProtect}" Width="22" Height="22" Foreground="{DynamicResource StudioWarningBrush}" />
              <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.Protect}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </infra:AdaptiveCardPanel>
      </StackPanel>

      <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.Recent}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Command="{Binding ClearRecentDocumentsCommand}"
                  IsVisible="{Binding HasRecentDocuments}" AutomationProperties.Name="{loc:Loc Home.ClearList}" Content="{loc:Loc Home.ClearList}"
                  Foreground="{DynamicResource StudioAccentBrush}" />
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1"
                CornerRadius="8" Background="{DynamicResource StudioPanelBrush}">
          <Grid>
            <StackPanel IsVisible="{Binding !HasRecentDocuments}" Margin="24" Spacing="5" HorizontalAlignment="Center">
              <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.NoRecentDocuments}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock TextWrapping="Wrap" Classes="muted" Text="{loc:Loc Home.DocumentsYouOpenWillAppearHere}" HorizontalAlignment="Center" />
            </StackPanel>
            <ItemsControl IsVisible="{Binding HasRecentDocuments}" ItemsSource="{Binding RecentDocuments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="home:RecentDocumentViewModel">
                  <Button Background="Transparent" BorderThickness="0" Padding="14,10"
                          HorizontalContentAlignment="Stretch"
                          AutomationProperties.Name="{Binding FileName}"
                          Command="{ReflectionBinding $parent[UserControl].DataContext.OpenRecentCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                      <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource StudioErrorSoftBrush}">
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Home.PDF}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource StudioErrorBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock TextWrapping="Wrap" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding DirectoryName}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                        <TextBlock TextWrapping="Wrap" Text="{Binding OpenedLabel}" HorizontalAlignment="Right" FontSize="12" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding FileSizeLabel}" Classes="muted" HorizontalAlignment="Right" FontSize="12" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
