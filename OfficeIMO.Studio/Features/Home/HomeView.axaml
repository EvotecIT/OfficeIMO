<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
             xmlns:infra="using:OfficeIMO.Studio.Infrastructure"
             xmlns:shell="using:OfficeIMO.Studio.Features.Shell"
             xmlns:home="using:OfficeIMO.Studio.Features.Home"
             x:Class="OfficeIMO.Studio.Features.Home.HomeView"
             x:DataType="shell:MainWindowViewModel">
  <UserControl.Styles>
    <Style Selector="Button.task">
      <Setter Property="Background" Value="{DynamicResource StudioPanelRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioSubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.task:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StudioAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
    </Style>
    <Style Selector="Button.task:disabled"><Setter Property="Opacity" Value="0.6" /></Style>
    <Style Selector="Button.task:disabled /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource StudioPanelRaisedBrush}" /></Style>
    <Style Selector="Border.taskGlyph">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.recent">
      <Setter Property="Background" Value="{DynamicResource StudioPanelRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioSubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.recent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StudioPanelRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
    </Style>
    <Style Selector="Button.recent:pointerover Border.previewImage">
      <Setter Property="RenderTransform" Value="translateY(-3px)" />
    </Style>
    <Style Selector="Border.previewImage">
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" /></Transitions>
      </Setter>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Background="{DynamicResource StudioPanelBrush}">
    <StackPanel Margin="36,28,36,36" Spacing="22" MaxWidth="1180" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Loc Home.Welcome}" Classes="pageTitle" />
        <TextBlock Text="{loc:Loc Home.WelcomeDescription}" Classes="muted" />
      </StackPanel>

      <shell:StudioSessionView DataContext="{Binding Session}" />

      <Grid x:Name="HeroGrid" ColumnDefinitions="1.15*,*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="18">
        <!-- Drop target: the primary way in. -->
        <Panel x:Name="DropTarget" MinHeight="250">
          <Border CornerRadius="16" Background="{DynamicResource StudioAccentSoftBrush}" Opacity="0.55" />
          <Rectangle RadiusX="16" RadiusY="16" Stroke="{DynamicResource StudioAccentBrush}" StrokeThickness="1.5"
                     StrokeDashArray="5,4" Opacity="0.7" IsHitTestVisible="False" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24" MaxWidth="440">
            <Border Width="60" Height="60" CornerRadius="16" Background="{DynamicResource StudioPanelRaisedBrush}" HorizontalAlignment="Center"
                    BoxShadow="{DynamicResource StudioCardShadow}">
              <PathIcon Data="{StaticResource IconOpen}" Width="28" Height="28" Foreground="{DynamicResource StudioAccentBrush}" />
            </Border>
            <TextBlock Text="{loc:Loc Home.DragAndDropFilesHere}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Loc Home.SupportedInputGuidance}" Classes="muted" TextAlignment="Center" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
              <Button Classes="primary" Command="{Binding Commands[Open]}" IsEnabled="{Binding CanStartDocumentTransition}"
                      AutomationProperties.Name="{loc:Loc Home.OpenFile}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconOpen}" Width="15" Height="15" />
                  <TextBlock Text="{loc:Loc Home.OpenFile}" />
                </StackPanel>
              </Button>
              <Border Classes="kbd"><TextBlock x:Name="OpenShortcut" Text="Ctrl O" /></Border>
            </StackPanel>
          </StackPanel>
        </Panel>

        <!-- Quick tasks: compact, icon-led, grouped by what people come to do. -->
        <StackPanel x:Name="QuickTasks" Grid.Column="1" Spacing="10">
          <TextBlock Text="{loc:Loc Home.QuickTasks}" Classes="groupLabel" />
          <infra:AdaptiveCardPanel MinimumCardWidth="190" ColumnSpacing="10" RowSpacing="10">
            <Button Classes="task" Command="{Binding Commands[Assemble]}" AutomationProperties.Name="{loc:Loc Home.Merge}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="taskGlyph" Background="{DynamicResource StudioAccentSoftBrush}"><PathIcon Data="{StaticResource IconMerge}" Width="16" Height="16" Foreground="{DynamicResource StudioAccentBrush}" /></Border>
                <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="{loc:Loc Home.Merge}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc Home.MergeHint}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
              </Grid>
            </Button>
            <Button Classes="task" Command="{Binding Commands[Convert]}" AutomationProperties.Name="{loc:Loc Home.Convert}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="taskGlyph" Background="{DynamicResource StudioSpineSoftBrush}"><PathIcon Data="{StaticResource IconConvert}" Width="16" Height="16" Foreground="{DynamicResource StudioSpineBrush}" /></Border>
                <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="{loc:Loc Home.Convert}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc Home.ConvertHint}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
              </Grid>
            </Button>
            <Button Classes="task" Command="{Binding Commands[Ocr]}" AutomationProperties.Name="{loc:Loc Home.OCR}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="taskGlyph" Background="{DynamicResource StudioWarningSoftBrush}"><PathIcon Data="{StaticResource IconOcr}" Width="16" Height="16" Foreground="{DynamicResource StudioWarningBrush}" /></Border>
                <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="{loc:Loc Home.OCR}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc Home.OcrHint}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
              </Grid>
            </Button>
            <Button Classes="task" Command="{Binding Commands[Optimize]}" AutomationProperties.Name="{loc:Loc Home.Compress}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="taskGlyph" Background="{DynamicResource StudioSuccessSoftBrush}"><PathIcon Data="{StaticResource IconCompress}" Width="16" Height="16" Foreground="{DynamicResource StudioSuccessBrush}" /></Border>
                <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="{loc:Loc Home.Compress}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc Home.CompressHint}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
              </Grid>
            </Button>
            <Button Classes="task" Command="{Binding Commands[Protect]}" AutomationProperties.Name="{loc:Loc Home.Protect}" ToolTip.Tip="{Binding Commands[Protect].UnavailableReason}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="taskGlyph" Background="{DynamicResource StudioErrorSoftBrush}"><PathIcon Data="{StaticResource IconProtect}" Width="16" Height="16" Foreground="{DynamicResource StudioErrorBrush}" /></Border>
                <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="{loc:Loc Home.Protect}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc Home.ProtectHint}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
              </Grid>
            </Button>
            <Button Classes="task" Command="{Binding Commands[Tools]}" AutomationProperties.Name="{loc:Loc MainWindow.Tools}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="taskGlyph" Background="{DynamicResource StudioPanelMutedBrush}"><PathIcon Data="{StaticResource IconTools}" Width="16" Height="16" Foreground="{DynamicResource StudioTextBrush}" /></Border>
                <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="{loc:Loc Home.AllTools}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc Home.AllToolsHint}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
              </Grid>
            </Button>
          </infra:AdaptiveCardPanel>
        </StackPanel>
      </Grid>

      <!-- Recent documents as recognizable cards. -->
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{loc:Loc Home.Recent}" Classes="sectionTitle" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="link" Command="{Binding ClearRecentDocumentsCommand}"
                  IsVisible="{Binding HasRecentDocuments}" AutomationProperties.Name="{loc:Loc Home.ClearList}" Content="{loc:Loc Home.ClearList}" />
        </Grid>
        <Border IsVisible="{Binding !HasRecentDocuments}" CornerRadius="12" Padding="24" Background="{DynamicResource StudioPanelMutedBrush}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="{loc:Loc Home.NoRecentDocuments}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{loc:Loc Home.DocumentsYouOpenWillAppearHere}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <ItemsControl x:Name="RecentList" IsVisible="{Binding HasRecentDocuments}" ItemsSource="{Binding RecentDocuments}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><infra:AdaptiveCardPanel MinimumCardWidth="190" MaximumCardWidth="300" ColumnSpacing="14" RowSpacing="14" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="home:RecentDocumentViewModel">
              <Button Classes="recent"
                      AutomationProperties.Name="{Binding FileName}" ToolTip.Tip="{Binding Path}"
                      Command="{ReflectionBinding $parent[UserControl].DataContext.OpenRecentCommand}"
                      CommandParameter="{Binding}">
                <Grid RowDefinitions="132,Auto">
                  <Border Background="{DynamicResource StudioCanvasBrush}" ClipToBounds="True">
                    <Panel>
                      <Border Classes="previewImage" IsVisible="{Binding HasThumbnail}" Background="White" Width="108" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                              Margin="0,16,0,-12" CornerRadius="3,3,0,0" BoxShadow="{DynamicResource StudioPageShadow}" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" VerticalAlignment="Top" />
                      </Border>
                      <Border IsVisible="{Binding !HasThumbnail}" Width="58" Height="72" CornerRadius="4" Background="{DynamicResource StudioPanelRaisedBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="{DynamicResource StudioCardShadow}">
                        <TextBlock Text="PDF" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource StudioErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Panel>
                  </Border>
                  <StackPanel Grid.Row="1" Margin="12,10,12,12" Spacing="2">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DirectoryName}" Classes="caption" TextTrimming="PathSegmentEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                      <Border CornerRadius="3" Padding="4,0" Background="{DynamicResource StudioErrorSoftBrush}">
                        <TextBlock Text="{loc:Loc Home.PDF}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StudioErrorBrush}" />
                      </Border>
                      <TextBlock Text="{Binding OpenedLabel}" Classes="caption" />
                      <TextBlock Text="·" Classes="caption" />
                      <TextBlock Text="{Binding PageCountLabel}" Classes="caption" IsVisible="{Binding PageCountLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding FileSizeLabel}" Classes="caption" IsVisible="{Binding PageCountLabel, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
