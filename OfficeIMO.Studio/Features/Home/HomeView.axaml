<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:OfficeIMO.Studio.Features.Shell"
             xmlns:home="using:OfficeIMO.Studio.Features.Home"
             x:Class="OfficeIMO.Studio.Features.Home.HomeView"
             x:DataType="shell:MainWindowViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Background="{DynamicResource StudioPanelBrush}">
    <Grid Margin="28,24,28,30" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="22"
          MaxWidth="1160" HorizontalAlignment="Stretch">
      <TextBlock Grid.Row="0" Text="Home" Classes="pageTitle" />

      <Border Grid.Row="1" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1"
              CornerRadius="8" Padding="24" Background="{DynamicResource StudioPanelMutedBrush}">
        <StackPanel HorizontalAlignment="Center" Spacing="10">
          <PathIcon Data="{StaticResource IconOpen}" Width="34" Height="34"
                    Foreground="{DynamicResource StudioMutedTextBrush}" />
          <TextBlock Text="Drag and drop files here" FontSize="14" HorizontalAlignment="Center" />
          <Button Classes="primary" Command="{Binding OpenCommand}" IsEnabled="{Binding CanStartDocumentTransition}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconOpen}" Width="16" Height="16" />
              <TextBlock Text="Open file" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="2" Spacing="10">
        <TextBlock Text="Quick tasks" FontSize="15" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8">
          <Button Grid.Column="0" Classes="cardAction" Command="{Binding ShowAssemblyCommand}">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconMerge}" Width="22" Height="22" Foreground="{DynamicResource StudioSuccessBrush}" />
              <TextBlock Text="Merge" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="cardAction" Command="{Binding ShowPageToolsCommand}">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconSplit}" Width="22" Height="22" Foreground="{DynamicResource StudioAccentBrush}" />
              <TextBlock Text="Split" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="cardAction" Command="{Binding ShowConversionWorkbenchCommand}">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconConvert}" Width="22" Height="22" Foreground="#7047EB" />
              <TextBlock Text="Convert" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Classes="cardAction" Command="{Binding ShowOcrCommand}">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconOcr}" Width="22" Height="22" Foreground="{DynamicResource StudioAccentBrush}" />
              <TextBlock Text="OCR" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Grid.Column="4" Classes="cardAction" Command="{Binding ShowOptimizeCommand}">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconCompress}" Width="22" Height="22" Foreground="{DynamicResource StudioErrorBrush}" />
              <TextBlock Text="Compress" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Grid.Column="5" Classes="cardAction" Command="{Binding ShowProtectCommand}">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconProtect}" Width="22" Height="22" Foreground="{DynamicResource StudioWarningBrush}" />
              <TextBlock Text="Protect" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>

      <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Recent" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Command="{Binding ClearRecentDocumentsCommand}"
                  IsVisible="{Binding HasRecentDocuments}" Content="Clear list"
                  Foreground="{DynamicResource StudioAccentBrush}" />
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1"
                CornerRadius="8" Background="{DynamicResource StudioPanelBrush}">
          <Grid>
            <StackPanel IsVisible="{Binding !HasRecentDocuments}" Margin="24" Spacing="5" HorizontalAlignment="Center">
              <TextBlock Text="No recent documents" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" Text="Documents you open will appear here." HorizontalAlignment="Center" />
            </StackPanel>
            <ItemsControl IsVisible="{Binding HasRecentDocuments}" ItemsSource="{Binding RecentDocuments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="home:RecentDocumentViewModel">
                  <Button Background="Transparent" BorderThickness="0" Padding="14,10"
                          HorizontalContentAlignment="Stretch"
                          Command="{ReflectionBinding $parent[UserControl].DataContext.OpenRecentCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                      <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource StudioErrorSoftBrush}">
                        <TextBlock Text="PDF" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource StudioErrorBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DirectoryName}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                        <TextBlock Text="{Binding OpenedLabel}" HorizontalAlignment="Right" FontSize="11" />
                        <TextBlock Text="{Binding FileSizeLabel}" Classes="muted" HorizontalAlignment="Right" FontSize="11" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
