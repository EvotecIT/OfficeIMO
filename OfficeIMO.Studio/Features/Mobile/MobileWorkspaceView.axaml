<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:OfficeIMO.Studio.Features.Shell" xmlns:reader="using:OfficeIMO.Studio.Features.Reader"
             xmlns:organizer="using:OfficeIMO.Studio.Features.Organizer"
             xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
             x:Class="OfficeIMO.Studio.Features.Mobile.MobileWorkspaceView" x:DataType="shell:MainWindowViewModel"
             FontFamily="Helvetica Neue" Foreground="{DynamicResource StudioTextBrush}">
  <UserControl.Styles><StyleInclude Source="MobileWorkspaceStyles.axaml"/></UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource StudioPanelMutedBrush}">
    <Border x:Name="HeaderBar" Padding="12,6" Background="{DynamicResource StudioPanelBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button x:Name="PagesButton" Classes="touch" Click="OnPagesClick" IsEnabled="{Binding HasDocument}" AutomationProperties.Name="Pages" ToolTip.Tip="Show pages">
            <PathIcon Data="M3,3 21,3 21,21 3,21ZM5,5 5,19 9,19 9,5ZM11,5 11,19 19,19 19,5Z"/>
          </Button>
          <Button x:Name="OpenButton" Classes="touch" Command="{Binding OpenCommand}" AutomationProperties.Name="Open PDF from Files" ToolTip.Tip="Open a PDF in a new tab"><PathIcon Data="{StaticResource IconOpen}"/></Button>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="4,0">
          <TextBlock Text="{Binding DocumentName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="DocumentSubtitle" IsVisible="{Binding HasDocument}" FontSize="11" Foreground="{DynamicResource StudioMutedTextBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <StackPanel x:Name="WideTools" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasDocument}">
            <Border Classes="toolGroup"><StackPanel Orientation="Horizontal"><Button Classes="touch neutral" Command="{Binding UndoCommand}" AutomationProperties.Name="Undo" ToolTip.Tip="Undo"><PathIcon Data="{StaticResource IconUndo}"/></Button><Button Classes="touch neutral" Command="{Binding RedoCommand}" AutomationProperties.Name="Redo" ToolTip.Tip="Redo"><PathIcon Data="{StaticResource IconRedo}"/></Button></StackPanel></Border>
            <Border Classes="toolbarDivider"/>
            <Button x:Name="SearchButton" Classes="touch" Click="OnSearchClick" AutomationProperties.Name="Search" ToolTip.Tip="Find in document"><PathIcon Data="{StaticResource IconSearch}"/></Button>
            <Button x:Name="NoteButton" Classes="touch" Click="OnNoteClick" IsEnabled="{Binding CanEditAnnotations}" AutomationProperties.Name="Note" ToolTip.Tip="Add a note"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconNote}"/><TextBlock Text="Note" VerticalAlignment="Center"/></StackPanel></Button>
          </StackPanel>
          <Button x:Name="SaveButton" Classes="touch" Command="{Binding SaveCommand}" IsVisible="{Binding HasDocument}" AutomationProperties.Name="{loc:Loc Common.Save}" ToolTip.Tip="Save the working copy on this device">
            <PathIcon Data="{StaticResource IconSave}"/>
          </Button>
          <Button x:Name="ShareButton" Classes="touch" Click="OnShareClick" IsVisible="False" IsEnabled="{Binding HasDocument}" AutomationProperties.Name="Share" ToolTip.Tip="Save and share a copy">
            <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="M11,3 6,8 4.6,6.6 12,0 19.4,6.6 18,8 13,3 13,16 11,16ZM4,10 7,10 7,12 5,12 5,22 19,22 19,12 17,12 17,10 21,10 21,24 3,24 3,10Z"/><TextBlock x:Name="ShareLabel" Text="Share" VerticalAlignment="Center"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="TabBar" Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="12,6,12,0" IsVisible="False">
      <TabControl x:Name="MobileTabs" x:DataType="shell:StudioDocumentTabHost" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" SelectionChanged="OnTabSelectionChanged" KeyDown="OnTabsKeyDown">
        <TabControl.ItemTemplate><DataTemplate x:DataType="shell:StudioDocumentTabViewModel">
          <Border Classes="mobileTab"><Grid ColumnDefinitions="Auto,*,Auto" MinWidth="180" MaxWidth="260" Height="44" Margin="12,0,0,0">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource StudioAccentBrush}" IsVisible="{Binding IsDirty}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Classes="tabName" Text="{Binding DisplayTitle}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Classes="touch neutral" Click="OnCloseTabClick" AutomationProperties.Name="{Binding CloseLabel}"><PathIcon Data="{StaticResource IconClose}" Width="11" Height="11"/></Button>
          </Grid></Border>
        </DataTemplate></TabControl.ItemTemplate>
      </TabControl>
      <Button x:Name="DocumentsButton" Grid.Column="1" Classes="touch" Click="OnDocumentsClick" AutomationProperties.Name="Open documents" ToolTip.Tip="Open documents"><PathIcon Data="{StaticResource IconChevronDown}"/></Button>
      <Button Grid.Column="2" Classes="touch" Command="{Binding OpenCommand}" AutomationProperties.Name="Open another PDF" ToolTip.Tip="Open another PDF"><PathIcon Data="{StaticResource IconPlus}"/></Button>
    </Grid>
    <Border x:Name="SearchPanel" Grid.Row="2" IsVisible="False" Background="{DynamicResource StudioPanelBrush}" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="4">
        <TextBox x:Name="MobileSearchBox" Text="{Binding SearchQuery, Mode=TwoWay}" PlaceholderText="Find in document" AutomationProperties.Name="Find in document" KeyDown="OnSearchKeyDown"/>
        <Button Grid.Column="1" Classes="touch" Command="{Binding PreviousSearchResultCommand}" AutomationProperties.Name="Previous match"><PathIcon Data="{StaticResource IconChevronLeft}"/></Button>
        <Button Grid.Column="2" Classes="touch" Command="{Binding NextSearchResultCommand}" AutomationProperties.Name="Next match"><PathIcon Data="{StaticResource IconChevronRight}"/></Button>
        <Button Grid.Column="3" Classes="touch neutral" Click="OnCloseSearchClick" AutomationProperties.Name="Close search"><PathIcon Data="{StaticResource IconClose}"/></Button>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding SearchPosition}" FontSize="12" Foreground="{DynamicResource StudioMutedTextBrush}" Margin="6,6,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button Grid.Row="1" Grid.Column="3" Classes="touch" Content="Find" Command="{Binding SearchCommand}"/>
      </Grid>
    </Border>
    <Grid Grid.Row="3" x:Name="WorkspaceGrid" ColumnDefinitions="0,*">
      <Border x:Name="PageSidebar" IsVisible="False" Background="{DynamicResource StudioPanelMutedBrush}" BorderBrush="{DynamicResource StudioSubtleBorderBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="22,20,18,10"><TextBlock Text="Pages" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Pages.Count}" Foreground="{DynamicResource StudioMutedTextBrush}" VerticalAlignment="Center"/></Grid>
          <ContentControl x:Name="SidebarPages" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource StudioCanvasBrush}">
        <ScrollViewer x:Name="PageScroll" Focusable="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ContentControl Content="{Binding SelectedPage}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
            <ContentControl.ContentTemplate><DataTemplate x:DataType="reader:PdfPageViewModel"><reader:PdfPageView/></DataTemplate></ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
      </Border>
      <StackPanel Grid.Column="1" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="360" Margin="28">
        <Border Background="{DynamicResource StudioAccentSoftBrush}" CornerRadius="20" Width="72" Height="72" HorizontalAlignment="Left"><PathIcon Data="{StaticResource IconDocument}" Width="32" Height="32" Foreground="{DynamicResource StudioAccentBrush}"/></Border>
        <TextBlock Text="A little room&#10;to think." FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="42"/>
        <TextBlock Text="Read, review, and keep your documents together. Start with a PDF from Files." FontSize="16" LineHeight="24" Foreground="{DynamicResource StudioMutedTextBrush}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="touch filled" Content="Open a PDF" Command="{Binding OpenCommand}"/><Button x:Name="SampleButton" Classes="touch" Content="Try a sample" Click="OnSampleClick" IsVisible="False"/></StackPanel>
      </StackPanel>
    </Grid>
    <Border x:Name="FooterBar" Grid.Row="4" Background="{DynamicResource StudioPanelBrush}" BorderBrush="{DynamicResource StudioSubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="12,2">
      <StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="{DynamicResource StudioErrorBrush}" MaxHeight="72" Margin="8"/>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsWorkspaceBusy}" Height="2"/>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsOpening}" Height="2"/>
        <Grid x:Name="CompactTools" ColumnDefinitions="*,*,*,*,*" IsEnabled="{Binding HasDocument}" IsVisible="False" Margin="0,4">
          <Button Classes="touch" Click="OnSearchClick" HorizontalAlignment="Center" AutomationProperties.Name="Search"><PathIcon Data="{StaticResource IconSearch}"/></Button>
          <Button Grid.Column="1" Classes="touch" Click="OnNoteClick" IsEnabled="{Binding CanEditAnnotations}" HorizontalAlignment="Center" AutomationProperties.Name="Note"><PathIcon Data="{StaticResource IconNote}"/></Button>
          <Button Grid.Column="2" Classes="touch neutral" Command="{Binding UndoCommand}" HorizontalAlignment="Center" AutomationProperties.Name="Undo"><PathIcon Data="{StaticResource IconUndo}"/></Button>
          <Button Grid.Column="3" Classes="touch neutral" Command="{Binding RedoCommand}" HorizontalAlignment="Center" AutomationProperties.Name="Redo"><PathIcon Data="{StaticResource IconRedo}"/></Button>
          <Button Grid.Column="4" Classes="touch" Command="{Binding FitPageCommand}" HorizontalAlignment="Center" AutomationProperties.Name="Fit"><PathIcon Data="{StaticResource IconFitPage}"/></Button>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasDocument}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Classes="touch neutral" Command="{Binding PreviousPageCommand}" AutomationProperties.Name="Previous page"><PathIcon Data="{StaticResource IconChevronLeft}" Width="12" Height="12"/></Button>
            <TextBlock Text="{Binding PageStatusText}" FontSize="12" Foreground="{DynamicResource StudioMutedTextBrush}" VerticalAlignment="Center"/>
            <Button Classes="touch neutral" Command="{Binding NextPageCommand}" AutomationProperties.Name="Next page"><PathIcon Data="{StaticResource IconChevronRight}" Width="12" Height="12"/></Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="WideFit" Classes="touch" Command="{Binding FitPageCommand}" AutomationProperties.Name="Fit" ToolTip.Tip="Fit page"><PathIcon Data="{StaticResource IconFitPage}"/></Button>
            <Button Classes="touch neutral" Content="−" Command="{Binding ZoomOutCommand}" AutomationProperties.Name="Zoom out"/>
            <TextBlock Text="{Binding ZoomLabel}" FontSize="12" MinWidth="38" TextAlignment="Center" VerticalAlignment="Center"/>
            <Button Classes="touch neutral" Content="+" Command="{Binding ZoomInCommand}" AutomationProperties.Name="Zoom in"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
    <Border x:Name="SheetScrim" Grid.RowSpan="5" IsVisible="False" Background="#550E1420">
      <Border x:Name="SheetCard" Background="{DynamicResource StudioPanelBrush}" CornerRadius="22,22,0,0" Padding="20" VerticalAlignment="Bottom" MaxWidth="520" MaxHeight="560" KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="SheetTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="SheetDone" Classes="touch" Grid.Column="1" Content="Done" Click="OnDismissClick"/></Grid>
          <Grid Grid.Row="1">
            <ContentControl x:Name="SheetPages" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            <ListBox x:Name="DocumentList" Classes="documents" IsVisible="False" x:DataType="shell:StudioDocumentTabHost"
                     ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" Tapped="OnDocumentTapped" KeyDown="OnDocumentListKeyDown"
                     AutomationProperties.Name="Open documents" MaxHeight="420">
              <ListBox.ItemTemplate><DataTemplate x:DataType="shell:StudioDocumentTabViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinHeight="48">
                  <PathIcon Data="{StaticResource IconDocument}" Width="22" Height="22" Foreground="{DynamicResource StudioAccentBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{DynamicResource StudioAccentBrush}" IsVisible="{Binding IsDirty}"/>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer x:Name="CloseScroll" IsVisible="False">
              <StackPanel Spacing="14">
                <TextBlock x:Name="CloseDescription" TextWrapping="Wrap" FontSize="16"/>
                <TextBlock Text="Save keeps your edits in the working copy on this device. Use Share to export a copy to Files or another app." TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedTextBrush}"/>
                <Button Classes="touch filled" Content="{loc:Loc Common.Save}" Click="OnSaveAndCloseClick" HorizontalAlignment="Stretch"/>
                <Button Classes="touch destructive" Content="{loc:Loc Common.Discard}" Click="OnDiscardAndCloseClick" HorizontalAlignment="Stretch"/>
                <Button x:Name="CloseCancel" Classes="touch" Content="{loc:Loc Common.Cancel}" Click="OnDismissClick" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="NoteScroll" IsVisible="False">
              <StackPanel x:Name="NotePanel" Spacing="16">
                <TextBlock x:Name="SheetError" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="{DynamicResource StudioErrorBrush}"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsWorkspaceBusy}" Height="3"/>
                <TextBlock Text="Leave a thought on this page." Foreground="{DynamicResource StudioMutedTextBrush}"/>
                <TextBox x:Name="NoteText" PlaceholderText="Your note" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" MaxLength="4000" AutomationProperties.Name="Note text"/>
                <Button Classes="touch filled" Content="Add note" Click="OnAddNoteClick" HorizontalAlignment="Right"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
