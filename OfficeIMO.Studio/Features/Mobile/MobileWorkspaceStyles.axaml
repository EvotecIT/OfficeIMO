<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="using:OfficeIMO.Studio.Features.Shell">
  <Style Selector="Button.touch">
    <Setter Property="MinWidth" Value="44"/><Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="12,8"/><Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource StudioAccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template"><ControlTemplate><Border Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="Button.touch:pointerover /template/ Border#Surface, Button.touch:pressed /template/ Border#Surface"><Setter Property="Background" Value="{DynamicResource StudioAccentSoftBrush}"/></Style>
  <Style Selector="Button.touch:focus-visible /template/ Border#Surface"><Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
  <Style Selector="Button.touch:disabled"><Setter Property="Opacity" Value="0.3"/></Style>
  <Style Selector="Button.touch PathIcon"><Setter Property="Width" Value="19"/><Setter Property="Height" Value="19"/></Style>
  <Style Selector="Button.filled"><Setter Property="Background" Value="{DynamicResource StudioAccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="18,10"/></Style>
  <Style Selector="Button.filled:pointerover /template/ Border#Surface, Button.filled:pressed /template/ Border#Surface"><Setter Property="Background" Value="{DynamicResource StudioAccentHoverBrush}"/></Style>
  <Style Selector="Button.neutral"><Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}"/></Style>
  <Style Selector="Button.destructive"><Setter Property="Foreground" Value="{DynamicResource StudioErrorBrush}"/></Style>
  <Style Selector="ListBox.documents"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ListBox.documents ListBoxItem"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="10"/></Style>
  <Style Selector="ListBox.documents ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource StudioAccentSoftBrush}"/></Style>
  <Style Selector="ListBox.documents ListBoxItem /template/ Rectangle#SelectionIndicator"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="Border.toolGroup"><Setter Property="Background" Value="{DynamicResource StudioPanelMutedBrush}"/><Setter Property="CornerRadius" Value="12"/></Style>
  <Style Selector="Border.toolbarDivider"><Setter Property="Width" Value="1"/><Setter Property="Height" Value="22"/><Setter Property="Margin" Value="8,0"/><Setter Property="Background" Value="{DynamicResource StudioSubtleBorderBrush}"/></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="44"/><Setter Property="CornerRadius" Value="10"/><Setter Property="FontSize" Value="16"/></Style>
  <Style Selector="TabControl#MobileTabs">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><ControlTemplate><ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/></ScrollViewer></ControlTemplate></Setter>
    <Setter Property="ItemContainerTheme"><ControlTheme TargetType="TabItem" x:DataType="shell:StudioDocumentTabViewModel">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="MinHeight" Value="44"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
      <Setter Property="Template"><ControlTemplate><ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/></ControlTemplate></Setter>
    </ControlTheme></Setter>
  </Style>
  <Style Selector="Border.mobileTab"><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="10,10,0,0"/><Setter Property="BorderThickness" Value="1,1,1,0"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <Style Selector="TabItem:selected Border.mobileTab"><Setter Property="Background" Value="{DynamicResource StudioPanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StudioSubtleBorderBrush}"/></Style>
  <Style Selector="TabItem:pointerover Border.mobileTab"><Setter Property="Background" Value="{DynamicResource StudioPanelBrush}"/></Style>
  <Style Selector="TabItem:focus-visible Border.mobileTab"><Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}"/></Style>
  <Style Selector="TabItem TextBlock.tabName"><Setter Property="Foreground" Value="{DynamicResource StudioMutedTextBrush}"/></Style>
  <Style Selector="TabItem:selected TextBlock.tabName"><Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="ListBox.pages"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,6"/></Style>
  <Style Selector="ListBox.pages ListBoxItem"><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="2,4"/><Setter Property="CornerRadius" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
  <Style Selector="ListBox.pages ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource StudioAccentSoftBrush}"/></Style>
  <Style Selector="ListBox.pages ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource StudioAccentSoftBrush}"/></Style>
  <Style Selector="ListBox.pages ListBoxItem /template/ Rectangle#SelectionIndicator"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="Grid.pageCaption"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector=":is(ToggleButton).appNavigation"><Setter Property="MinHeight" Value="48"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,8"/><Setter Property="CornerRadius" Value="10"/></Style>
  <Style Selector=":is(ToggleButton).appNavigation:checked"><Setter Property="Background" Value="{DynamicResource StudioAccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource StudioAccentBrush}"/></Style>
  <Style Selector=":is(ToggleButton).appNavigation:checked /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource StudioAccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource StudioAccentBrush}"/></Style>
  <Style Selector="Button.tool, Button.primary, Button.ghost, Button.cmd, Button.icon, :is(ToggleButton).cmd, :is(ToggleButton).icon, :is(ToggleButton).tool"><Setter Property="MinWidth" Value="44"/><Setter Property="MinHeight" Value="44"/></Style>
  <Style Selector="ContentControl#FeatureSurface Button"><Setter Property="MinWidth" Value="44"/><Setter Property="MinHeight" Value="44"/></Style>
  <Style Selector="ContentControl#FeatureSurface :is(ToggleButton)"><Setter Property="MinWidth" Value="44"/><Setter Property="MinHeight" Value="44"/></Style>
  <Style Selector="ContentControl#FeatureSurface ComboBox"><Setter Property="MinHeight" Value="44"/></Style>
</Styles>
