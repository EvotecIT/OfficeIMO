<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ai="using:OfficeIMO.Studio.Features.Assistant" xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
             x:Class="OfficeIMO.Studio.Features.Assistant.AssistantView" x:DataType="ai:DocumentAssistantViewModel">
  <UserControl.Styles>
    <Style Selector="Border.message">
      <Setter Property="Background" Value="{DynamicResource StudioPanelRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioSubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.message.question">
      <Setter Property="Background" Value="{DynamicResource StudioAccentSoftBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="40,0,0,10" />
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource StudioPanelBrush}" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1,0,0,0">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource StudioAccentSoftBrush}">
            <PathIcon Data="{StaticResource IconSparkle}" Width="16" Height="16" Foreground="{DynamicResource StudioAccentBrush}" />
          </Border>
          <TextBlock Text="{loc:Loc Assistant.Title}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{loc:Loc Assistant.ReadOnly}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Connections.Summary}" Foreground="{DynamicResource StudioAccentBrush}" TextWrapping="Wrap" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis" />
        <!-- While the welcome card offers "Choose a provider", this entry would only repeat it. -->
        <Button Classes="tool" Content="{loc:Loc Assistant.Connections}" Click="ManageConnectionsClick" HorizontalAlignment="Stretch" IsVisible="{Binding !ShowConnections}" />
      </StackPanel>
      <Grid Grid.Row="1">
        <ScrollViewer IsVisible="{Binding ShowConnections}" HorizontalScrollBarVisibility="Disabled">
          <Border Classes="card" Margin="0,8">
            <StackPanel Spacing="12">
              <TextBlock Text="{loc:Loc Connections.Welcome}" Classes="sectionTitle" />
              <TextBlock Text="{loc:Loc Connections.WelcomeHelp}" Classes="muted" />
              <Button Classes="primary" Content="{loc:Loc Connections.ChooseProvider}" Click="ManageConnectionsClick" />
            </StackPanel>
          </Border>
        </ScrollViewer>
        <ScrollViewer x:Name="ConversationScroll" IsVisible="{Binding !ShowConnections}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
          <StackPanel Spacing="8" IsVisible="{Binding !HasConversation}" IsEnabled="{Binding !IsBusy}">
            <TextBlock Text="{loc:Loc Assistant.StartWith}" Classes="sectionTitle" />
            <WrapPanel>
              <Button Classes="tool" Content="{loc:Loc Assistant.Summarize}" Command="{Binding UsePromptCommand}" CommandParameter="Summary" Margin="0,0,6,6" />
              <Button Classes="tool" Content="{loc:Loc Assistant.ActionItems}" Command="{Binding UsePromptCommand}" CommandParameter="Actions" Margin="0,0,6,6" />
              <Button Classes="tool" Content="{loc:Loc Assistant.KeyFacts}" Command="{Binding UsePromptCommand}" CommandParameter="KeyFacts" Margin="0,0,6,6" />
            </WrapPanel>
          </StackPanel>
          <TextBlock Text="{Binding EvidenceSummary}" TextWrapping="Wrap" Classes="muted" />
          <WrapPanel>
            <Button Classes="tool" Content="{loc:Loc Assistant.PrepareEvidence}" Command="{Binding PrepareEvidenceCommand}" Margin="0,0,6,6" />
            <Button Classes="tool" Content="{loc:Loc Assistant.OpenOcr}" Command="{Binding OpenOcrCommand}" IsVisible="{Binding CanOpenOcr}" Margin="0,0,6,6" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ai:AssistantMessage">
                <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="12"
                        Classes.question="{Binding IsQuestion}" Classes="message">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Citations}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ai:AssistantCitation">
                          <Border Margin="0,3" Padding="8,6" CornerRadius="8" Background="{DynamicResource StudioPanelMutedBrush}"
                                  BorderBrush="{DynamicResource StudioSpineBrush}" BorderThickness="2,0,0,0">
                            <StackPanel Spacing="3">
                              <Button Classes="link" Command="{Binding NavigateCommand}" HorizontalAlignment="Left" Padding="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Data="{StaticResource IconDocument}" Width="11" Height="11" />
                                  <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                              </Button>
                              <TextBlock Text="{Binding Quote}" Classes="muted" TextWrapping="Wrap" FontSize="12" FontStyle="Italic" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel IsVisible="{Binding CanReviewAnswer}">
            <Button Classes="tool" Content="{loc:Loc Assistant.CopyAnswer}" Command="{Binding CopyLastAnswerCommand}" Margin="0,0,6,6" />
            <Button Classes="tool" Content="{loc:Loc Assistant.ExportAnswer}" Command="{Binding ExportLastAnswerCommand}" Margin="0,0,6,6" />
          </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <StackPanel Grid.Row="2" Spacing="8" IsVisible="{Binding !ShowConnections}">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
        <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
        <StackPanel IsEnabled="{Binding !IsBusy}" Spacing="6">
          <CheckBox Content="{loc:Loc Assistant.CurrentPage}" IsChecked="{Binding CurrentPageOnly}" />
          <CheckBox IsVisible="{Binding !Connections.IsLocal}" IsChecked="{Binding AllowRemoteProcessing}">
            <TextBlock Text="{loc:Loc Assistant.RemoteConsent}" TextWrapping="Wrap" />
          </CheckBox>
          <TextBox Text="{Binding Question}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66" MaxHeight="110" MaxLength="8000"
                   PlaceholderText="{loc:Loc Assistant.Question}" AutomationProperties.Name="{loc:Loc Assistant.Question}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <Button Classes="primary" Content="{loc:Loc Assistant.Ask}" Command="{Binding AskCommand}" HorizontalAlignment="Stretch" />
          <Button Classes="tool" Grid.Column="1" Content="{loc:Loc MainWindow.Cancel}" IsVisible="{Binding IsBusy}" Command="{Binding CancelCommand}" />
          <Button Classes="tool" Grid.Column="2" Content="{loc:Loc Assistant.NewChat}" Command="{Binding NewConversationCommand}" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
