<UserControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
             xmlns:reader="using:OfficeIMO.Studio.Features.Reader"
             xmlns:organizer="using:OfficeIMO.Studio.Features.Organizer"
             x:Class="OfficeIMO.Studio.Features.Organizer.PdfOrganizerPageView"
             x:DataType="organizer:PdfOrganizerPageViewModel">
  <StackPanel Margin="6" Spacing="{StaticResource StudioSpaceSM}" HorizontalAlignment="Center">
    <Border Width="124" Height="154"
            Background="White"
            BorderBrush="{DynamicResource StudioSubtleBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            BoxShadow="{DynamicResource StudioCardShadow}"
            Padding="6">
      <Grid>
        <Grid Width="{Binding ThumbnailWidth}" Height="{Binding ThumbnailHeight}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <reader:PdfPageCanvas x:Name="ThumbnailCanvas"
                                IsHitTestVisible="False"
                                Scene="{Binding Scene}"
                                FallbackImage="{Binding FallbackImage}" />
          <!-- A pending crop is outlined on the selected pages before it is applied. -->
          <Rectangle IsVisible="{Binding HasCropPreview}" Margin="{Binding CropPreviewInset}" IsHitTestVisible="False"
                     Stroke="{DynamicResource StudioAccentBrush}" StrokeThickness="1.5" StrokeDashArray="3,2" />
        </Grid>
        <ProgressBar IsVisible="{Binding IsLoading}"
                     Width="54"
                     IsIndeterminate="True"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        <TextBlock IsVisible="{Binding HasError}"
                   Text="{loc:Loc PdfOrganizerPage.PreviewUnavailable}"
                   FontSize="{StaticResource StudioSecondaryFontSize}"
                   Foreground="{DynamicResource StudioErrorBrush}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
    <TextBlock Text="{Binding Label}"
               FontSize="{StaticResource StudioCaptionFontSize}"
               Foreground="{DynamicResource StudioMutedTextBrush}"
               HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
