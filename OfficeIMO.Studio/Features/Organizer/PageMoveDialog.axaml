<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OfficeIMO.Studio.Features.Organizer"
        xmlns:loc="using:OfficeIMO.Studio.Infrastructure.Localization"
        x:Class="OfficeIMO.Studio.Features.Organizer.PageMoveDialog"
        x:DataType="local:PageMovePreviewViewModel"
        Title="{loc:Loc Organizer.MovePages}" Width="520" Height="520" MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource StudioPanelBrush}" FontSize="14">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
    <StackPanel Spacing="4">
      <TextBlock Text="{loc:Loc Organizer.MovePages}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{loc:Loc Organizer.MoveHint}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SelectedPagesLabel}" TextWrapping="Wrap" MaxHeight="60" />
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="4">
      <TextBlock Text="{loc:Loc Organizer.BeforePage}" />
      <TextBox x:Name="DestinationInput" Text="{Binding InsertBeforePage, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"
               AutomationProperties.Name="{loc:Loc Organizer.BeforePage}" />
      <TextBlock Text="{Binding EndHint}" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    <TextBlock Grid.Row="3" Text="{loc:Loc Organizer.ResultOrder}" FontWeight="SemiBold" />
    <ListBox Grid.Row="4" ItemsSource="{Binding Rows}" AutomationProperties.Name="{loc:Loc Organizer.ResultOrder}">
      <ListBox.ItemTemplate><DataTemplate x:DataType="local:PageMovePreviewRow">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding Label}" />
          <TextBlock Text="{loc:Loc Organizer.Moved}" IsVisible="{Binding IsMoved}" FontWeight="SemiBold" />
        </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{loc:Loc Common.Cancel}" IsCancel="True" Click="OnCancel" />
      <Button Content="{loc:Loc Organizer.ApplyMove}" IsEnabled="{Binding CanApply}" Click="OnApply" />
    </StackPanel>
  </Grid>
</Window>
