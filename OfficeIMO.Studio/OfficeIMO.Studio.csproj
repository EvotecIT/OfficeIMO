<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Cross-platform OfficeIMO desktop document reader and workspace.</Description>
    <AssemblyName>OfficeIMO.Studio</AssemblyName>
    <RootNamespace>OfficeIMO.Studio</RootNamespace>
    <AssemblyTitle>OfficeIMO Studio</AssemblyTitle>
    <Product>OfficeIMO Studio</Product>
    <ApplicationIcon>Assets\OfficeIMO.Studio.ico</ApplicationIcon>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/EvotecIT/OfficeIMO</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>Latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\OfficeIMO.Studio.ico" />
    <None Update="Assets\OfficeIMO.Studio.png" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.Pdf\OfficeIMO.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Reader.Ocr\OfficeIMO.Reader.Ocr.csproj" />
    <ProjectReference Include="..\OfficeIMO.Security\OfficeIMO.Security.csproj" />
    <ProjectReference Include="..\OfficeIMO.Workflows\OfficeIMO.Workflows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OfficeIMO.Studio.Tests" />
  </ItemGroup>
</Project>
