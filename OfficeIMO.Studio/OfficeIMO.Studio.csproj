<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Cross-platform OfficeIMO desktop document reader and workspace.</Description>
    <AssemblyName>OfficeIMO.Studio</AssemblyName>
    <RootNamespace>OfficeIMO.Studio</RootNamespace>
    <AssemblyTitle>OfficeIMO Studio</AssemblyTitle>
    <Product>OfficeIMO Studio</Product>
    <ApplicationIcon>Assets\OfficeIMO.Studio.ico</ApplicationIcon>
    <Version>0.1.9767</Version>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/EvotecIT/OfficeIMO</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>Latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OfficeIMOStudioDistribution)' == 'MacAppStore'">
    <DefineConstants>$(DefineConstants);OFFICEIMO_MAC_APP_STORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\OfficeIMO.Studio.ico" />
    <AvaloniaResource Include="Assets\OfficeIMO.Studio.png" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.AI.IntelligenceX\OfficeIMO.AI.IntelligenceX.csproj" />
    <ProjectReference Include="..\OfficeIMO.Reader.Pdf\OfficeIMO.Reader.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Core\OfficeIMO.Core.csproj"
                      AdditionalProperties="TargetFramework=net10.0" />
    <ProjectReference Include="..\OfficeIMO.Ocr.Tesseract\OfficeIMO.Ocr.Tesseract.csproj" />
    <ProjectReference Include="..\OfficeIMO.Pdf\OfficeIMO.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Pdf.Ocr\OfficeIMO.Pdf.Ocr.csproj" />
    <ProjectReference Include="..\OfficeIMO.Security\OfficeIMO.Security.csproj" />
    <ProjectReference Include="..\OfficeIMO.Workflows\OfficeIMO.Workflows.csproj" />
    <ProjectReference Include="..\OfficeIMO.Workflows.IWork\OfficeIMO.Workflows.IWork.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OfficeIMO.Studio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\LICENSE" Link="Licenses\OfficeIMO-MIT.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\OfficeIMO.Core\Licenses\*.txt" Link="Licenses\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\OfficeIMO.Core\THIRD-PARTY-NOTICES.md" Link="Licenses\OfficeIMO.Core-THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\OfficeIMO.Pdf\Resources\sRGB-LICENSE.txt" Link="Licenses\sRGB-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="OPEN_SOURCE.md" Link="Licenses\OPEN_SOURCE.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
