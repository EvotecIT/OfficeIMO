<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Fixtures/Preact/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/React18/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/ReactBuild/index.html;Fixtures/ReactBuild/style.css;Fixtures/ReactBuild/data.json;Fixtures/ReactBuild/dist/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/ObservedReport/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/StandaloneApplication/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/LegacyApplication/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/ApplicationCorpus/**/*" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <ProjectReference Include="../OfficeIMO.Html.Runtime/OfficeIMO.Html.Runtime.csproj" />
    <ProjectReference Include="../OfficeIMO.Html.Runtime.Rendering/OfficeIMO.Html.Runtime.Rendering.csproj" />
    <ProjectReference Include="../OfficeIMO.Html.Runtime.Conformance/OfficeIMO.Html.Runtime.Conformance.csproj" />
    <ProjectReference Include="../OfficeIMO.AI/OfficeIMO.AI.csproj" />
    <ProjectReference Include="../OfficeIMO.AI.Html/OfficeIMO.AI.Html.csproj" />
    <ProjectReference Include="../OfficeIMO.Html.Runtime.Worker/OfficeIMO.Html.Runtime.Worker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../OfficeIMO.Html.Pdf/OfficeIMO.Html.Pdf.csproj" />
    <ProjectReference Include="../OfficeIMO.Markdown.Html/OfficeIMO.Markdown.Html.csproj" />
  </ItemGroup>
  <Target Name="CopyRuntimeWorker" AfterTargets="Build">
    <ItemGroup><RuntimeWorkerFile Include="../OfficeIMO.Html.Runtime.Worker/bin/$(Configuration)/$(TargetFramework)/**/*" /></ItemGroup>
    <Copy SourceFiles="@(RuntimeWorkerFile)" DestinationFiles="@(RuntimeWorkerFile->'$(OutDir)RuntimeWorker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
