<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- Windows PowerShell 5.1 hosts PSWriteOffice on .NET Framework; the comparisons listed below for net472
         measure that runtime. -->
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' ">$(TargetFrameworks);net472</TargetFrameworks>

    <LangVersion>Latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Docnet.Core's PDFium build fails fast under CET shadow stacks (0xC0000409). -->
    <CETCompat>false</CETCompat>
    <PeachPdfBenchmarkVersion>0.9.25</PeachPdfBenchmarkVersion>
    <PdfPeckerBenchmarkVersion>1.22.0</PdfPeckerBenchmarkVersion>
    <QuestPdfBenchmarkVersion Condition="'$(QuestPdfBenchmarkVersion)' == ''">2026.5.0</QuestPdfBenchmarkVersion>
    <QuestPdfInternalAuthorization Condition="'$(QuestPdfInternalAuthorization)' == ''">false</QuestPdfInternalAuthorization>
    <HtmlTinkerXProjectPath Condition="'$(HtmlTinkerXProjectPath)' == '' and '$(HTMLTINKERX_PROJECT_PATH)' != ''">$(HTMLTINKERX_PROJECT_PATH)</HtmlTinkerXProjectPath>
  </PropertyGroup>

  <!-- Windows PowerShell 5.1 is a 64-bit process; an SDK-style .NET Framework exe would otherwise run as x86. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PeachPdfBenchmarkVersion" Value="$(PeachPdfBenchmarkVersion)" />
    <AssemblyMetadata Include="PdfPeckerBenchmarkVersion" Value="$(PdfPeckerBenchmarkVersion)" />
    <AssemblyMetadata Include="QuestPdfBenchmarkVersion" Value="$(QuestPdfBenchmarkVersion)" />
    <AssemblyMetadata Include="QuestPdfInternalAuthorization" Value="$(QuestPdfInternalAuthorization)" />
  </ItemGroup>

  <Target Name="ValidateQuestPdfBenchmarkLicenseBoundary" BeforeTargets="CollectPackageReferences;ResolvePackageAssets">
    <Error
      Condition="'$(QuestPdfBenchmarkVersion)' != '2026.5.0' and '$(QuestPdfInternalAuthorization)' != 'true'"
      Text="QuestPDF $(QuestPdfBenchmarkVersion) is not allowed in the public benchmark lane. Use the guarded internal runner after confirming authorization." />
  </Target>

  <PropertyGroup Condition="'$(HtmlTinkerXProjectPath)' != ''">
    <HtmlTinkerXSourceProjectFullPath>$([System.IO.Path]::GetFullPath('$(HtmlTinkerXProjectPath)'))</HtmlTinkerXSourceProjectFullPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(HtmlTinkerXProjectPath)' != ''">
    <AssemblyMetadata Include="HtmlTinkerXSourceProjectPath" Value="$(HtmlTinkerXSourceProjectFullPath)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="itext" Version="9.7.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!--
      2026.5.0 is the last QuestPDF release whose embedded Community license
      grants eligible open-source projects the MIT license. Starting with
      2026.6.0, QuestPDF's source-available license restricts use by competing
      general-purpose PDF libraries. Keep this benchmark-only dependency pinned.
    -->
    <PackageReference Include="QuestPDF" Version="$(QuestPdfBenchmarkVersion)" />
  </ItemGroup>

  <!--
    OnePDF ships net10.0 only, so its read and layout lanes compile only for that target.
    The vendor releases often; keep both packages pinned to the same reviewed version.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="RecursiveAI.OnePdf" Version="1.22.0" />
    <PackageReference Include="RecursiveAI.OnePdf.Layout" Version="1.22.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <!-- PDFium through Docnet.Core is the page-render comparison engine; it ships native PDFium binaries. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="HtmlTinkerX" Version="3.0.5" Condition="'$(HtmlTinkerXProjectPath)' == ''" />
    <PackageReference Include="itext.pdfhtml" Version="6.3.3" />
    <PackageReference Include="PeachPDF" Version="$(PeachPdfBenchmarkVersion)" />
    <PackageReference Include="PdfPecker" Version="$(PdfPeckerBenchmarkVersion)" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Remove="**/*.cs" />
    <Compile Include="BenchmarkAffinityGuard.cs" />
    <Compile Include="ITextPdfGenerator.cs" />
    <Compile Include="MigraDocPdfGenerator.cs" />
    <Compile Include="OfficeImoPdfGenerator.cs" />
    <Compile Include="PdfBenchmarkScenarios.cs" />
    <Compile Include="PdfBenchmarkValidation.cs" />
    <Compile Include="PdfDocumentGenerators.cs" />
    <Compile Include="PdfDocumentReaders.cs" />
    <Compile Include="PdfGenerationBenchmarks.cs" />
    <Compile Include="PdfReadBenchmarks.cs" />
    <Compile Include="QuestPdfBenchmarkPolicy.cs" />
    <Compile Include="QuestPdfGenerator.cs" />
    <Compile Include="NetFramework/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(HtmlTinkerXProjectPath)' != ''">
    <ProjectReference Include="$(HtmlTinkerXProjectPath)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.AsciiDoc\OfficeIMO.AsciiDoc.csproj" />
    <ProjectReference Include="..\OfficeIMO.AsciiDoc.Pdf\OfficeIMO.AsciiDoc.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Excel\OfficeIMO.Excel.csproj" />
    <ProjectReference Include="..\OfficeIMO.Excel.Pdf\OfficeIMO.Excel.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Html\OfficeIMO.Html.csproj" />
    <ProjectReference Include="..\OfficeIMO.Html.Pdf\OfficeIMO.Html.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Invoicing\OfficeIMO.Invoicing.csproj" />
    <ProjectReference Include="..\OfficeIMO.Invoicing.Pdf\OfficeIMO.Invoicing.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Latex\OfficeIMO.Latex.csproj" />
    <ProjectReference Include="..\OfficeIMO.Latex.Pdf\OfficeIMO.Latex.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Markdown\OfficeIMO.Markdown.csproj" />
    <ProjectReference Include="..\OfficeIMO.Markdown.Pdf\OfficeIMO.Markdown.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Mhtml\OfficeIMO.Mhtml.csproj" />
    <ProjectReference Include="..\OfficeIMO.Mhtml.Pdf\OfficeIMO.Mhtml.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.OneNote\OfficeIMO.OneNote.csproj" />
    <ProjectReference Include="..\OfficeIMO.OneNote.Pdf\OfficeIMO.OneNote.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.OpenDocument\OfficeIMO.OpenDocument.csproj" />
    <ProjectReference Include="..\OfficeIMO.OpenDocument.Odp.Pdf\OfficeIMO.OpenDocument.Odp.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.OpenDocument.Ods.Pdf\OfficeIMO.OpenDocument.Ods.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.OpenDocument.Odt.Pdf\OfficeIMO.OpenDocument.Odt.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Pdf\OfficeIMO.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.PowerPoint\OfficeIMO.PowerPoint.csproj" />
    <ProjectReference Include="..\OfficeIMO.PowerPoint.Pdf\OfficeIMO.PowerPoint.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Rtf\OfficeIMO.Rtf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Rtf.Pdf\OfficeIMO.Rtf.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Word\OfficeIMO.Word.csproj" />
    <ProjectReference Include="..\OfficeIMO.Word.Pdf\OfficeIMO.Word.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Visio\OfficeIMO.Visio.csproj" />
    <ProjectReference Include="..\OfficeIMO.Visio.Pdf\OfficeIMO.Visio.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Website\Apps\OfficeIMO.Web.Converter\Assets\Fonts\Carlito-Regular.ttf"
          Link="Fonts\Carlito-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Website\Apps\OfficeIMO.Web.Converter\Assets\Fonts\Carlito-Bold.ttf"
          Link="Fonts\Carlito-Bold.ttf"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Assets\Brand\Evotec\evotec-logo-horizontal-gradient-2400.png"
          Link="Brand\evotec-logo-horizontal-gradient-2400.png"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Assets\Images\Others\Logo-evotec.png"
          Link="Brand\Logo-evotec.png"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <None Include="$(PkgPdfPecker)/pdfpecker.nuspec;$(PkgPdfPecker)/LICENSE;$(PkgPdfPecker)/THIRD-PARTY-NOTICES.md;$(PkgPdfPecker)/pdfpecker.$(PdfPeckerBenchmarkVersion).nupkg.sha512"
          Link="Licenses/PdfPecker/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Corpus\pdf-corpus.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Update="Corpus\html-h10-page-selection.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
