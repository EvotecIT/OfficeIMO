<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <VersionPrefix>3.4.3</VersionPrefix>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../External/AngleSharp/LICENSE" Link="AngleSharp.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../External/AngleSharp.Js/LICENSE" Link="AngleSharp.Js.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="OfficeIMO.Html.Runtime.Worker.manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="RuntimeBootstrap.js" LogicalName="OfficeIMO.RuntimeBootstrap.js" />
    <EmbeddedResource Include="RuntimeFetchBootstrap.js" LogicalName="OfficeIMO.RuntimeFetchBootstrap.js" />
    <EmbeddedResource Include="RuntimeXmlHttpRequestBootstrap.js" LogicalName="OfficeIMO.RuntimeXmlHttpRequestBootstrap.js" />
    <EmbeddedResource Include="RuntimeUrlBootstrap.js" LogicalName="OfficeIMO.RuntimeUrlBootstrap.js" />
    <EmbeddedResource Include="RuntimeObserverBootstrap.js" LogicalName="OfficeIMO.RuntimeObserverBootstrap.js" />
    <EmbeddedResource Include="RuntimeStorageBootstrap.js" LogicalName="OfficeIMO.RuntimeStorageBootstrap.js" />
    <EmbeddedResource Include="RuntimeWindowBootstrap.js" LogicalName="OfficeIMO.RuntimeWindowBootstrap.js" />
    <EmbeddedResource Include="RuntimeHistoryBootstrap.js" LogicalName="OfficeIMO.RuntimeHistoryBootstrap.js" />
    <EmbeddedResource Include="RuntimeStructuredCloneErrors.js" LogicalName="OfficeIMO.RuntimeStructuredCloneErrors.js" />
    <EmbeddedResource Include="RuntimeStructuredClone.js" LogicalName="OfficeIMO.RuntimeStructuredClone.js" />
    <EmbeddedResource Include="RuntimeStructuredCloneTransport.js" LogicalName="OfficeIMO.RuntimeStructuredCloneTransport.js" />
    <ProjectReference Include="../OfficeIMO.Html.Runtime/OfficeIMO.Html.Runtime.csproj" />
    <ProjectReference Include="../OfficeIMO.Html/OfficeIMO.Html.csproj" />
    <ProjectReference Include="../External/AngleSharp/src/AngleSharp/AngleSharp.Core.csproj" />
    <!-- The isolated worker loads the pinned fork assembly; static consumers retain
         their normal package dependency. Do not copy that package DLL into this worker. -->
    <PackageReference Include="AngleSharp" Version="1.8.2" ExcludeAssets="all" />
    <PackageReference Include="AngleSharp.Css" Version="1.0.1" />
    <ProjectReference Include="../External/AngleSharp.Js/src/AngleSharp.Js/AngleSharp.Js.csproj" />
    <PackageReference Include="Jint" Version="4.16.0" />
  </ItemGroup>
</Project>
