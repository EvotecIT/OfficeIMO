<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Optional Windows Imaging Component HEIC decoder for OfficeIMO.</Description>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <VersionPrefix>3.5.3</VersionPrefix>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <PackageId>OfficeIMO.Drawing.Wic</PackageId>
    <PackageTags>officeimo;drawing;heic;heif;wic;windows</PackageTags>
    <PackageProjectUrl>https://github.com/EvotecIT/OfficeIMO</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EvotecIT/OfficeIMO</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>OfficeIMO.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPublishable>true</IsPublishable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OfficeIMO.Core/OfficeIMO.Core.csproj" />
    <EmbeddedResource Include="Resources/Probe.heic" LogicalName="OfficeIMO.Drawing.Wic.Probe.heic" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../Assets/OfficeIMO.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
