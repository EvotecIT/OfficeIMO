<?xml version="1.0" encoding="utf-8"?>
<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- Forward PDF conversion types moved to the document assemblies as described in MIGRATION.md.
       Scope the 3.3 baseline exceptions to exact moved types; member exceptions under removed
       converter classes are obsolete. Omit assembly operands because Unix packages use
       netstandard2.0 for the 3.3 net472 baseline; Windows packages use net472. -->
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:OfficeIMO.PowerPoint.Pdf.PdfPowerPointImportOptions</Target>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:OfficeIMO.PowerPoint.Pdf.PowerPointPdfSaveOptions</Target>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:OfficeIMO.PowerPoint.Pdf.PowerPointPdfConverterExtensions</Target>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:OfficeIMO.PowerPoint.Pdf.PowerPointPdfExportWarning</Target>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:OfficeIMO.PowerPoint.Pdf.PowerPointPdfPageLayout</Target>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
</Suppressions>
