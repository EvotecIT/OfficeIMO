<Project>
  <!-- Shared settings for the xUnit, NUnit and MSTest consumers of the packed OfficeIMO.Pdf.Testing package. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOsPlatform('Windows'))">net472;$(TargetFrameworks)</TargetFrameworks>
    <EnableOfficeIMOPdfTestingPackageSmoke Condition="'$(EnableOfficeIMOPdfTestingPackageSmoke)' == ''">false</EnableOfficeIMOPdfTestingPackageSmoke>
    <OfficeIMOPdfTestingPackageVersion Condition="'$(OfficeIMOPdfTestingPackageVersion)' == ''">3.6.0-smoke</OfficeIMOPdfTestingPackageVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>Latest</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableOfficeIMOPdfTestingPackageSmoke)' == 'true'">
    <PackageReference Include="OfficeIMO.Pdf.Testing" Version="[$(OfficeIMOPdfTestingPackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <Compile Include="$(MSBuildThisFileDirectory)InvoiceSample.cs" Link="InvoiceSample.cs" />
  </ItemGroup>

  <Target Name="RequirePackageSmokeOptIn" BeforeTargets="CoreCompile"
          Condition="'$(EnableOfficeIMOPdfTestingPackageSmoke)' != 'true'">
    <Error Text="Set EnableOfficeIMOPdfTestingPackageSmoke=true and restore from a feed containing the packed OfficeIMO.Pdf.Testing package." />
  </Target>
</Project>
