<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="'$(TargetFramework)' != 'netstandard2.0'">Exe</OutputType>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOsPlatform('Windows'))">net472;$(TargetFrameworks)</TargetFrameworks>
    <EnableOfficeIMOTypographyPackageSmoke Condition="'$(EnableOfficeIMOTypographyPackageSmoke)' == ''">false</EnableOfficeIMOTypographyPackageSmoke>
    <OfficeIMOTypographyPackageVersion Condition="'$(OfficeIMOTypographyPackageVersion)' == ''">3.3.0</OfficeIMOTypographyPackageVersion>
    <IsPackable>false</IsPackable>
    <LangVersion>Latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableOfficeIMOTypographyPackageSmoke)' == 'true'">
    <PackageReference Include="OfficeIMO.Core" Version="[$(OfficeIMOTypographyPackageVersion)]" />
    <PackageReference Include="OfficeIMO.Drawing.HarfBuzz" Version="[$(OfficeIMOTypographyPackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\Website\Apps\OfficeIMO.Web.Converter\Assets\Fonts\NotoSansArabic-Regular.ttf"
          Link="TestAssets\NotoSansArabic-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\OfficeIMO.Drawing.Tests\TestAssets\OpenSans-Regular.woff2"
          Link="TestAssets\OpenSans-Regular.woff2"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\OfficeIMO.Drawing.Tests\TestAssets\RobotoFlex.ttf"
          Link="TestAssets\RobotoFlex.ttf"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequirePackageSmokeOptIn" BeforeTargets="CoreCompile"
          Condition="'$(EnableOfficeIMOTypographyPackageSmoke)' != 'true'">
    <Error Text="Set EnableOfficeIMOTypographyPackageSmoke=true and restore from a feed containing the packed OfficeIMO typography packages." />
  </Target>
</Project>
