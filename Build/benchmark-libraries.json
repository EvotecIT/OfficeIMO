{
  "schemaVersion": 1,
  "description": "Licence and restriction policy for every library OfficeIMO benchmarks compare against. Runners read it to decide which libraries may run and which results may be published. environmentVariables lists values a library reads from the caller when it runs; acceptance lists what an enabled restricted library needs. declare names the package and pinned version the published comparisons measure when packages lists more than one, and the frameworks that version runs on when it is not every framework; Build/Export-BenchmarkDeclarations.ps1 turns this file into the benchmark declarations.",
  "restrictionClasses": {
    "open": "Runs by default and may appear in published comparisons.",
    "publish-restricted": "May run locally when included with -IncludeLibrary; published comparisons leave its cases out.",
    "acceptance-required": "Runs only after the caller accepts its licence with -AcceptLibraryLicense and supplies whatever the library itself needs; published comparisons leave its cases out.",
    "excluded": "Never runs."
  },
