<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <HtmlForgeXSourceRoot Condition="'$(HtmlForgeXSourceRoot)' == '' and '$(EVOTEC_GITHUB_ROOT)' != ''">$(EVOTEC_GITHUB_ROOT)/HtmlForgeX</HtmlForgeXSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(HtmlForgeXSourceRoot)/HtmlForgeX/HtmlForgeX.csproj" />
    <None Update="report.css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireHtmlForgeXSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(HtmlForgeXSourceRoot)' == '' or !Exists('$(HtmlForgeXSourceRoot)/HtmlForgeX/HtmlForgeX.csproj')"
           Text="Set HtmlForgeXSourceRoot to the inspected HtmlForgeX source checkout." />
  </Target>
</Project>
