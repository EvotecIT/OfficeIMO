<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OfficeIMO.Core\OfficeIMO.Core.csproj" />
    <ProjectReference Include="..\..\OfficeIMO.Html\OfficeIMO.Html.csproj" />
    <ProjectReference Include="..\..\OfficeIMO.Html.Pdf\OfficeIMO.Html.Pdf.csproj" />
    <ProjectReference Include="..\..\OfficeIMO.Pdf\OfficeIMO.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\OfficeIMO.Pdf.Benchmarks.Comparisons\EvidenceOutputReservation.cs"
             Link="EvidenceOutputReservation.cs" />
    <Compile Include="..\..\OfficeIMO.Pdf.Benchmarks.Comparisons\ProcessTreeMemorySampler.cs"
             Link="ProcessTreeMemorySampler.cs" />
    <Compile Include="..\..\OfficeIMO.Pdf.Benchmarks.Comparisons\SourceProvenanceReader.cs"
             Link="SourceProvenanceReader.cs" />
    <Compile Include="..\..\OfficeIMO.TestAssets\HtmlRenderingHeldOutCorpus.cs"
             Link="HtmlRenderingHeldOutCorpus.cs" />
    <None Include="..\..\OfficeIMO.TestAssets\Documents\Html\Qualification\H4\v2\**\*"
          Link="Documents\Html\Qualification\H4\v2\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
