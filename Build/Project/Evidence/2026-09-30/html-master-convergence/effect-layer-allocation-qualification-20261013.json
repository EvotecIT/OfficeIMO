  "contracts": {
    "rasterPixelLimit": "HTML image export and managed PDF raster fallback pass MaximumRasterPixels to the drawing renderer. Root and cumulative intermediate-surface limits remain enforced.",
    "primitiveAllocation": "Eligible effect layers keep their original scene coordinates, paint, opacity and isolation while allocating fewer trailing transparent rows and columns.",
    "eligibility": [
      "Every layer element is a filled rectangle, rounded rectangle or ellipse. Solid, linear-gradient and radial-gradient fills qualify.",
      "Shapes have finite positive dimensions, finite positions and opacities, zero stroke width, and no shadow, glow, local clip or nonidentity shape transform.",
      "The effect uses normal blending without a soft mask. Sampling is uniform, and the final device transform is exactly unit scale with integer pixel translation.",
      "Text, images, nested groups, paths, filter-expanded paint, special marker or text surfaces, and other sampling transforms retain the existing full-layer path."
    ],
    "allocationGuard": "The original dimension and overflow checks remain active. Cropped pixels are charged to the shared cumulative budget before allocation.",
    "publicApiChanged": false,
    "productionDependencyAdded": false
  },
