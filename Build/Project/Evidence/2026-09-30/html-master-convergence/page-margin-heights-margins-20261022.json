  "contract": {
    "verticalEquation": "The reserved strip equals top margin, top border/padding, content height, bottom padding/border and bottom margin. Auto height fills the residual; min/max re-resolve margins. Over-constrained top boxes solve the top margin; bottom boxes solve the bottom margin.",
    "horizontalMargins": "Auto is zero; signed margins participate in outer width distribution and border placement. Content/border dimensions remain nonnegative.",
    "percentages": "Horizontal margin and padding percentages use strip width; vertical margin, padding and height percentages use strip height.",
    "paint": "Body pagination is unchanged. Generated empty decorations remain; none removes the box. Running content uses the same inner frame. Cropped running paint reports a typed omission; unused frame overflow alone remains loss-free.",
    "normativeReference": "https://www.w3.org/TR/css-page-3/#margin-dimension"
  },
