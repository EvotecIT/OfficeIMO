  "contract": {
    "owner": "OfficeIMO.Html",
    "currentContract": "OfficeIMO.Html/README.md",
    "qualifiedSubset": "Ordinary horizontal single-row nonanonymous table cells: percentage height/min-height/max-height on normal block and inline-block descendants use the final used cell content height. Effective cascade, logical properties, CSS variables, valid math, box sizing and padding retain the same owner.",
    "intrinsicPass": "Percentage descendants initially have an indefinite percentage basis; definite cell height and absolute minima retain their normal contribution. Final used-cell resolution does not perform a second row-share allocation.",
    "wrappers": "Inline and display:contents wrappers forward the nearest real containing-height basis; their authored height does not create a new containing block. Auto-height cells retain the indefinite initial basis. Real inline-block descendants establish their own basis.",
    "heightMinimum": "A table cell height is a minimum. A height:240px child with max-height:100% can grow a height:120px cell to240px; capping it at120px was a stale test assertion. Standards-mode Chromium 153 independently confirms240px.",
    "rejectedAlternative": "A trial absolute-cell basis during intrinsic sizing wrongly reduced max-height100% growth and enlarged above100percent cases. It is not in the qualified runtime.",
    "operationLimits": "Cell replay preserves cumulative operation limits and logical order; temporary table-cell state is restored. Changed operation allocation is reported as loss."
  },
