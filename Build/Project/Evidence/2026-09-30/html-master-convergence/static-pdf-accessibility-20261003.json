  "confirmedDefects": [
    "PDF/UA-1 Note tags lacked required unique IDs (two ISO 14289-1:2014 clause 7.9 failures in baseline column-note fixture)",
    "Positioned link runs were serialized outside their logical paragraph or note",
    "Mixed text/link and inline-figure continuations visited trailing text before intervening content",
    "Attachment version rejection advised PDF 1.7 even when attachments imposed PDF 2.0"
  ],
  "contracts": [
    "Note IDs resolve through the structure ID name tree",
    "Text, links and inline figures retain source order under their semantic container",
    "Annotation-bearing containers retain ordered child references alongside OBJRs",
    "Incompatible standalone PDF/UA-1 rejects before destination writes; requested profile and MathML retained",
    "Explicit PDF/A-3b and combined PDF/A-3b/PDF/UA-1 remain supported fixture routes; no automatic profile switch or source omission"
  ],
