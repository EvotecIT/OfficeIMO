  "diagnosis": {
    "entry": "HtmlRenderLayoutEngine.ApplyPositioning -> HtmlRenderFlowBlock.TranslatePaint",
    "flow": "TranslatePaint retains Height/BreakOffsets/LineBreakGroups/avoid ranges and each visual LayoutY, while moving its paint Y.",
    "fragmentMembership": "SliceVisuals selects by normal-flow LayoutY/LayoutHeight; AddTranslatedVisuals/CommitPage emits each resulting fragment on one physical page.",
    "failure": "After fragment assignment, a relative paint shift crosses a physical page boundary. A line still exists in the scene but lies outside its assigned page box and is clipped by the PDF surface.",
    "negativeProof": "Plain lines09-12 belong to the next normal-flow fragment but paint in its negativeY range; Chromium paints them on the preceding page.",
    "positiveProof": "Plain lines05-08 belong to the first normal-flow fragment but paint past its bottom; Chromium paints them at the beginning of page2.",
    "normalFlow": "Both engines keep the following sibling at its unshifted flow location; positive offsets create an authored overlap with row15.",
    "extractorCaveat": "Layout-ordered extraction interleaves overlapping row15/trailing labels in both engines. Raw extraction preserves both in Chromium; this is not content loss. Original observation was retained and refined.",
    "linkConsequence": "The linked first footer row has no PDF annotation in the current output because its paint lands outside page2; Chromium retains one page1 annotation aligned with the visible row."
  },
  "rejectedApproaches": [
    "Resetting relative offset on continuation changes the browser-observed placement and leaves earlier missing lines on the wrong page.",
    "Moving normal-flow break offsets/height with paint changes sibling placement and authored keep semantics.",
    "Dropping sparse/painted pages hides the defect.",
    "A generic post-export text overlay loses scene/tag/clip/link ownership and cannot qualify the engine."
  ],
  "nextOwnerDeliverable": {
    "proposal": "Separate normal-flow fragment assignment from relative paint window projection. Preserve source-owned wrappers and clips; project cross-boundary relative paint to the physical page containing it without changing flow advancement.",
