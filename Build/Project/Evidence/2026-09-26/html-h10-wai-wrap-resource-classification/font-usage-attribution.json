    "resolver": "Returns the existing RobotoFlex fixture for /good.ttf and null for every other URI; no network.",
    "reproducer": "using System.Text.Json;\nusing OfficeIMO.Html;\n\nbyte[] font = File.ReadAllBytes(args[0]);\nvar results = new List<object>();\nforeach (var scenario in new[] {\n    (\"unused-family\", \"Good\", \"\"),\n    (\"unavailable-primary\", \"Missing,Good\", \"\"),\n    (\"unused-fallback\", \"Good,Missing\", \"\"),\n    (\"hidden-family\", \"Good\", \"<p style='display:none;font-family:Missing'>Hidden text</p>\")\n}) {\n    var options = new HtmlRenderOptions {\n        ResourceResolver = (request, token) => Task.FromResult<HtmlResolvedResource?>(\n            request.Uri.AbsolutePath == \"/good.ttf\" ? new HtmlResolvedResource(font, \"font/ttf\") : null)\n    };\n    var source = HtmlConversionDocument.Parse(\"<style>@font-face{font-family:Good;src:url(https://font.example/good.ttf)}\"\n        + \"@font-face{font-family:Missing;src:url(https://font.example/missing.ttf)}\"\n        + \"p{font-family:\" + scenario.Item2 + \"}</style><p>Visible text</p>\" + scenario.Item3);\n    HtmlRenderDocument rendered = await HtmlRenderEngine.RenderAsync(source, options);\n    results.Add(new { name=scenario.Item1, requestedFamilies=scenario.Item2, rendered.HasLoss,\n        text=rendered.Pages.SelectMany(p=>p.Visuals).OfType<HtmlRenderText>().Select(t=>new {t.Text,t.Font.FamilyName}),\n        diagnostics=rendered.Diagnostics });\n}\nawait File.WriteAllTextAsync(args[1], JsonSerializer.Serialize(new { sourceHead=args[2], results }, new JsonSerializerOptions {WriteIndented=true}));\nConsole.WriteLine(\"Four font-usage attribution cases completed.\");\n",
