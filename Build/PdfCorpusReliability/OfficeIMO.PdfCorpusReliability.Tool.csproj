<Project Sdk="Microsoft.NET.Sdk">
  <!-- Opt-in reliability runner for external PDF corpora. It is deliberately not part of OfficeIMO.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>OfficeIMO.PdfCorpusReliability</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../OfficeIMO.Pdf/OfficeIMO.Pdf.csproj" />
  </ItemGroup>
</Project>
