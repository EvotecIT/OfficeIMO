  ],
  "propertyRenames": [
    { "receiver": "OfficeIMO.Pdf.PdfTextRun", "old": "Strike", "new": "Strikethrough", "reason": "Align with the Strikethrough name used by the other text models; collides with the static PdfTextRun.Strikethrough(...) factory until the factories retire." },
    { "receiver": "*", "package": "OfficeIMO.Pdf", "old": "StrikeStyle", "new": "StrikethroughStyle", "reason": "Strikethrough terminology cleanup." },
    { "receiver": "*", "package": "OfficeIMO.PowerPoint", "old": "StrikeStyle", "new": "StrikethroughStyle", "reason": "Strikethrough terminology cleanup." }
  ],
  "retire": [
    { "receiver": "OfficeIMO.Excel.ExcelSheet", "member": "AddScatterChartFromRanges", "replacement": "AddChart(type, IEnumerable<ExcelChartSeriesRange>, options)", "reason": "Chart kinds, not methods (#3344 charts map)." },
    { "receiver": "OfficeIMO.Excel.ExcelSheet", "member": "AddBubbleChartFromRanges", "replacement": "AddChart(type, IEnumerable<ExcelChartSeriesRange>, options)", "reason": "Chart kinds, not methods (#3344 charts map)." },
    { "receiver": "OfficeIMO.Excel.ExcelSheet", "member": "AddWaterfallChart", "replacement": "AddChart(OfficeChartType.Waterfall, source, options)", "reason": "Chart kinds, not methods (#3344 charts map)." },
    { "receiver": "OfficeIMO.Excel.ExcelSheet", "member": "AddParetoChart", "replacement": "AddChart(OfficeChartType.Pareto, source, options)", "reason": "Chart kinds, not methods (#3344 charts map)." },
    { "receiver": "OfficeIMO.Excel.ExcelSheet", "member": "AddHistogramChart", "replacement": "AddChart(OfficeChartType.Histogram, source, options)", "reason": "Chart kinds, not methods (#3344 charts map)." },
    { "receiver": "OfficeIMO.Excel.ExcelSheet", "member": "AddFunnelChart", "replacement": "AddChart(OfficeChartType.Funnel, source, options)", "reason": "Chart kinds, not methods (#3344 charts map)." },
    { "receiver": "OfficeIMO.Excel.ExcelSheet", "member": "AddModernChart", "replacement": "AddChart(type, source, options)", "reason": "Chart kinds, not methods (#3344 charts map)." },
    { "receiver": "OfficeIMO.Word.WordDocument", "member": "AddComboChart", "replacement": "AddChart(type, source, options) with per-series chart types", "reason": "Combo becomes series with their own type on one chart (#3344 charts map)." },
    { "receiver": "OfficeIMO.Word.WordParagraph", "member": "AddComboChart", "replacement": "AddChart(type, source, options) with per-series chart types", "reason": "Combo becomes series with their own type on one chart (#3344 charts map)." }
  ],
  "decisions": [
    { "receiver": "OfficeIMO.Pdf.PdfTextRun", "members": [ "Bolded", "Italicized", "Underlined", "BoldUnderlined", "BoldItalic", "Strikethrough" ], "code": "pdf-run-factories", "proposal": "PdfTextRun.Create(text) followed by .Bold().Underline()", "reason": "Open #3344 decision: one primary PDF text-run creation path." },
    { "receiver": "OfficeIMO.Markdown.*", "members": [ "P", "Ul", "Ol" ], "code": "markdown-shorthand", "proposal": "Paragraph, BulletList, NumberedList", "reason": "Open #3344 decision: canonical Markdown content vocabulary and which shorthand (H1-H6) stays." },
    { "receiver": "OfficeIMO.Word.WordParagraph", "members": [ "AddText" ], "code": "word-run-type", "proposal": "AddText returns an attached WordTextRun handle", "reason": "Open #3344 decision: Word paragraph/run typing changes the return type." },
    { "receiver": "OfficeIMO.Word.WordDocument", "members": [ "AddChart" ], "code": "chart-entry-point", "proposal": "One AddChart(type, source, options?) per container; the empty AddChart(title, roundedCorners, width, height) retires", "reason": "#3344 charts map: one entry point per container." },
    { "receiver": "OfficeIMO.Excel.ExcelSheet", "members": [ "AddChart" ], "code": "chart-entry-point", "proposal": "One AddChart(type, source, options?) per container", "reason": "#3344 charts map: one entry point per container." },
    { "receiver": "OfficeIMO.OfficeConverter", "members": [ "Convert", "ConvertAsync" ], "code": "conversion-request", "proposal": "OfficeConverter.From(path).Theme(...).SaveAs(path) beside or instead of static Convert", "reason": "Open #3344 decision: does the static single-file Convert stay alongside the request?" }
  ],
