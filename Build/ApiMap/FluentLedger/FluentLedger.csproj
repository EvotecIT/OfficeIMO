<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" Private="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same metadata loader and source matcher as the public surface inventory. -->
    <Compile Include="../SurfaceAnalysis/MetadataCatalog.cs" Link="Shared/MetadataCatalog.cs" />
    <Compile Include="../SurfaceAnalysis/SourceLocationIndex.cs" Link="Shared/SourceLocationIndex.cs" />
  </ItemGroup>
</Project>
