{
  "area": "notebooks",
  "commands": [
    {
      "name": "Add-OfficeNotebookCell",
      "alias": null,
      "status": "new",
      "synopsis": "Appends a Markdown, code, or raw cell to a live notebook.",
      "outputType": "OfficeIMO.Notebook.NotebookCell",
      "parameterSets": [
        {
          "name": "__AllParameterSets",
          "parameters": [
            {
              "name": "Document",
              "type": "OfficeIMO.Notebook.NotebookDocument",
              "mandatory": true,
              "pipeline": "byValue"
            },
            {
              "name": "Kind",
              "type": "OfficeIMO.Notebook.NotebookCellKind",
              "mandatory": true,
              "position": 0
            },
            {
              "name": "Source",
              "type": "string",
              "mandatory": true,
              "position": 1
            },
            {
              "name": "Language",
              "type": "string",
              "mandatory": false
            },
            {
              "name": "PassThru",
              "type": "switch",
              "mandatory": false
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "Append a Markdown cell",
          "description": "Add notes to an open notebook.",
          "code": "$notebook | Add-OfficeNotebookCell Markdown '# Results'"
        },
        {
          "title": "Add a PowerShell code cell",
          "description": "Record source in a new notebook and save it.",
          "code": "$notebook = New-OfficeNotebook ./lab.ipynb\ntry {\n    $notebook | Add-OfficeNotebookCell Code 'Get-Date' -Language PowerShell\n    $notebook | Save-OfficeNotebook\n} finally {\n    $notebook | Close-OfficeNotebook\n}"
        }
      ]
    },
    {
      "name": "Add-OfficeNotebookOutput",
      "alias": null,
      "status": "new",
      "synopsis": "Attaches saved output or supplied console text to a code cell.",
      "outputType": "OfficeIMO.Notebook.NotebookCell",
      "parameterSets": [
        {
          "name": "Stream",
          "default": true,
          "parameters": [
            {
              "name": "Cell",
              "type": "OfficeIMO.Notebook.NotebookCell",
              "mandatory": true,
              "pipeline": "byValue"
            },
            {
              "name": "Stream",
              "type": "string",
              "mandatory": false
            },
            {
              "name": "Text",
              "type": "string",
              "mandatory": true
            },
            {
              "name": "PassThru",
              "type": "switch",
              "mandatory": false
            }
          ]
        },
        {
          "name": "Saved",
          "parameters": [
            {
              "name": "Cell",
              "type": "OfficeIMO.Notebook.NotebookCell",
              "mandatory": true,
              "pipeline": "byValue"
            },
            {
              "name": "Output",
              "type": "OfficeIMO.Notebook.NotebookOutput",
              "mandatory": true
            },
            {
              "name": "PassThru",
              "type": "switch",
              "mandatory": false
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "Attach console text",
          "description": "Record a saved stdout result for a code cell.",
          "code": "$cell | Add-OfficeNotebookOutput -Text 'Ready'"
        },
        {
          "title": "Save an explicit error stream",
          "description": "Save stderr separately from the code source.",
          "code": "$notebook = New-OfficeNotebook ./lab.ipynb\ntry {\n    $cell = $notebook | Add-OfficeNotebookCell Code 'Get-Date' -Language PowerShell -PassThru\n    $cell | Add-OfficeNotebookOutput -Stream stderr -Text 'No input records'\n    $notebook | Save-OfficeNotebook\n} finally {\n    $notebook | Close-OfficeNotebook\n}"
        }
      ]
    },
    {
      "name": "Clear-OfficeNotebookOutput",
      "alias": null,
      "status": "new",
      "synopsis": "Clears saved results from a code cell, optionally including its execution count.",
      "outputType": "OfficeIMO.Notebook.NotebookCell",
      "shouldProcess": true,
      "parameterSets": [
        {
          "name": "__AllParameterSets",
          "parameters": [
            {
              "name": "Cell",
              "type": "OfficeIMO.Notebook.NotebookCell",
              "mandatory": true,
              "pipeline": "byValue"
            },
            {
              "name": "ExecutionCount",
              "type": "switch",
              "mandatory": false
            },
            {
              "name": "PassThru",
              "type": "switch",
              "mandatory": false
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "Preview removing saved outputs",
          "description": "Identify the affected cell without changing it.",
          "code": "$cell | Clear-OfficeNotebookOutput -WhatIf"
        },
        {
          "title": "Reset saved results and the execution count",
          "description": "Clean a code cell and save a separate notebook.",
          "code": "$notebook = Open-OfficeNotebook ./analysis.ipynb\ntry {\n    $cell = $notebook | Get-OfficeNotebookCell -Index 0\n    $cell | Clear-OfficeNotebookOutput -ExecutionCount\n    $notebook | Save-OfficeNotebook ./clean.ipynb\n} finally {\n    $notebook | Close-OfficeNotebook\n}"
        }
      ]
    },
    {
      "name": "Close-OfficeNotebook",
      "alias": null,
      "status": "new",
      "synopsis": "Closes a notebook and releases its source-backed values without writing a file.",
      "outputType": "None",
      "parameterSets": [
        {
          "name": "__AllParameterSets",
          "parameters": [
            {
              "name": "Document",
              "type": "OfficeIMO.Notebook.NotebookDocument",
              "mandatory": true,
              "pipeline": "byValue"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "Release an open notebook",
          "description": "Close the live document after use.",
          "code": "$notebook | Close-OfficeNotebook"
        },
        {
          "title": "Release resources after inspection",
          "description": "Close the notebook even if cell inspection fails.",
          "code": "$notebook = Open-OfficeNotebook ./analysis.ipynb\ntry {\n    $notebook | Get-OfficeNotebookCell -Kind Code\n} finally {\n    $notebook | Close-OfficeNotebook\n}"
        }
      ]
    },
    {
