          "description": "Write a selected structured table from a saved notebook output.",
          "code": "$notebook = Open-OfficeNotebook ./analysis.ipynb\ntry {\n    $cell = $notebook | Get-OfficeNotebookCell -Index 0\n    $cell | Get-OfficeNotebookOutput -Index 0 | Export-OfficeNotebook ./results.xlsx\n} finally {\n    $notebook | Close-OfficeNotebook\n}"
        }
      ]
