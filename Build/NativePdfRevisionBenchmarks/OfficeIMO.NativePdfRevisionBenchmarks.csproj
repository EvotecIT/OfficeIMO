<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="itext" Version="9.7.0" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseBaseline)' != 'true'">
    <Reference Include="OfficeIMO.Pdf"><HintPath>$(NativePdfCurrentDirectory)/OfficeIMO.Pdf.dll</HintPath></Reference>
    <Reference Include="OfficeIMO.Core"><HintPath>$(NativePdfCurrentDirectory)/OfficeIMO.Core.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseBaseline)' == 'true'">
    <Reference Include="OfficeIMO.Pdf"><HintPath>$(NativePdfBaselineDirectory)/OfficeIMO.Pdf.dll</HintPath></Reference>
    <Reference Include="OfficeIMO.Core"><HintPath>$(NativePdfBaselineDirectory)/OfficeIMO.Core.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../OfficeIMO.Pdf.Benchmarks.Comparisons/PdfNativeOperationsBenchmarks.cs" />
    <Compile Include="../../OfficeIMO.Pdf.Benchmarks.Comparisons/PdfBenchmarkScenarios.cs" />
    <Compile Include="../../OfficeIMO.Pdf.Benchmarks.Comparisons/PdfBenchmarkValidation.cs" />
    <Compile Include="../../OfficeIMO.Pdf.Benchmarks.Comparisons/PdfManipulationValidation.cs" />
    <Compile Include="../../OfficeIMO.Pdf.Benchmarks.Comparisons/ITextPdfGenerator.cs" />
    <Compile Include="../../OfficeIMO.Pdf.Benchmarks.Comparisons/MigraDocPdfGenerator.cs" />
    <None Include="../../Website/Apps/OfficeIMO.Web.Converter/Assets/Fonts/Carlito-Regular.ttf" Link="Fonts/Carlito-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="System.Globalization" />
  </ItemGroup>
  <Target Name="ValidateRevisionInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(NativePdfBaselineDirectory)/OfficeIMO.Pdf.dll') Or !Exists('$(NativePdfBaselineDirectory)/OfficeIMO.Core.dll')" Text="Set NativePdfBaselineDirectory to the baseline net8.0 Release assembly directory." />
    <Error Condition="!Exists('$(NativePdfCurrentDirectory)/OfficeIMO.Pdf.dll') Or !Exists('$(NativePdfCurrentDirectory)/OfficeIMO.Core.dll')" Text="Set NativePdfCurrentDirectory to the current net8.0 Release assembly directory." />
  </Target>
</Project>


