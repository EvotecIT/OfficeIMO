<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <LangVersion>Latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="CsvHelper" Version="34.0.0" />
    <PackageReference Include="FourLambda.Csv" Version="1.1.0" />
    <PackageReference Include="Sep" Version="0.17.1" />
    <PackageReference Include="Sylvan.Data" Version="0.2.17" />
    <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
    <!-- Runtime APIs are benchmarked directly. The source generator targets a newer Roslyn than the repository SDK ships. -->
    <PackageReference Include="ExcelReader.NET" Version="7.5.0" ExcludeAssets="analyzers" Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\OfficeIMO.CSV\OfficeIMO.CSV.csproj" />
    <Compile Include="..\Benchmarks\BenchmarkProcessorAffinity.cs" Link="Shared\BenchmarkProcessorAffinity.cs" />
    <Compile Include="..\Benchmarks\BenchmarkProcessPriority.cs" Link="Shared\BenchmarkProcessPriority.cs" />
    <Compile Include="..\Benchmarks\MarkPflug65KFixture.cs" Link="Shared\MarkPflug65KFixture.cs" />
    <Compile Include="..\Benchmarks\CsvReadObservation.cs" Link="Shared\CsvReadObservation.cs" />
    <Compile Include="..\Benchmarks\CsvBenchmarkData.cs" Link="Shared\CsvBenchmarkData.cs" />
    <Compile Include="..\Benchmarks\PackageAssetsCsvFixture.cs" Link="Shared\PackageAssetsCsvFixture.cs" />
    <Compile Include="..\Benchmarks\SalesMappingFixture.cs" Link="Shared\SalesMappingFixture.cs" />
  </ItemGroup>
  <Target Name="RemoveIncompatibleExcelReaderGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="$(NuGetPackageRoot)excelreader.net\7.5.0\analyzers\dotnet\cs\ExcelReader.Generator.dll" />
    </ItemGroup>
  </Target>
</Project>
