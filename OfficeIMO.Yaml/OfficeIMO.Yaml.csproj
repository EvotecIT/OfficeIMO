<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A dependency-free YAML 1.2 engine for OfficeIMO: a lossless document model that saves unchanged input byte for byte, a low-allocation pull reader with schema-aware scalar resolution, and an object serializer with a NativeAOT source generator.</Description>

    <VersionPrefix>3.6.0</VersionPrefix>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0;net472</TargetFrameworks>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>

    <PackageTags>yaml;yml;parser;reader;netstandard2.0;net8.0;net10.0;aot</PackageTags>
    <PackageProjectUrl>https://github.com/EvotecIT/OfficeIMO</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <DelaySign>False</DelaySign>
    <IsPublishable>True</IsPublishable>
    <Copyright>(c) 2011 - 2025 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
    <PackageIcon>OfficeIMO.png</PackageIcon>
    <RepositoryUrl>https://github.com/EvotecIT/OfficeIMO</RepositoryUrl>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <SignAssembly>False</SignAssembly>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <LangVersion>Latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\\Assets\\OfficeIMO.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>README.md</PackagePath>
    </None>
    <None Include="buildTransitive\OfficeIMO.Yaml.targets" Pack="true" PackagePath="buildTransitive\OfficeIMO.Yaml.targets" />
    <None Include="buildTransitive\OfficeIMO.Yaml.targets" Pack="true" PackagePath="build\OfficeIMO.Yaml.targets" />
  </ItemGroup>

  <!-- The serializer's source generator ships in this package as an analyzer, so it always matches the runtime. -->
  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.Yaml.SourceGeneration\OfficeIMO.Yaml.SourceGeneration.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackYamlSourceGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\OfficeIMO.Yaml.SourceGeneration\OfficeIMO.Yaml.SourceGeneration.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_OfficeIMOYamlGenerator" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_OfficeIMOYamlGenerator)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Using Include="System.Buffers" />
    <Using Include="System.Globalization" />
    <Using Include="System.Text" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\OfficeIMO.SharedSource\IO\PooledUtf8TextWriter*.cs" Link="SharedSource\IO\%(Filename)%(Extension)" />
    <!-- The reflection shape rules TomlSerializer applies too. -->
    <Compile Include="..\OfficeIMO.SharedSource\Serialization\*.cs" Link="SharedSource\Serialization\%(Filename)%(Extension)" />
    <ProjectReference Include="..\OfficeIMO.Core\OfficeIMO.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OfficeIMO.Yaml.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Reader.Yaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
