+static void office_trace_coeff(const MACROBLOCKD *xd, int plane, int row, int col,
+                                TX_SIZE size, TX_TYPE type, int eob, const int *q) {
+  int subx = plane ? xd->plane[plane].subsampling_x : 0;
+  int suby = plane ? xd->plane[plane].subsampling_y : 0;
+  int w = get_txb_wide(size), h = get_txb_high(size);
+  fprintf(stderr, "{\"event\":\"residual\",\"block\":[%d,%d,%d,%d],\"type\":%d,\"eob\":%d,\"values\":[",
+      plane, ((xd->mi_col >> subx)+col)*4, ((xd->mi_row >> suby)+row)*4, size, type, eob);
+  for(int y=0; y<h; y++) for(int x=0; x<w; x++)
+      fprintf(stderr, "%s%d", (x || y)?",":"", q[x*h+y]);
+  fprintf(stderr, "]}\n");
+}
