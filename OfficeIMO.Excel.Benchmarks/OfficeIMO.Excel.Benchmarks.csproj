<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <LangVersion>Latest</LangVersion>
    <IsPackable>false</IsPackable>
    <ExcelReaderBenchmarkVersion Condition="'$(TargetFramework)' == 'net8.0'">3.1.0</ExcelReaderBenchmarkVersion>
    <ExcelReaderBenchmarkVersion Condition="'$(TargetFramework)' != 'net8.0'">7.5.0</ExcelReaderBenchmarkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Excel-PRIME" Version="5.2610.18" />
    <PackageReference Include="HypeLab.IO.Excel" Version="1.0.7" />
    <!-- Runtime APIs are benchmarked directly. The source generator targets a newer Roslyn than the repository SDK ships. -->
    <PackageReference Include="ExcelReader.NET" Version="$(ExcelReaderBenchmarkVersion)" ExcludeAssets="analyzers" />
    <PackageReference Include="ExcelReader.Arrow" Version="$(ExcelReaderBenchmarkVersion)" />
    <PackageReference Include="EPPlus" Version="8.7.2" />
    <PackageReference Include="LargeXlsx" Version="2.0.2" />
    <PackageReference Include="MiniExcel" Version="1.46.0" />
    <PackageReference Include="SpreadCheetah" Version="1.28.0" />
    <PackageReference Include="Sylvan.Data.Excel" Version="0.5.8" />
    <PackageReference Include="XLibur.Bundle" Version="0.800.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.Data.Arrow\OfficeIMO.Data.Arrow.csproj" />
    <ProjectReference Include="..\OfficeIMO.Excel\OfficeIMO.Excel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Benchmarks\BenchmarkProcessorAffinity.cs" Link="Shared\BenchmarkProcessorAffinity.cs" />
    <Compile Include="..\Benchmarks\BenchmarkProcessPriority.cs" Link="Shared\BenchmarkProcessPriority.cs" />
    <Compile Include="..\Benchmarks\MarkPflug65KFixture.cs" Link="Shared\MarkPflug65KFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="XlBenchShapes\sales_template.xlsx" LogicalName="XlBenchShapes.sales_template.xlsx" />
  </ItemGroup>

  <Target Name="RemoveIncompatibleExcelReaderGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="$(NuGetPackageRoot)excelreader.net\$(ExcelReaderBenchmarkVersion)\analyzers\dotnet\cs\ExcelReader.Generator.dll" />
    </ItemGroup>
  </Target>

</Project>
