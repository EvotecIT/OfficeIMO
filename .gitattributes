###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto
OfficeIMO.Studio.Tests/Run-StorageAcceptance.sh text eol=lf

# Preserve the unmodified upstream framework fixture bytes on every platform.
OfficeIMO.Html.Runtime.Tests/Fixtures/Preact/*.umd.js -text
OfficeIMO.Html.Runtime.Tests/Fixtures/Preact/LICENSE -text
OfficeIMO.Html.Runtime.Tests/Fixtures/React18/*.min.js -text
OfficeIMO.Html.Runtime.Tests/Fixtures/React18/LICENSE -text

# The React acceptance PDFs are retained byte-for-byte for independent viewing.
Build/Project/Evidence/2026-09-16/html-react-application/*.pdf -text -diff
Build/Project/Evidence/2026-09-16/html-four-application-workflow/*/*.pdf -text -diff
Build/Project/Evidence/2026-09-16/html-public-oci-pilot/*/*.pdf -text -diff
Build/Project/Evidence/2026-09-16/html-public-oci-pilot/*/response.html -text -diff
Build/Project/Evidence/2026-09-18/html-isolated-public-profile/**/*.pdf -text -diff
Build/Project/Evidence/2026-09-18/html-isolated-public-profile/**/*.png -text -diff

# RTF interoperability fixtures are byte-level evidence. Do not normalize their
# producer line endings, because corpus SHA-256 checks must match on every OS.
OfficeIMO.Rtf.Tests/Documents/RtfCorpus/**/*.rtf -text -diff

# Public showcase downloads are generated binary evidence. Preserve exact bytes
# so the committed manifest hashes remain stable across platforms and checkouts.
Website/static/downloads/showcase/** -text -diff

# Published benchmark payloads are integrity-checked byte-for-byte against the
# catalog. Keep their committed line endings unchanged on every platform.
Website/static/data/benchmarks/library-comparisons/*.json text eol=lf -diff

# Corpus publication hashes identify the original runner report bytes. Preserve
# them exactly, including the measured producer's line endings, on every OS.
Website/data/pdf_corpus_report.json -text -diff

# The HTML qualification corpus validates every source byte against its manifest.
# Preserve exact fixture bytes across Windows, Linux, and macOS checkouts.
OfficeIMO.TestAssets/Documents/Html/Qualification/H0/baseline-report/** text eol=lf -diff
OfficeIMO.TestAssets/Documents/Html/Qualification/H0/baseline-report/**/*.otf -text -diff
OfficeIMO.TestAssets/Documents/Html/Qualification/H4/** text eol=lf -diff

###############################################################################
# Set default behavior for command prompt diff.
#
# This is need for earlier builds of msysgit that does not have it on by
# default for csharp files.
# Note: This is only used by command line
###############################################################################
#*.cs     diff=csharp

###############################################################################
# Set the merge driver for project and solution files
#
# Merging from the command prompt will add diff markers to the files if there
# are conflicts (Merging from VS is not affected by the settings below, in VS
# the diff markers are never inserted). Diff markers may cause the following 
# file extensions to fail to load in VS. An alternative would be to treat
# these files as binary and thus will always conflict and require user
# intervention with every merge. To do so, just uncomment the entries below
###############################################################################
#*.sln       merge=binary
#*.csproj    merge=binary
#*.vbproj    merge=binary
#*.vcxproj   merge=binary
#*.vcproj    merge=binary
#*.dbproj    merge=binary
#*.fsproj    merge=binary
#*.lsproj    merge=binary
#*.wixproj   merge=binary
#*.modelproj merge=binary
#*.sqlproj   merge=binary
#*.wwaproj   merge=binary

###############################################################################
# behavior for image files
#
# image files are treated as binary by default.
###############################################################################
#*.jpg   binary
#*.png   binary
#*.gif   binary

###############################################################################
# diff behavior for common document formats
# 
# Convert binary document formats to text before diffing them. This feature
# is only available from the command line. Turn it on by uncommenting the 
# entries below.
###############################################################################
#*.doc   diff=astextplain
#*.DOC   diff=astextplain
#*.docx  diff=astextplain
#*.DOCX  diff=astextplain
#*.dot   diff=astextplain
#*.DOT   diff=astextplain
#*.pdf   diff=astextplain
#*.PDF   diff=astextplain
#*.rtf   diff=astextplain
#*.RTF   diff=astextplain

# Preserve unmodified upstream invoice fixtures and Schematron compiler bytes.
OfficeIMO.Invoicing.Validation/Compiler/*.xsl -text -diff
OfficeIMO.Invoicing.Tests/Fixtures/KoSIT/*.xml -text -diff
OfficeIMO.Invoicing.Tests/Fixtures/KoSIT/LICENSE.txt -text -diff
OfficeIMO.Html.Runtime.Tests/Fixtures/ReactBuild/dist/*.js -text -diff
Build/Project/Evidence/2026-09-16/html-public-discovery-pilot/**/*.pdf -text -diff
Build/Project/Evidence/2026-09-16/html-public-discovery-pilot/**/*.png -text -diff
