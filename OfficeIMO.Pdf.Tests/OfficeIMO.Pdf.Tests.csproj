<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' ">
      $(TargetFrameworks);net472
    </TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PdfPerformanceEvidence)' == 'true'">
    <DefineConstants>$(DefineConstants);PDF_PERFORMANCE_EVIDENCE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\OfficeIMO.TestAssets\RepositoryTestPaths.cs" Link="Shared\RepositoryTestPaths.cs" />
    <ProjectReference Include="..\OfficeIMO.AsciiDoc.Pdf\OfficeIMO.AsciiDoc.Pdf.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.Core\OfficeIMO.Core.csproj" />
    <ProjectReference Include="..\OfficeIMO.Excel\OfficeIMO.Excel.csproj" />
    <ProjectReference Include="..\OfficeIMO.Excel.Pdf\OfficeIMO.Excel.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Html.Pdf\OfficeIMO.Html.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Latex.Pdf\OfficeIMO.Latex.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Markdown\OfficeIMO.Markdown.csproj" />
    <ProjectReference Include="..\OfficeIMO.Markdown.Html\OfficeIMO.Markdown.Html.csproj" />
    <ProjectReference Include="..\OfficeIMO.Markdown.Pdf\OfficeIMO.Markdown.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Mhtml\OfficeIMO.Mhtml.csproj" />
    <ProjectReference Include="..\OfficeIMO.Mhtml.Pdf\OfficeIMO.Mhtml.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.OneNote\OfficeIMO.OneNote.csproj" />
    <ProjectReference Include="..\OfficeIMO.OneNote.Pdf\OfficeIMO.OneNote.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.OpenDocument.Odp.Pdf\OfficeIMO.OpenDocument.Odp.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.OpenDocument.Ods.Pdf\OfficeIMO.OpenDocument.Ods.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.OpenDocument.Odt.Pdf\OfficeIMO.OpenDocument.Odt.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Ocr\OfficeIMO.Ocr.csproj" />
    <ProjectReference Include="..\OfficeIMO.Pdf\OfficeIMO.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Pdf.Ocr\OfficeIMO.Pdf.Ocr.csproj" />
    <ProjectReference Include="..\OfficeIMO.Ocr.Tesseract\OfficeIMO.Ocr.Tesseract.csproj" />
    <ProjectReference Include="..\OfficeIMO.Security\OfficeIMO.Security.csproj" />
    <ProjectReference Include="..\OfficeIMO.PowerPoint\OfficeIMO.PowerPoint.csproj" />
    <ProjectReference Include="..\OfficeIMO.PowerPoint.Pdf\OfficeIMO.PowerPoint.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Reader.Core\OfficeIMO.Reader.Core.csproj" />
    <ProjectReference Include="..\OfficeIMO.Reader.Ocr\OfficeIMO.Reader.Ocr.csproj" />
    <ProjectReference Include="..\OfficeIMO.Reader.Pdf\OfficeIMO.Reader.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Rtf.Pdf\OfficeIMO.Rtf.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Word\OfficeIMO.Word.csproj" />
    <ProjectReference Include="..\OfficeIMO.Word.Html\OfficeIMO.Word.Html.csproj" />
    <ProjectReference Include="..\OfficeIMO.Word.Pdf\OfficeIMO.Word.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Visio\OfficeIMO.Visio.csproj" />
    <ProjectReference Include="..\OfficeIMO.Visio.Pdf\OfficeIMO.Visio.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\OfficeIMO.TestAssets\HtmlRenderingCorpus.cs" Link="Shared\HtmlRenderingCorpus.cs" />
    <Compile Include="..\OfficeIMO.TestAssets\SparseAnnotationTestSource.cs" Link="Shared\SparseAnnotationTestSource.cs" />
    <Compile Include="..\OfficeIMO.TestAssets\VisualBaselineTestSupport.cs" Link="Shared\VisualBaselineTestSupport.cs" />
    <Compile Include="..\OfficeIMO.TestAssets\ManagedTextShapingTestAssets.cs" Link="Shared\ManagedTextShapingTestAssets.cs" />
    <Compile Include="..\OfficeIMO.TestAssets\ManagedTextShapingTestAssets.Tracking.cs" Link="Shared\ManagedTextShapingTestAssets.Tracking.cs" />
    <Compile Include="..\OfficeIMO.TestAssets\ManagedTextShapingTestAssets.LookupScenarios.cs" Link="Shared\ManagedTextShapingTestAssets.LookupScenarios.cs" />
    <Compile Include="..\OfficeIMO.TestAssets\TypographyEvidenceCorpus.cs" Link="Shared\TypographyEvidenceCorpus.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Pdf\Fixtures\Interoperability\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Pdf\Fixtures\Rendering\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Pdf\Fixtures\Fonts\SourceSerif4-Regular.otf" Link="OfficeIMO.Pdf.Tests\Pdf\Fixtures\Fonts\SourceSerif4-Regular.otf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Website\Apps\OfficeIMO.Web.Converter\Assets\Fonts\Carlito-Regular.ttf" Link="Typography\Carlito-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OfficeIMO.TestAssets\Fonts\OfficeIMOBaselineSans-Regular.ttf" Link="Typography\OfficeIMOBaselineSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OfficeIMO.TestAssets\PdfEditing\source-font-*.pdf" Link="PdfEditing\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Website\Apps\OfficeIMO.Web.Converter\Assets\Fonts\NotoSansArabic-Regular.ttf" Link="Typography\NotoSansArabic-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OfficeIMO.Drawing.Tests\TestAssets\NotoSansDevanagari-Regular.ttf" Link="Typography\NotoSansDevanagari-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OfficeIMO.Drawing.Tests\TestAssets\NotoSansSC-BaselineSubset.ttf" Link="Typography\NotoSansSC-BaselineSubset.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OfficeIMO.Drawing.Tests\TestAssets\NotoEmoji-VariableFont_wght.ttf" Link="Typography\NotoEmoji-VariableFont_wght.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\OfficeIMO.TestAssets\Images\**" Link="Images\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OfficeIMO.TestAssets\EnglishLayout\*-scan.png;..\OfficeIMO.TestAssets\EnglishLayout\*-provider.tsv;..\OfficeIMO.TestAssets\EnglishLayout\manifest.json" Link="EnglishLayout\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OfficeIMO.TestAssets\ScanQuality\phototest-skew.pdf" Link="ScanQuality\phototest-skew.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OfficeIMO.TestAssets\MultilingualLayout\*-native.pdf;..\OfficeIMO.TestAssets\MultilingualLayout\manifest.json" Link="MultilingualLayout\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Text" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Collections" />
    <Using Include="System.Linq" />
    <Using Include="System.IO" />
  </ItemGroup>

  <PropertyGroup Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' == 'false' ">
    <RestoreAdditionalProjectFallbackFolders></RestoreAdditionalProjectFallbackFolders>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../OfficeIMO.Drawing.Tests/TestAssets/TiffJpegLossless16/p1-d1-l4-t1-s1-r0-a1.tif.jpg" Link="TestAssets/Lossless16.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../OfficeIMO.Drawing.Tests/TestAssets/TiffJpegLossless/edges/h2-v2-w5-h3-s0.jpg" Link="TestAssets/Lossless8.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../OfficeIMO.Drawing.Tests/TestAssets/JpegArithmeticColor/b8-*.jpg;../OfficeIMO.Drawing.Tests/TestAssets/JpegArithmeticColor/b8-*.pdf-*.srgb" Link="TestAssets/JpegArithmeticColor/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../OfficeIMO.Drawing.Tests/TestAssets/IccColorCorpus/littlecms-cmyk-lut.icc" Link="TestAssets/JpegArithmeticColor/profile.icc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
