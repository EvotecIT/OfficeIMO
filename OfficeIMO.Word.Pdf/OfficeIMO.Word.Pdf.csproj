<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>PDF converter for OfficeIMO.Word - Export Word documents to PDF using the first-party OfficeIMO.Pdf engine.</Description>
    <PackageId>OfficeIMO.Word.Pdf</PackageId>
    <AssemblyName>OfficeIMO.Word.Pdf</AssemblyName>
    <AssemblyTitle>OfficeIMO.Word.Pdf</AssemblyTitle>
    <VersionPrefix>3.5.3</VersionPrefix>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' ">$(TargetFrameworks);net472</TargetFrameworks>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <PackageTags>pdf;openxml;office;docx;officeimo-pdf</PackageTags>
    <PackageProjectUrl>https://github.com/EvotecIT/OfficeIMO</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/EvotecIT/OfficeIMO</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>OfficeIMO.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>Latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\Assets\OfficeIMO.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>README.md</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.Word\OfficeIMO.Word.csproj" />
    <ProjectReference Include="..\OfficeIMO.Pdf\OfficeIMO.Pdf.csproj" />
    <ProjectReference Include="..\OfficeIMO.Core\OfficeIMO.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OfficeIMO.Word.Tests" />
    <InternalsVisibleTo Include="OfficeIMO.Pdf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Text" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Collections" />
    <Using Include="OfficeIMO.Drawing" />
    <Using Include="OfficeIMO.OpenXml.Internal" />
    <Using Include="DocumentFormat.OpenXml" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="OfficeIMO.OpenDocument.Odt.Pdf" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="OfficeIMO.Workflows" /><InternalsVisibleTo Include="PSWriteOffice" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="OfficeIMO.Workflows.IWork" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="OfficeIMO.Rtf.Tests" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="OfficeIMO.Web.Converter" /><InternalsVisibleTo Include="OfficeIMO.Web.Converter.Tests" /></ItemGroup>
</Project>
