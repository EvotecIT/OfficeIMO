<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>Latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Comparison libraries stay in this opt-in project; OfficeIMO runtime projects never reference them. -->
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The independent-reader check reads the same pinned suites as the tests. -->
    <Compile Include="..\OfficeIMO.TestAssets\RepositoryTestPaths.cs" Link="Shared\RepositoryTestPaths.cs" />
    <Compile Include="..\OfficeIMO.Yaml.Tests\Conformance\YamlTestSuite.cs" Link="Shared\Yaml\YamlTestSuite.cs" />
    <Compile Include="..\OfficeIMO.Yaml.Tests\Conformance\YamlJsonReader.cs" Link="Shared\Yaml\YamlJsonReader.cs" />
    <Compile Include="..\OfficeIMO.Yaml.Tests\Conformance\YamlConformanceNode.cs" Link="Shared\Yaml\YamlConformanceNode.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeIMO.Data.Conversions\OfficeIMO.Data.Conversions.csproj" />
  </ItemGroup>
</Project>
