                                    }
                                    $PowerForgeAcceleratorOwners.Remove($Owned.Key)
                                }
                            }
                            $RegisteredPowerForgeTypeAccelerators.Clear()
                        } finally {
                            [Threading.Monitor]::Exit($PowerForgeAcceleratorOwnersSyncRoot)
                        }
                    }.GetNewClosure()


