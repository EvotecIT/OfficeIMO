<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- PowerShell 7.6 ships only net10 reference assets; these net8 tests use the current net8 servicing line. -->
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.22" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PSWriteOffice\PSWriteOffice.csproj" />
    <Compile Include="..\..\..\..\OfficeIMO.Chm.Tests\ChmFixture.cs" Link="Fixtures\ChmFixture.cs" />
  </ItemGroup>

  <!-- Downloaded only for the isolated PowerShell conflict test; never referenced or copied to product output. -->
  <ItemGroup>
    <PackageDownload Include="DocumentFormat.OpenXml" Version="[3.1.1]" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
