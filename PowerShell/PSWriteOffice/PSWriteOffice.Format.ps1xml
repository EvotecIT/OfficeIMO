<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>OfficeIMO.OfficeConversionReport</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.OfficeConversionReport</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Source</Label></TableColumnHeader>
          <TableColumnHeader><Label>Target</Label></TableColumnHeader>
          <TableColumnHeader><Label>ItemsWritten</Label></TableColumnHeader>
          <TableColumnHeader><Label>Elapsed</Label></TableColumnHeader>
          <TableColumnHeader><Label>HasLoss</Label></TableColumnHeader>
          <TableColumnHeader><Label>OutputPath</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Source</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Target</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ItemsWritten</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Elapsed</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>HasLoss</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>OutputPath</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.OfficeDiagnostic</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.OfficeDiagnostic</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Severity</Label></TableColumnHeader>
          <TableColumnHeader><Label>Code</Label></TableColumnHeader>
          <TableColumnHeader><Label>Message</Label></TableColumnHeader>
          <TableColumnHeader><Label>Location</Label></TableColumnHeader>
          <TableColumnHeader><Label>Format</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Severity</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Code</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Message</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Location</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Format</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.OfficeLength</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.OfficeLength</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Length</Label></TableColumnHeader>
          <TableColumnHeader><Label>Points</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><ScriptBlock>$_.ToString()</ScriptBlock></TableColumnItem>
          <TableColumnItem><ScriptBlock>$_.ToPoints()</ScriptBlock></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.OfficeTheme</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.OfficeTheme</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>HeadingFont</Label></TableColumnHeader>
          <TableColumnHeader><Label>BodyFont</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
          <TableColumnItem><ScriptBlock>$_.Fonts.Heading.Family</ScriptBlock></TableColumnItem>
          <TableColumnItem><ScriptBlock>$_.Fonts.Body.Family</ScriptBlock></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.Drawing.OfficeImageExportResult</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.Drawing.OfficeImageExportResult</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Format</Label></TableColumnHeader>
          <TableColumnHeader><Label>Width</Label></TableColumnHeader>
          <TableColumnHeader><Label>Height</Label></TableColumnHeader>
          <TableColumnHeader><Label>SavedPath</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Format</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Width</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Height</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>SavedPath</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.Word.WordDocument</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.Word.WordDocument</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>FilePath</Label></TableColumnHeader>
          <TableColumnHeader><Label>Paragraphs</Label></TableColumnHeader>
          <TableColumnHeader><Label>Tables</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>FilePath</PropertyName></TableColumnItem>
          <TableColumnItem><ScriptBlock>$_.Paragraphs.Count</ScriptBlock></TableColumnItem>
          <TableColumnItem><ScriptBlock>$_.Tables.Count</ScriptBlock></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.Excel.ExcelDocument</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.Excel.ExcelDocument</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>FilePath</Label></TableColumnHeader>
          <TableColumnHeader><Label>Sheets</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>FilePath</PropertyName></TableColumnItem>
          <TableColumnItem><ScriptBlock>$_.Sheets.Count</ScriptBlock></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.PowerPoint.PowerPointPresentation</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.PowerPoint.PowerPointPresentation</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>FilePath</Label></TableColumnHeader>
          <TableColumnHeader><Label>Slides</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>FilePath</PropertyName></TableColumnItem>
          <TableColumnItem><ScriptBlock>$_.Slides.Count</ScriptBlock></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.Pdf.PdfDocument</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.Pdf.PdfDocument</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Document</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><ScriptBlock>'PDF document'</ScriptBlock></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.Excel.ExcelSheet</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.Excel.ExcelSheet</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.PowerPoint.PowerPointSlide</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.PowerPoint.PowerPointSlide</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Position</Label></TableColumnHeader>
          <TableColumnHeader><Label>Tables</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><ScriptBlock>$_.Index + 1</ScriptBlock></TableColumnItem>
          <TableColumnItem><ScriptBlock>@($_.Tables).Count</ScriptBlock></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.Word.WordParagraph</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.Word.WordParagraph</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Text</Label></TableColumnHeader>
          <TableColumnHeader><Label>Style</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Text</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Style</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.Word.WordTable</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.Word.WordTable</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Rows</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><ScriptBlock>$_.Rows.Count</ScriptBlock></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.Excel.ExcelTable</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.Excel.ExcelTable</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>NameOrRange</Label></TableColumnHeader>
          <TableColumnHeader><Label>Range</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>NameOrRange</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Range</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.PowerPoint.PowerPointTable</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.PowerPoint.PowerPointTable</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Rows</Label></TableColumnHeader>
          <TableColumnHeader><Label>Columns</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Rows</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Columns</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>OfficeIMO.PowerPoint.PowerPointParagraph</Name>
      <ViewSelectedBy><TypeName>OfficeIMO.PowerPoint.PowerPointParagraph</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Text</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Text</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
