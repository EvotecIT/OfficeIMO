@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div class="panel editor-panel">
    <div class="panel-heading"><div><p>SOURCE</p><h2>HTML + CSS</h2></div><span>@((Html.Length + Css.Length).ToString("N0")) / @HtmlPdfWorkbenchConversionService.MaximumInputCharacters.ToString("N0") chars</span></div>
    <label class="field"><span>Template</span><select value="@SelectedTemplateId" @onchange="SelectTemplate">@foreach (HtmlPdfWorkbenchTemplate template in Templates) { <option value="@template.Id">@template.Name — @template.Description</option> }</select></label>
    <div class="editor-tabs" role="group" aria-label="Editor tabs">
        <button type="button" class="@(_showCss ? null : "active")" @onclick="() => _showCss = false">HTML</button>
        <button type="button" class="@(_showCss ? "active" : null)" @onclick="() => _showCss = true">CSS</button>
    </div>
    <textarea @ref="_htmlEditor" class="code-editor" hidden="@_showCss" aria-label="HTML source" maxlength="@HtmlPdfWorkbenchConversionService.MaximumInputCharacters" value="@Html" spellcheck="false"></textarea>
    <textarea @ref="_cssEditor" class="code-editor" hidden="@(!_showCss)" aria-label="CSS source" maxlength="@HtmlPdfWorkbenchConversionService.MaximumInputCharacters" value="@Css" spellcheck="false"></textarea>
</div>

@code {
    private const int ReadChunkCharacters = 4096;
    private bool _showCss;
    private ElementReference _htmlEditor;
    private ElementReference _cssEditor;
    private IJSObjectReference? _module;
    private DotNetObjectReference<HtmlPdfEditor>? _selfReference;
    private CancellationTokenSource? _debounce;
    private long _inputRevision;
    private string? _appliedHtml;
    private string? _appliedCss;
    [Parameter, EditorRequired] public IReadOnlyList<HtmlPdfWorkbenchTemplate> Templates { get; set; } = Array.Empty<HtmlPdfWorkbenchTemplate>();
    [Parameter, EditorRequired] public string SelectedTemplateId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public EventCallback<string> SelectedTemplateIdChanged { get; set; }
    [Parameter, EditorRequired] public string Html { get; set; } = string.Empty;
    [Parameter, EditorRequired] public EventCallback<string> HtmlChanged { get; set; }
    [Parameter, EditorRequired] public string Css { get; set; } = string.Empty;
    [Parameter, EditorRequired] public EventCallback<string> CssChanged { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private Task SelectTemplate(ChangeEventArgs args) => SelectedTemplateIdChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./workbench-editor.js");
            _selfReference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("bind", _htmlEditor, "html", _selfReference);
            await _module.InvokeVoidAsync("bind", _cssEditor, "css", _selfReference);
        }

        if (_module is null) return;
        if (!string.Equals(_appliedHtml, Html, StringComparison.Ordinal)) {
            await _module.InvokeVoidAsync("setValue", _htmlEditor, Html);
            _appliedHtml = Html;
        }
        if (!string.Equals(_appliedCss, Css, StringComparison.Ordinal)) {
            await _module.InvokeVoidAsync("setValue", _cssEditor, Css);
            _appliedCss = Css;
        }
    }

    [JSInvokable]
    public async Task NotifyInput(string kind) {
        long revision = Interlocked.Increment(ref _inputRevision);
        _debounce?.Cancel();
        _debounce?.Dispose();
        var debounce = new CancellationTokenSource();
        _debounce = debounce;
        await Changed.InvokeAsync();
        try {
            await Task.Delay(250, debounce.Token);
            if (revision == Volatile.Read(ref _inputRevision)) await SynchronizeAsync(kind, debounce.Token);
        } catch (OperationCanceledException) when (debounce.IsCancellationRequested) {
        }
    }

    public async Task<(string Html, string Css)> FlushAsync() {
        Interlocked.Increment(ref _inputRevision);
        _debounce?.Cancel();
        if (_module is null) return (Html, Css);
        string html = await ReadValueAsync(_htmlEditor, CancellationToken.None);
        string css = await ReadValueAsync(_cssEditor, CancellationToken.None);
        _appliedHtml = html;
        _appliedCss = css;
        return (html, css);
    }

    private async Task SynchronizeAsync(string kind, CancellationToken cancellationToken) {
        if (_module is null) return;
        if (string.Equals(kind, "html", StringComparison.Ordinal)) {
            string html = await ReadValueAsync(_htmlEditor, cancellationToken);
            _appliedHtml = html;
            await HtmlChanged.InvokeAsync(html);
        } else if (string.Equals(kind, "css", StringComparison.Ordinal)) {
            string css = await ReadValueAsync(_cssEditor, cancellationToken);
            _appliedCss = css;
            await CssChanged.InvokeAsync(css);
        }
    }

    private async Task<string> ReadValueAsync(ElementReference editor, CancellationToken cancellationToken) {
        IJSObjectReference module = _module ?? throw new InvalidOperationException("The editor is not connected.");
        EditorSnapshot snapshot = await module.InvokeAsync<EditorSnapshot>("beginRead", cancellationToken, editor);
        try {
            if (snapshot.Length > HtmlPdfWorkbenchConversionService.MaximumInputCharacters) {
                throw new InvalidOperationException("Editor input exceeds the workbench limit.");
            }
            var value = new System.Text.StringBuilder(snapshot.Length);
            for (int offset = 0; offset < snapshot.Length; offset += ReadChunkCharacters) {
                value.Append(await module.InvokeAsync<string>(
                    "readSlice",
                    cancellationToken,
                    snapshot.Id,
                    offset,
                    Math.Min(ReadChunkCharacters, snapshot.Length - offset)));
            }
            return value.ToString();
        } finally {
            await module.InvokeVoidAsync("releaseRead", snapshot.Id);
        }
    }

    private sealed class EditorSnapshot {
        public string Id { get; set; } = string.Empty;
        public int Length { get; set; }
    }

    public async ValueTask DisposeAsync() {
        _debounce?.Cancel();
        _debounce?.Dispose();
        if (_module is not null) {
            try {
                await _module.InvokeVoidAsync("unbind", _htmlEditor);
                await _module.InvokeVoidAsync("unbind", _cssEditor);
                await _module.DisposeAsync();
            } catch (JSDisconnectedException) {
            }
        }
        _selfReference?.Dispose();
    }
}
