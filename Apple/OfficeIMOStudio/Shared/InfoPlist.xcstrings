    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OfficeIMO Studio verwendet die Kamera, um Papierdokumente als PDF zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OfficeIMO Studio uses the camera to scan paper documents into PDFs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OfficeIMO Studio usa la cámara para escanear documentos en papel como PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OfficeIMO Studio utilise l’appareil photo pour numériser des documents papier en PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OfficeIMO Studio usa la fotocamera per scansionare documenti cartacei in PDF."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OfficeIMO Studio używa aparatu do skanowania papierowych dokumentów do plików PDF."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O OfficeIMO Studio usa a câmera para digitalizar documentos em papel como PDFs."
