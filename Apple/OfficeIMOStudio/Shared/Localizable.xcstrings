        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le caviardage supprime le texte, les images et les dessins sous chaque correspondance et les recouvre de noir. Sélectionnez du texte sur une page pour ne caviarder que celui-ci."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utajnienie usuwa tekst, obrazy i rysunki pod każdym dopasowaniem i zakrywa je na czarno. Aby utajnić tylko fragment, zaznacz tekst na stronie."
