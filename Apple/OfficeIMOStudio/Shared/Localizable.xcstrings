    "Makes %lld PDFs in a folder you choose. This document stays as it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt %lld PDFs in einem Ordner deiner Wahl. Dieses Dokument bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea %lld PDF en la carpeta que elija. Este documento permanece sin cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée %lld PDF dans le dossier de votre choix. Ce document reste inchangé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea %lld PDF in una cartella a tua scelta. Questo documento resta invariato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzy pliki PDF (%lld) w wybranym folderze. Ten dokument pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria %lld PDFs em uma pasta que você escolhe. Este documento fica como está."
          }
        }
      }
    },
    "Makes a PDF with a page for each image, with its text recognized on this device, so the PDF can be searched and its text selected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt eine PDF mit einer Seite pro Bild und erkennt dessen Text auf diesem Gerät, sodass die PDF durchsucht und ihr Text ausgewählt werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un PDF con una página por imagen y reconoce su texto en este dispositivo para permitir buscar y seleccionar texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un PDF avec une page par image et en reconnaît le texte sur cet appareil, afin que le PDF puisse être recherché et son texte sélectionné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un PDF con una pagina per ogni immagine, riconoscendone il testo su questo dispositivo per rendere il PDF ricercabile e il testo selezionabile."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzy PDF ze stroną dla każdego obrazu i rozpoznaje jego tekst na tym urządzeniu, dzięki czemu PDF można przeszukiwać i zaznaczać w nim tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria um PDF com uma página para cada imagem, com seu texto reconhecido neste dispositivo, para que seja possível pesquisar no PDF e selecionar o texto."
          }
        }
      }
    },
    "Makes a new PDF from some of a PDF’s pages, such as “1-3, 5”, in the order given." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt eine neue PDF aus einigen Seiten einer PDF, etwa „1-3, 5“, in der angegebenen Reihenfolge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un PDF nuevo con algunas páginas de un PDF, como «1-3, 5», en el orden indicado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un nouveau PDF à partir de certaines pages d’un PDF, par exemple « 1-3, 5 », dans l’ordre indiqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un nuovo PDF da alcune pagine di un PDF, ad esempio “1-3, 5”, nell'ordine indicato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzy nowy PDF z wybranych stron pliku PDF, np. „1-3, 5”, w podanej kolejności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria um novo PDF a partir de algumas páginas de um PDF, como “1-3, 5”, na ordem informada."
          }
        }
      }
    },
    "Makes a smaller copy without changing what the pages show. Your document stays as it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt eine kleinere Kopie, ohne den Seiteninhalt zu ändern. Dein Dokument bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una copia más pequeña sin cambiar lo que muestran las páginas. Tu documento no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée une copie plus petite sans modifier l’affichage des pages. Votre document reste inchangé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una copia più piccola senza cambiare ciò che mostrano le pagine. Il documento resta invariato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzy mniejszą kopię bez zmiany wyglądu stron. Twój dokument pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria uma cópia menor sem alterar o que as páginas mostram. Seu documento não muda."
          }
        }
      }
    },
