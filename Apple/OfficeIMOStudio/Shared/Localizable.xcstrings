    "Puts PDFs, images and Word, Excel, PowerPoint and other documents together into one PDF, in the order given." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt PDFs, Bilder sowie Word-, Excel-, PowerPoint- und andere Dokumente in der angegebenen Reihenfolge zu einem PDF zusammen."
          }
        },
        "es" : {
          "stringUnit" : {
