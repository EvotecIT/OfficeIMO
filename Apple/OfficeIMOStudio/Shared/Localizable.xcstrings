    "%lld problem(s) were worked around while reading; %lld couldn’t be." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Lesen umgangene Probleme: %1$lld; nicht umgehbar: %2$lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld problem(s) were worked around while reading; %2$lld couldn’t be."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sortearon %1$lld problema(s) durante la lectura; %2$lld no se pudieron resolver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problèmes contournés à la lecture : %1$lld ; impossibles à contourner : %2$lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld problemi sono stati aggirati durante la lettura; non è stato possibile aggirarne %2$lld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas odczytu obejściem objęto problemy: %1$lld; nie dało się obejść: %2$lld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld problema(s) contornado(s) durante a leitura; %2$lld não puderam ser contornados."
          }
        }
      }
    },
