    "Reads the text of a PDF’s scanned pages on this device and adds it, so the PDF can be searched and its text selected. Pages that already have text keep it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennt auf diesem Gerät den Text der gescannten Seiten einer PDF und fügt ihn hinzu, sodass die PDF durchsucht und ihr Text ausgewählt werden kann. Seiten mit Text behalten ihn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee el texto de las páginas escaneadas de un PDF en este dispositivo y lo añade para permitir buscar y seleccionar texto. Las páginas que ya tienen texto lo conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit sur cet appareil le texte des pages numérisées d’un PDF et l’ajoute, afin que le PDF puisse être recherché et son texte sélectionné. Les pages qui ont déjà du texte le conservent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge su questo dispositivo il testo delle pagine scansionate di un PDF e lo aggiunge per rendere il PDF ricercabile e il testo selezionabile. Le pagine che hanno già testo lo mantengono."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytuje na tym urządzeniu tekst zeskanowanych stron pliku PDF i dodaje go, dzięki czemu PDF można przeszukiwać i zaznaczać w nim tekst. Strony, które mają już tekst, zachowują go."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê o texto das páginas digitalizadas de um PDF neste dispositivo e o adiciona para permitir pesquisar no PDF e selecionar o texto. As páginas que já têm texto o mantêm."
          }
        }
      }
    },
