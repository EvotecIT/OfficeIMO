    "Anyone with the password can print, copy and change the copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle mit dem Passwort können die Kopie drucken, kopieren und ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne disposant du mot de passe peut imprimer, copier et modifier la copie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy, kto zna hasło, może drukować, kopiować i zmieniać kopię."
          }
        }
      }
    },
    "Approved" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genehmigt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuvé"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatwierdzone"
          }
        }
      }
    },
    "Apps that respect permissions ask for the permissions password before allowing what is turned off. It must differ from the password to open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps, die Berechtigungen beachten, fragen nach dem Berechtigungspasswort, bevor sie Deaktiviertes erlauben. Es muss sich vom Passwort zum Öffnen unterscheiden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps qui respectent les autorisations demandent le mot de passe des autorisations avant de permettre ce qui est désactivé. Il doit différer du mot de passe d’ouverture."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje respektujące uprawnienia proszą o hasło uprawnień, zanim pozwolą na to, co jest wyłączone. Musi się ono różnić od hasła otwarcia."
          }
        }
      }
    },
