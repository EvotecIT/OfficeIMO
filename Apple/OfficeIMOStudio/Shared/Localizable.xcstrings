    "The content keeps its proportions and covers the new page; edges may be cut." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Inhalt behält seine Proportionen und füllt die neue Seite; Ränder können abgeschnitten werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido conserva sus proporciones y cubre la nueva página; los bordes pueden recortarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu garde ses proportions et couvre la nouvelle page ; les bords peuvent être coupés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contenuto mantiene le proporzioni e copre la nuova pagina; i bordi possono essere tagliati."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treść zachowuje proporcje i wypełnia nową stronę; krawędzie mogą zostać obcięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo mantém as proporções e cobre a nova página; as bordas podem ser cortadas."
          }
        }
      }
    },
    "The content keeps its proportions and fits inside the new page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Inhalt behält seine Proportionen und passt in die neue Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido conserva sus proporciones y se ajusta dentro de la nueva página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu garde ses proportions et tient dans la nouvelle page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contenuto mantiene le proporzioni e si adatta all'interno della nuova pagina."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treść zachowuje proporcje i mieści się na nowej stronie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo mantém as proporções e cabe dentro da nova página."
          }
        }
      }
    },
    "The content stretches to the new page’s width and height." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Inhalt wird auf die Breite und Höhe der neuen Seite gestreckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido se estira al ancho y alto de la nueva página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu s’étire à la largeur et à la hauteur de la nouvelle page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contenuto viene esteso alla larghezza e all'altezza della nuova pagina."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treść rozciąga się do szerokości i wysokości nowej strony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo é esticado para a largura e altura da nova página."
          }
        }
      }
    },
    "The content was removed from %lld page(s) and checked. Your document saves automatically; Undo brings the content back until you close it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Inhalt wurde von %lld Seite(n) entfernt und geprüft. Dein Dokument wird automatisch gesichert; mit „Widerrufen“ holst du den Inhalt zurück, bis du es schließt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido se eliminó de %lld página(s) y se comprobó. Tu documento se guarda automáticamente; Deshacer recupera el contenido hasta que lo cierres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu a été supprimé de %lld page(s) et vérifié. Votre document s’enregistre automatiquement ; Annuler rétablit le contenu jusqu’à sa fermeture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contenuto è stato rimosso da %lld pagina/e e verificato. Il documento viene salvato automaticamente; Annulla ripristina il contenuto finché non lo chiudi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treść usunięto ze stron (%lld) i sprawdzono. Dokument zapisuje się automatycznie; Cofnij przywraca treść do czasu jego zamknięcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo foi removido de %lld página(s) e verificado. Seu documento é salvo automaticamente; Desfazer restaura o conteúdo até você fechá-lo."
          }
        }
      }
    },
    "The copy opens without a password, and anyone can print, copy and change it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie öffnet sich ohne Passwort, und alle können sie drucken, kopieren und ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia se abre sin contraseña y cualquiera puede imprimirla, copiarla y cambiarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie s’ouvre sans mot de passe, et tout le monde peut l’imprimer, la copier et la modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia si apre senza password e chiunque può stamparla, copiarla e modificarla."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia otwiera się bez hasła i każdy może ją drukować, kopiować i zmieniać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia abre sem senha e qualquer pessoa pode imprimi-la, copiá-la e alterá-la."
          }
        }
      }
    },
    "The document hasn’t changed since it was signed; the certificate isn’t trusted on this device" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dokument wurde seit dem Signieren nicht geändert; das Zertifikat ist auf diesem Gerät nicht vertrauenswürdig"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El documento no ha cambiado desde que se firmó; este dispositivo no confía en el certificado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le document n’a pas changé depuis sa signature ; le certificat n’est pas approuvé sur cet appareil"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il documento non è cambiato dopo la firma; il certificato non è attendibile su questo dispositivo"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokument nie zmienił się od podpisania; certyfikat nie jest zaufany na tym urządzeniu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O documento não foi alterado desde a assinatura; o certificado não é confiável neste dispositivo"
          }
        }
      }
    },
    "The document needs at least two bookmarks on different pages, or one after the first page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dokument braucht mindestens zwei Lesezeichen auf verschiedenen Seiten oder eines nach der ersten Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El documento necesita al menos dos marcadores en páginas distintas o uno después de la primera página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le document doit avoir au moins deux signets sur des pages différentes, ou un après la première page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il documento richiede almeno due segnalibri su pagine diverse oppure uno dopo la prima pagina."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokument potrzebuje co najmniej dwóch zakładek na różnych stronach albo jednej za pierwszą stroną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O documento precisa de pelo menos dois marcadores em páginas diferentes ou um após a primeira página."
          }
        }
      }
    },
    "The first page shows %@. Every page is numbered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erste Seite zeigt %@. Jede Seite wird nummeriert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera página muestra %@. Todas las páginas se numeran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première page affiche %@. Chaque page est numérotée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prima pagina mostra %@. Ogni pagina viene numerata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na pierwszej stronie pojawi się %@. Numerowana jest każda strona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A primeira página mostra %@. Todas as páginas são numeradas."
          }
        }
      }
    },
    "The form’s current values become part of the pages, and its fields can no longer be filled or changed. Undo restores the form." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuellen Werte des Formulars werden Teil der Seiten, und seine Felder können nicht mehr ausgefüllt oder geändert werden. Widerrufen stellt das Formular wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores actuales del formulario pasan a formar parte de las páginas y sus campos ya no pueden rellenarse ni cambiarse. Deshacer restaura el formulario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs actuelles du formulaire font désormais partie des pages et ses champs ne peuvent plus être remplis ni modifiés. Annuler rétablit le formulaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I valori attuali del modulo diventano parte delle pagine e i campi non possono più essere compilati o modificati. Annulla operazione ripristina il modulo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bieżące wartości formularza staną się częścią stron, a jego pól nie będzie można już wypełniać ani zmieniać. Cofnięcie przywraca formularz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores atuais do formulário se tornam parte das páginas e seus campos não podem mais ser preenchidos nem alterados. Desfazer restaura o formulário."
          }
        }
      }
    },
    "The note goes in the middle of the page in view." : {
