    },
    "This document’s pages can’t be changed or extracted yet: it has content, such as form fields or accessibility tags, that OfficeIMO can’t rewrite safely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Seiten dieses Dokuments können noch nicht geändert oder extrahiert werden: Es enthält Inhalte wie Formularfelder oder Bedienungshilfen-Tags, die OfficeIMO nicht sicher neu schreiben kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas de este documento aún no se pueden cambiar ni extraer: contienen elementos, como campos de formulario o etiquetas de accesibilidad, que OfficeIMO no puede reescribir de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages de ce document ne peuvent pas encore être modifiées ni extraites : il contient des éléments, comme des champs de formulaire ou des balises d’accessibilité, qu’OfficeIMO ne peut pas réécrire en toute sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pagine del documento non possono ancora essere modificate o estratte: contiene elementi, come campi modulo o tag di accessibilità, che OfficeIMO non può riscrivere in sicurezza."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stron tego dokumentu nie można jeszcze zmieniać ani wyodrębniać: zawiera on treść, np. pola formularza lub znaczniki ułatwień dostępu, której OfficeIMO nie może bezpiecznie przepisać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas deste documento ainda não podem ser alteradas nem extraídas: ele tem conteúdo, como campos de formulário ou tags de acessibilidade, que o OfficeIMO não consegue regravar com segurança."
          }
        }
      }
    },
    "This document’s pages can’t be changed yet: it has content, such as form fields or accessibility tags, that OfficeIMO can’t rewrite safely. You can still extract pages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Seiten dieses Dokuments können noch nicht geändert werden: Es enthält Inhalte wie Formularfelder oder Bedienungshilfen-Tags, die OfficeIMO nicht sicher neu schreiben kann. Seiten können weiterhin extrahiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas de este documento aún no se pueden cambiar: contienen elementos, como campos de formulario o etiquetas de accesibilidad, que OfficeIMO no puede reescribir de forma segura. Aún puede extraer páginas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages de ce document ne peuvent pas encore être modifiées : il contient des éléments, comme des champs de formulaire ou des balises d’accessibilité, qu’OfficeIMO ne peut pas réécrire en toute sécurité. Vous pouvez toujours extraire des pages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pagine del documento non possono ancora essere modificate: contiene elementi, come campi modulo o tag di accessibilità, che OfficeIMO non può riscrivere in sicurezza. Puoi comunque estrarre pagine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stron tego dokumentu nie można jeszcze zmieniać: zawiera on treść, np. pola formularza lub znaczniki ułatwień dostępu, której OfficeIMO nie może bezpiecznie przepisać. Nadal możesz wyodrębniać strony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas deste documento ainda não podem ser alteradas: ele tem conteúdo, como campos de formulário ou tags de acessibilidade, que o OfficeIMO não consegue regravar com segurança. Você ainda pode extrair páginas."
          }
        }
      }
    },
    "This document does not allow copying its content." : {
