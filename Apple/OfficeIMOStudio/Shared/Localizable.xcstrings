    "A .p12 or .pfx file with your certificate and its private key, such as one exported from Keychain Access or issued by your organization." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine .p12- oder .pfx-Datei mit deinem Zertifikat und seinem privaten Schlüssel, etwa aus der Schlüsselbundverwaltung exportiert oder von deiner Organisation ausgestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo .p12 o .pfx con su certificado y clave privada, como uno exportado desde Acceso a Llaveros o emitido por su organización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier .p12 ou .pfx contenant votre certificat et sa clé privée, par exemple exporté depuis Trousseau d’accès ou fourni par votre organisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file .p12 o .pfx con il certificato e la sua chiave privata, ad esempio esportato da Accesso Portachiavi o rilasciato dalla tua organizzazione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik .p12 lub .pfx z certyfikatem i jego kluczem prywatnym, np. wyeksportowany z Pęku kluczy lub wydany przez Twoją organizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo .p12 ou .pfx com seu certificado e sua chave privada, como um exportado do Acesso às Chaves ou emitido por sua organização."
          }
        }
      }
    },
    "A recovery copy contains changes from the last session. Restore them or discard the copy to keep the saved document." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Wiederherstellungskopie enthält Änderungen aus der letzten Sitzung. Stelle die Änderungen wieder her oder verwirf die Kopie, um das gesicherte Dokument beizubehalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia de recuperación contiene cambios de la última sesión. Restáurelos o descarte la copia para conservar el documento guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une copie de récupération contient des modifications de la dernière session. Restaurez-les ou supprimez la copie pour conserver le document enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia di recupero contiene modifiche dell'ultima sessione. Ripristina le modifiche oppure elimina la copia per mantenere il documento salvato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia odzyskiwania zawiera zmiany z ostatniej sesji. Przywróć je lub odrzuć kopię, aby pozostawić zapisany dokument bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma cópia de recuperação contém alterações da última sessão. Restaure as alterações ou descarte a cópia para manter o documento salvo sem alterações."
          }
        }
      }
    },
