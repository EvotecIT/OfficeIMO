    "Some content couldn’t be kept exactly as it is in the PDF. Save the file, or cancel to keep the document only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Inhalte konnten nicht genau wie im PDF übernommen werden. Sichere die Datei oder brich ab, um nur das Dokument zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte del contenido no se pudo conservar exactamente como en el PDF. Guarde el archivo o cancele para conservar solo el documento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains contenus n’ont pas pu être conservés exactement comme dans le PDF. Enregistrez le fichier ou annulez pour ne garder que le document."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni contenuti non possono essere conservati esattamente come nel PDF. Salva il file oppure annulla per conservare solo il documento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Części treści nie udało się zachować dokładnie tak jak w PDF. Zapisz plik albo anuluj, aby zachować tylko dokument."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível manter parte do conteúdo exatamente como está no PDF. Salve o arquivo ou cancele para manter somente o documento."
          }
        }
      }
    },
    "Some of the marked content is still in the document or couldn’t be checked. Undo the redaction and mark a larger area." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Teil des markierten Inhalts ist noch im Dokument oder konnte nicht geprüft werden. Widerrufe die Schwärzung und markiere einen größeren Bereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte del contenido marcado sigue en el documento o no se pudo comprobar. Deshaga la censura y marque un área mayor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une partie du contenu marqué reste dans le document ou n’a pas pu être vérifiée. Annulez le caviardage et marquez une zone plus grande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni contenuti contrassegnati sono ancora nel documento o non è stato possibile verificarli. Annulla l'oscuramento e contrassegna un'area più grande."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Część zaznaczonej treści nadal jest w dokumencie albo nie dało się jej sprawdzić. Cofnij utajnienie i zaznacz większy obszar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte do conteúdo marcado ainda está no documento ou não pôde ser verificada. Desfaça a ocultação e marque uma área maior."
          }
        }
      }
    },
