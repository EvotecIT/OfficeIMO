    "{page} and {pages} become the page number and count, {date} today’s date, {file} the file name and {title} the document’s title." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{page} und {pages} werden zur Seitennummer und Seitenzahl, {date} zum heutigen Datum, {file} zum Dateinamen und {title} zum Titel des Dokuments."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{page} y {pages} se sustituyen por el número de página y el total de páginas, {date} por la fecha de hoy, {file} por el nombre del archivo y {title} por el título del documento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{page} et {pages} deviennent le numéro et le nombre de pages, {date} la date du jour, {file} le nom du fichier et {title} le titre du document."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{page} e {pages} diventano numero e totale delle pagine, {date} la data di oggi, {file} il nome del file e {title} il titolo del documento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{page} i {pages} zastępowane są numerem i liczbą stron, {date} dzisiejszą datą, {file} nazwą pliku, a {title} tytułem dokumentu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{page} e {pages} se tornam o número e a quantidade de páginas, {date} a data de hoje, {file} o nome do arquivo e {title} o título do documento."
          }
        }
      }
    },
