    "A .p12 or .pfx file with your certificate and its private key, such as one exported from Keychain Access or issued by your organization." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine .p12- oder .pfx-Datei mit deinem Zertifikat und seinem privaten Schlüssel, etwa aus der Schlüsselbundverwaltung exportiert oder von deiner Organisation ausgestellt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier .p12 ou .pfx contenant votre certificat et sa clé privée, par exemple exporté depuis Trousseau d’accès ou fourni par votre organisation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik .p12 lub .pfx z certyfikatem i jego kluczem prywatnym, np. wyeksportowany z Pęku kluczy lub wydany przez Twoją organizację."
          }
        }
      }
    },
