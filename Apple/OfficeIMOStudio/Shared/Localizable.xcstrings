    "{page} and {pages} become the page number and count, {date} today’s date, {file} the file name and {title} the document’s title." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{page} und {pages} werden zur Seitennummer und Seitenzahl, {date} zum heutigen Datum, {file} zum Dateinamen und {title} zum Titel des Dokuments."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{page} et {pages} deviennent le numéro et le nombre de pages, {date} la date du jour, {file} le nom du fichier et {title} le titre du document."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{page} i {pages} zastępowane są numerem i liczbą stron, {date} dzisiejszą datą, {file} nazwą pliku, a {title} tytułem dokumentu."
          }
        }
      }
    },
