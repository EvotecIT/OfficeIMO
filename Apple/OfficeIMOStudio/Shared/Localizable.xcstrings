    },
    "This document is protected. Enter its password to open it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Dokument ist geschützt. Gib das Passwort ein, um es zu öffnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce document est protégé. Saisissez son mot de passe pour l’ouvrir."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten dokument jest chroniony. Wprowadź hasło, aby go otworzyć."
          }
        }
      }
    },
    "This document’s pages can’t be changed or extracted yet: it has content, such as form fields or accessibility tags, that OfficeIMO can’t rewrite safely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Seiten dieses Dokuments können noch nicht geändert oder extrahiert werden: Es enthält Inhalte wie Formularfelder oder Bedienungshilfen-Tags, die OfficeIMO nicht sicher neu schreiben kann."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages de ce document ne peuvent pas encore être modifiées ni extraites : il contient des éléments, comme des champs de formulaire ou des balises d’accessibilité, qu’OfficeIMO ne peut pas réécrire en toute sécurité."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stron tego dokumentu nie można jeszcze zmieniać ani wyodrębniać: zawiera on treść, np. pola formularza lub znaczniki ułatwień dostępu, której OfficeIMO nie może bezpiecznie przepisać."
          }
        }
      }
    },
    "This document’s pages can’t be changed yet: it has content, such as form fields or accessibility tags, that OfficeIMO can’t rewrite safely. You can still extract pages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Seiten dieses Dokuments können noch nicht geändert werden: Es enthält Inhalte wie Formularfelder oder Bedienungshilfen-Tags, die OfficeIMO nicht sicher neu schreiben kann. Seiten können weiterhin extrahiert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages de ce document ne peuvent pas encore être modifiées : il contient des éléments, comme des champs de formulaire ou des balises d’accessibilité, qu’OfficeIMO ne peut pas réécrire en toute sécurité. Vous pouvez toujours extraire des pages."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stron tego dokumentu nie można jeszcze zmieniać: zawiera on treść, np. pola formularza lub znaczniki ułatwień dostępu, której OfficeIMO nie może bezpiecznie przepisać. Nadal możesz wyodrębniać strony."
          }
        }
      }
    },
    "This document’s permissions don’t allow changing its security without its permissions password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Berechtigungen dieses Dokuments erlauben ohne Berechtigungspasswort keine Änderung seiner Sicherheit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autorisations de ce document ne permettent pas de modifier sa sécurité sans son mot de passe des autorisations."
