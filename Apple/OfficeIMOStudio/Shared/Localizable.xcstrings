    "Each match removes its whole block of text, including the words around it. Check each one before redacting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Treffer entfernt seinen ganzen Textblock, auch die Wörter darum herum. Prüfe jeden Treffer vor dem Schwärzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada coincidencia elimina todo su bloque de texto, incluidas las palabras de alrededor. Revisa cada una antes de censurar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque résultat supprime tout son bloc de texte, y compris les mots voisins. Vérifiez chacun avant de caviarder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni corrispondenza rimuove l’intero blocco di testo, comprese le parole vicine. Controlla ciascuna prima di oscurare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde dopasowanie usuwa cały blok tekstu, także otaczające słowa. Sprawdź każde przed utajnieniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada correspondência remove todo o bloco de texto, incluindo as palavras ao redor. Verifique cada uma antes de ocultar."
          }
        }
      }
    },
