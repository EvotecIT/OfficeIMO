    "Everything happens on your device. Nothing is uploaded and no account is needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles geschieht auf deinem Gerät. Nichts wird hochgeladen, und du brauchst kein Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo ocurre en tu dispositivo. No se sube nada y no necesitas cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout se passe sur votre appareil. Rien n’est envoyé et aucun compte n’est nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto avviene sul dispositivo. Non viene caricato nulla e non serve un account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko dzieje się na urządzeniu. Nic nie jest wysyłane i nie potrzebujesz konta."
          }
        },
        "pt-BR" : {
