    "Anyone with the password can print, copy and change the copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle mit dem Passwort können die Kopie drucken, kopieren und ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera con la contraseña puede imprimir, copiar y cambiar la copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne disposant du mot de passe peut imprimer, copier et modifier la copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque abbia la password può stampare, copiare e modificare la copia."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy, kto zna hasło, może drukować, kopiować i zmieniać kopię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa com a senha pode imprimir, copiar e alterar a cópia."
          }
        }
      }
    },
