    "Apps that respect permissions ask for the permissions password before allowing what is turned off. It must differ from the password to open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps, die Berechtigungen beachten, fragen nach dem Berechtigungspasswort, bevor sie Deaktiviertes erlauben. Es muss sich vom Passwort zum Öffnen unterscheiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las aplicaciones que respetan los permisos solicitan la contraseña de permisos antes de permitir lo desactivado. Debe ser distinta de la contraseña de apertura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps qui respectent les autorisations demandent le mot de passe des autorisations avant de permettre ce qui est désactivé. Il doit différer du mot de passe d’ouverture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app che rispettano le autorizzazioni richiedono la password delle autorizzazioni prima di consentire ciò che è disattivato. Deve essere diversa dalla password di apertura."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje respektujące uprawnienia proszą o hasło uprawnień, zanim pozwolą na to, co jest wyłączone. Musi się ono różnić od hasła otwarcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicativos que respeitam permissões solicitam a senha de permissões antes de permitir o que está desativado. Ela precisa ser diferente da senha de abertura."
          }
        }
      }
    },
