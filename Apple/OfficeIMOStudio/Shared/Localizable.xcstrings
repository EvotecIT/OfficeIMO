    "PDFs with form fields can’t be combined yet. Open the PDF, choose Tools > Protect > Flatten, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFs mit Formularfeldern können noch nicht kombiniert werden. Öffne die PDF, wähle „Werkzeuge > Schützen > Reduzieren“ und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los PDF con campos de formulario aún no se pueden combinar. Abre el PDF, elige Herramientas > Proteger > Acoplar y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les PDF avec champs de formulaire ne peuvent pas encore être combinés. Ouvrez le PDF, choisissez Outils > Protéger > Aplatir, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I PDF con campi modulo non possono ancora essere combinati. Apri il PDF, scegli Strumenti > Proteggi > Appiattisci e riprova."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plików PDF z polami formularzy nie można jeszcze łączyć. Otwórz PDF, wybierz Narzędzia > Chroń > Spłaszcz i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
