    "Drawings, shapes, highlights, notes and stamps become part of the pages and can no longer be moved or changed. Links stay. Undo restores the markup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnungen, Formen, Markierungen, Notizen und Stempel werden Teil der Seiten und lassen sich nicht mehr bewegen oder ändern. Links bleiben erhalten. „Widerrufen“ stellt die Markierungen wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dibujos, formas, resaltados, notas y sellos pasan a formar parte de las páginas y ya no pueden moverse ni cambiarse. Los enlaces se conservan. Deshacer restaura las marcas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dessins, formes, surlignages, notes et tampons font désormais partie des pages et ne peuvent plus être déplacés ni modifiés. Les liens sont conservés. Annuler rétablit les annotations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegni, forme, evidenziazioni, note e timbri diventano parte delle pagine e non possono più essere spostati o modificati. I link rimangono. Annulla operazione ripristina le annotazioni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysunki, kształty, wyróżnienia, notatki i pieczątki stają się częścią stron i nie można ich już przesuwać ani zmieniać. Łącza pozostają. Cofnij przywraca oznaczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhos, formas, realces, notas e carimbos se tornam parte das páginas e não podem mais ser movidos nem alterados. Os links ficam. Desfazer restaura as marcações."
          }
        }
      }
    },
